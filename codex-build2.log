--- /dev/null
+++ b/src/pages/knowledge/oem-battery-moq-lead-time/index.astro
@@ -0,0 +1,34 @@
+---
+import ArticleLayout from '../../../layouts/ArticleLayout.astro';
+import CTASection from '../../../components/CTASection.astro';
+import { MANUFACTURER, TRADE_TERMS, RELATIONSHIP } from '../../../data/site';
+
+const title = 'OEM Battery MOQ & Lead Time Explained | Dingwei Battery';
+const description = 'What MOQ and lead time mean for OEM battery orders, and how they are set — with Chengguang Energy’s reference terms.';
+const articleTitle = 'OEM battery MOQ & lead time';
+---
+<ArticleLayout title={title} description={description} articleTitle={articleTitle}>
+  <section class="section container prose">
+    <span class="tag">Knowledge</span>
+    <h1>OEM battery MOQ &amp; lead time</h1>
+    <p class="lead">MOQ and lead time are set by production economics and container logistics, not by negotiation alone. Here is how they work.</p>
+
+    <h2>What drives MOQ</h2>
+    <p>Battery MOQ is usually tied to a container load, because shipping cost per unit collapses at FCL. {MANUFACTURER.name}&rsquo;s reference MOQ is {TRADE_TERMS.moq}.</p>
+
+    <h2>What drives lead time</h2>
+    <p>Lead time covers order confirmation, production and pre-shipment testing. {MANUFACTURER.name}&rsquo;s reference lead time is {TRADE_TERMS.leadTime}; custom-label orders add sampling time.</p>
+
+    <h2>How to reduce both</h2>
+    <ul>
+      <li>Order in full container multiples</li>
+      <li>Consolidate mixed models into one container</li>
+      <li>Confirm specification early to avoid sampling delays</li>
+      <li>Plan around the harvest-free, year-round production of lead-acid batteries</li>
+    </ul>
+    <p><a href="/contact/">Confirm MOQ and lead time &rarr;</a> · <a href="/knowledge/how-oem-battery-programs-work/">How OEM programs run &rarr;</a></p>
+    <p>{RELATIONSHIP}</p>
+  </section>
+
+  <CTASection title="Confirm MOQ and lead time for your order" />
+</ArticleLayout>
diff --git a/src/pages/knowledge/oem-battery-rfq-guide/index.astro b/src/pages/knowledge/oem-battery-rfq-guide/index.astro
new file mode 100644
index 0000000000000000000000000000000000000000..f49c739876823b1fbb0bc91841e4294f3e2610b6
--- /dev/null
+++ b/src/pages/knowledge/oem-battery-rfq-guide/index.astro
@@ -0,0 +1,53 @@
+---
+import ArticleLayout from '../../../layouts/ArticleLayout.astro';
+import CTASection from '../../../components/CTASection.astro';
+import { STANDARDS, RELATIONSHIP } from '../../../data/site';
+
+const title = 'OEM Battery RFQ Guide: Write an Effective Request for Quotation | Dingwei Battery';
+const description = 'How to write an OEM battery RFQ that gets accurate quotes: specification fields, volume, packaging, certification and delivery requirements.';
+const articleTitle = 'OEM battery RFQ guide';
+---
+<ArticleLayout title={title} description={description} articleTitle={articleTitle}>
+  <section class="section container prose">
+    <span class="tag">Knowledge</span>
+    <h1>OEM battery RFQ guide</h1>
+    <p class="lead">A complete RFQ gets you comparable quotes; a vague one gets you a range so wide it is useless. Include these fields.</p>
+
+    <h2>The specification block</h2>
+    <ul>
+      <li>Battery type (SLI, AGM, EFB, heavy-duty)</li>
+      <li>Standard family ({STANDARDS.join(', ')})</li>
+      <li>Reference model (e.g. 65D26)</li>
+      <li>Voltage, capacity (Ah), CCA</li>
+      <li>Case size, terminal type, polarity</li>
+    </ul>
+
+    <h2>The volume block</h2>
+    <ul>
+      <li>Annual volume</li>
+      <li>First order quantity</li>
+      <li>Forecast by model if mixed</li>
+      <li>Target market (affects standard and certification)</li>
+    </ul>
+
+    <h2>The branding block</h2>
+    <ul>
+      <li>Private label or OEM</li>
+      <li>Label artwork and packaging</li>
+      <li>Pallet configuration</li>
+      <li>Multi-language documentation</li>
+    </ul>
+
+    <h2>The commercial block</h2>
+    <ul>
+      <li>Target price (optional)</li>
+      <li>Incoterms</li>
+      <li>Payment terms</li>
+      <li>Delivery schedule</li>
+    </ul>
+    <p><a href="/contact/">Send your RFQ &rarr;</a> · <a href="/knowledge/oem-battery-specification-guide/">Build a clean specification &rarr;</a></p>
+    <p>{RELATIONSHIP}</p>
+  </section>
+
+  <CTASection title="Send a complete OEM RFQ" />
+</ArticleLayout>
