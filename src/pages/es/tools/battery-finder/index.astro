---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE } from '../../../../data/site';
import { batteryModels, modelPath } from '../../../../data/battery-models';

const title = 'Buscador de Baterías: Encuentre su Modelo de Batería | Dingwei Battery';
const description = 'Filtre 23 modelos de baterías de referencia por aplicación, familia de estándares y capacidad. Encuentre referencias de baterías de arranque JIS, DIN/EN y de servicio pesado de Dingwei Battery.';

const breadcrumbs = [{ label: 'Buscador de Baterías', href: '/es/tools/battery-finder/' }];

const HEAVY = ['105D31', '115D31', 'N100', 'N150', 'N200'];

const finderData = batteryModels.map((m) => ({
  model: m.model,
  standard: m.standard,
  capacity: m.capacity_ah,
  voltage: m.voltage,
  cca: m.cca.value,
  dims: `${m.dimensions_mm.length} × ${m.dimensions_mm.width} × ${m.dimensions_mm.height}`,
  caseSize: m.case_size,
  app: HEAVY.includes(m.model) ? 'Servicio pesado' : 'Turismo',
  href: '/es' + modelPath(m.model),
}));

const finderJson = JSON.stringify(finderData);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/es/` },
      { '@type': 'ListItem', position: 2, name: 'Buscador de Baterías', item: `${SITE.url}/es/tools/battery-finder/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Herramienta</span>
    <h1>Buscador de baterías</h1>
    <p class="lead">Filtre el conjunto actual de modelos de referencia por aplicación, familia de estándares y capacidad. Las especificaciones son de referencia; confirme los valores finales con el fabricante.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="finder-filters">
        <div class="field">
          <label for="f-app">Aplicación</label>
          <select id="f-app">
            <option value="all">Todas</option>
            <option value="Turismo">Turismo</option>
            <option value="Servicio pesado">Servicio pesado</option>
          </select>
        </div>
        <div class="field">
          <label for="f-std">Familia de estándares</label>
          <select id="f-std">
            <option value="all">Todas</option>
            <option value="JIS">JIS</option>
            <option value="DIN/EN">DIN/EN</option>
          </select>
        </div>
        <div class="field">
          <label for="f-cap">Capacidad (Ah)</label>
          <select id="f-cap">
            <option value="all">Todas</option>
            <option value="low">&le; 60</option>
            <option value="mid">61&ndash;80</option>
            <option value="high">81&ndash;100</option>
            <option value="xhigh">&gt; 100</option>
          </select>
        </div>
        <div class="finder-actions">
          <button class="btn" type="button" id="finder-search">Buscar</button>
          <button class="btn btn--ghost" type="button" id="finder-reset">Restablecer</button>
        </div>
      </div>
      <p class="finder-count" id="finder-count" aria-live="polite"></p>
      <div class="finder-results" id="finder-results"></div>
    </div>
  </section>

  <section class="section container prose">
    <h2>¿Necesita una compatibilidad exacta?</h2>
    <p>Dingwei Battery ofrece programas de baterías OEM y de marca privada fabricadas por Chengguang Power Tech Co., Ltd. (fundada en 2002). Comparta el vehículo, el estándar y la referencia de carcasa en el formulario de RFQ, y el equipo de exportación del fabricante confirmará la compatibilidad.</p>
    <p><a href="/es/contact/">Solicite la confirmación de compatibilidad &rarr;</a> · <a href="/es/knowledge/oem-battery-specification-guide/">Lea la guía de especificación &rarr;</a></p>
  </section>

  <CTASection title="Solicite una comprobación de compatibilidad OEM" />

  <script type="application/json" id="finder-data" set:html={finderJson}></script>
  <script is:inline>
    const MODELS = JSON.parse(document.getElementById('finder-data').textContent);
    const resultsEl = document.getElementById('finder-results');
    const countEl = document.getElementById('finder-count');

    function matchCapacity(cap, filter) {
      if (filter === 'all') return true;
      if (filter === 'low') return cap <= 60;
      if (filter === 'mid') return cap >= 61 && cap <= 80;
      if (filter === 'high') return cap >= 81 && cap <= 100;
      if (filter === 'xhigh') return cap > 100;
      return true;
    }

    function render() {
      const app = document.getElementById('f-app').value;
      const std = document.getElementById('f-std').value;
      const cap = document.getElementById('f-cap').value;

      const filtered = MODELS.filter((m) => {
        if (app !== 'all' && m.app !== app) return false;
        if (std !== 'all' && m.standard !== std) return false;
        return matchCapacity(m.capacity, cap);
      });

      countEl.textContent = 'Coincidencias: ' + filtered.length;

      if (filtered.length === 0) {
        resultsEl.innerHTML = '<p class="note">Ningún modelo de referencia coincide con esos filtros. <a href="/es/contact/">Solicite un montaje personalizado</a>.</p>';
        return;
      }

      resultsEl.innerHTML = filtered.map((m) => `
        <article class="finder-card">
          <h3><a href="${m.href}">${m.model} Batería</a></h3>
          <p class="model-card__meta">${m.app} · ${m.standard} · ${m.voltage}V · ${m.capacity} Ah</p>
          <p class="model-card__meta">${m.cca} CCA (referencia) · ${m.dims} mm</p>
          <a href="${m.href}">Ver especificación <span aria-hidden="true">&rarr;</span></a>
        </article>
      `).join('');
    }

    document.getElementById('f-app').addEventListener('change', render);
    document.getElementById('f-std').addEventListener('change', render);
    document.getElementById('f-cap').addEventListener('change', render);

    document.getElementById('finder-search').addEventListener('click', () => {
      render();
      document.getElementById('finder-results').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    document.getElementById('finder-reset').addEventListener('click', () => {
      document.getElementById('f-app').value = 'all';
      document.getElementById('f-std').value = 'all';
      document.getElementById('f-cap').value = 'all';
      render();
    });

    render();
  </script>
</BaseLayout>
