const articleTitle = 'Baterías para camiones del mercado de los EAU';

const faqs = [
  { q: '¿Qué estándar de batería usan los EAU para camiones?', a: 'Los EAU operan una flota premium de inclinación europea (Mercedes-Benz, Volvo, Scania, MAN, DAF, Iveco) junto a un segmento japonés y asiático (Hino, Isuzu, Tata, Ashok Leyland), por lo que las baterías JIS N150/N200/N100 y DIN/EN son ambas comunes. Haga coincidir la batería con el grupo y el voltaje del vehículo.' },
