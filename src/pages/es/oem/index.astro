---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatsBar from '../../../components/StatsBar.astro';
import BatteryTypeCard from '../../../components/BatteryTypeCard.astro';
import OEMProcess from '../../../components/OEMProcess.astro';
import CTASection from '../../../components/CTASection.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER, BATTERY_TYPES, TRADE_TERMS, CERTIFICATIONS } from '../../../data/site';

const title = 'Fabricación de Baterías OEM | Dingwei Battery';
const description = 'Programas de baterías OEM de Dingwei Battery, fabricadas por Chengguang Power Tech Co., Ltd.: baterías SLI, AGM, EFB y de servicio pesado según los estándares JIS, DIN, BCI, AS y SA.';

const breadcrumbs = [{ label: 'OEM', href: '/es/oem/' }];

const oemFaqs = [
  {
    q: '¿Qué baterías suministra Dingwei?',
    a: 'Dingwei suministra baterías de arranque de plomo-ácido SLI, AGM, EFB y de servicio pesado para programas OEM y de marca privada, con especificaciones según los estándares JIS, DIN, BCI, AS y SA.',
  },
  {
    q: '¿Quién fabrica las baterías Dingwei?',
    a: 'Las baterías Dingwei son fabricadas por Chengguang Power Tech Co., Ltd., un fabricante de plomo-ácido fundado en 2002 en Jinzhou, Hebei, China, con certificación IATF 16949.',
  },
  {
    q: '¿Cómo mantiene Dingwei la consistencia de los pedidos repetidos?',
    a: 'Mediante un bloqueo de especificación: el comprador aprueba una muestra y ese estándar aprobado se convierte en el punto de referencia de cada contenedor posterior. Un proceso por fases con muestreo de preproducción, control en proceso y trazabilidad por lotes evita la deriva de especificación que hace que los pedidos repetidos lleguen diferentes.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: BRAND,
    url: `${SITE.url}/es/oem/`,
    description,
    manufacturer: { '@type': 'Organization', name: MANUFACTURER.name, legalName: MANUFACTURER.legalName, foundingDate: String(MANUFACTURER.founded) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: oemFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/es/` },
      { '@type': 'ListItem', position: 2, name: 'OEM', item: `${SITE.url}/es/oem/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Resumen de OEM</span>
    <h1>Fabricación de baterías OEM</h1>
    <p class="lead">Dingwei Battery ofrece programas de baterías OEM y de marca privada fabricadas por Chengguang Power Tech Co., Ltd. (fundada en 2002). OEM significa que su producto se diseña, se marca y se suministra según una especificación acordada — no se elige de un catálogo genérico.</p>
  </section>

  <StatsBar />

  <section class="section container">
    <h2>OEM vs ODM vs marca privada</h2>
    <p class="lead">OEM fabrica según su especificación; ODM parte de un diseño existente que usted puede marcar; la marca privada aplica su identidad a un producto suministrado. El camino correcto depende de cuánto control de la especificación tenga ya.</p>
    <p><a href="/es/knowledge/oem-vs-odm-vs-private-label/">Leer la guía comparativa &rarr;</a></p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Qué significa &ldquo;OEM&rdquo; para un comprador de baterías</h2>
      <p class="lead">OEM significa que usted define la especificación y es dueño del diseño y la marca; la fábrica fabrica conforme a ello. Esa es la diferencia con ODM (la fábrica es dueña del diseño) y la marca privada (usted marca un producto de catálogo).</p>
    </div>
  </section>

  <section class="section container">
    <h2>Qué se puede personalizar</h2>
    <div class="grid grid--2">
      <div class="card"><h3>Etiqueta y arte</h3><p>Su marca, colores y denominación del producto en la etiqueta y la carcasa.</p></div>
      <div class="card"><h3>Embalaje</h3><p>Arte de caja, funda y palé según su especificación.</p></div>
      <div class="card"><h3>Terminal y especificación</h3><p>Tipo y posición del terminal, voltaje y capacidad para su mercado.</p></div>
      <div class="card"><h3>Documentación</h3><p>Manuales multilingües y tarjetas de garantía.</p></div>
    </div>
    <p><a href="/es/private-label/">Ver opciones de marca privada &rarr;</a></p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">Capacidad</span>
      <h2>Familias de producto</h2>
      <div class="grid grid--4">
        {BATTERY_TYPES.map((type) => <BatteryTypeCard type={type} />)}
      </div>
      <img class="mfg-photo" src="/images/factory/factory-20.webp" alt="Línea de producción de baterías en las instalaciones de Chengguang Power Tech Co., Ltd." width="1517" height="631" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="section container">
    <h2>Condiciones comerciales</h2>
    <p class="lead">Condiciones de exportación de referencia utilizadas por {MANUFACTURER.name}. Las condiciones finales se confirman al solicitar.</p>
    <div class="grid grid--2">
      <div class="card"><h3>MOQ</h3><p>{TRADE_TERMS.moq}</p></div>
      <div class="card"><h3>Plazo de entrega</h3><p>{TRADE_TERMS.leadTime}</p></div>
      <div class="card"><h3>Pago</h3><p>{TRADE_TERMS.payment}</p></div>
      <div class="card"><h3>Incoterms</h3><p>{TRADE_TERMS.incoterms}</p></div>
    </div>
    <p class="note">Los precios no se publican. Solicite una cotización para su especificación y volumen anual.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">Certificaciones</span>
      <h2>Sistemas de calidad del fabricante</h2>
      <p class="lead">Las siguientes certificaciones pertenecen a {MANUFACTURER.name}.</p>
      <ul>
        {CERTIFICATIONS.map((cert) => <li>{cert}</li>)}
      </ul>
    </div>
  </section>

  <section class="section container">
    <OEMProcess />
    <p><a href="/es/knowledge/how-choose-oem-battery-manufacturer/">Cómo elegir un fabricante de baterías OEM &rarr;</a></p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Cómo evaluar a un fabricante de baterías OEM</h2>
      <p class="lead">Cinco dimensiones distinguen a un socio OEM fiable de un proveedor que solo puede fabricar una muestra aceptable.</p>
      <ol>
        <li><strong>Cobertura de especificación</strong> — ¿pueden producir su estándar (JIS / DIN / BCI / AS / SA)?</li>
        <li><strong>Certificación</strong> — ¿está IATF 16949 en vigor para el suministro automotriz, respaldada por ISO 9001?</li>
        <li><strong>Escala</strong> — ¿la superficie de fábrica y la producción diaria se corresponden con su volumen anual?</li>
        <li><strong>Repetibilidad</strong> — ¿cómo mantienen los pedidos repetidos idénticos a la muestra aprobada?</li>
        <li><strong>Experiencia de exportación</strong> — ¿a qué mercados sirven y qué documentación proporcionan?</li>
      </ol>
      <p>Utilice esta vista de evaluación junto con el <a href="/es/knowledge/how-choose-oem-battery-manufacturer/">marco de decisión de cinco puntos</a> antes de solicitar muestras.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Errores comunes de aprovisionamiento OEM</h2>
    <ul>
      <li>Comparar CCA entre estándares sin comprobar el método de ensayo.</li>
      <li>Fijar la etiqueta antes de fijar la especificación.</li>
      <li>Elegir el precio más bajo e ignorar la repetibilidad.</li>
    </ul>
    <p>Comience con la <a href="/es/knowledge/oem-battery-specification-guide/">guía de especificación de baterías OEM</a> para que la primera muestra aprobada se convierta en el estándar de cada pedido posterior.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Preguntas frecuentes</h2>
      {oemFaqs.map((f) => (
        <div class="card" style="margin-bottom:0.9rem">
          <h3>{f.q}</h3>
          <p style="margin:0">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <CTASection title="Inicie su proyecto de baterías OEM" />
</BaseLayout>
