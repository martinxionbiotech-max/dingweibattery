const faqs = [
  { q: '¿Qué región produce más baterías de plomo-ácido en China?', a: 'La zona de Changxing en Zhejiang (Huzhou) es el corazón tradicional del plomo-ácido — hogar de 2 de los mayores productores domésticos — mientras Hebei, Shandong, Jiangsu y Anhui operan grandes clústeres que se inclinan hacia el trabajo OEM de exportación.' },
