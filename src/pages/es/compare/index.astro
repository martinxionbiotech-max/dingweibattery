---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE } from '../../../data/site';

const title = 'Comparación de Modelos de Batería | Dingwei Battery';
const description = 'Comparaciones escritas y orientadas al comprador de modelos de batería que comparten un tamaño de caja o una familia de estándar: capacidad, CCA, compatibilidad y cuál elegir.';

const breadcrumbs = [{ label: 'Comparar', href: '/es/compare/' }];

const comparisons = [
  {
    title: '65D26 vs 80D26',
    summary: 'Misma caja JIS D26, distinta potencia: 60 Ah / 370 CCA vs 72 Ah / 490 CCA (referencia). Descubra por qué comparten bandeja y qué grado conviene almacenar.',
    href: '/es/compare/65d26-vs-80d26/',
  },
  {
    title: '105D31 vs 115D31',
    summary: 'Misma caja JIS D31, dos grados de potencia: 84 Ah / 655 CCA vs 96 Ah / 710 CCA (referencia). Descubra por qué comparten bandeja y qué grado almacenar.',
    href: '/es/compare/105d31-vs-115d31/',
  },
  {
    title: 'H6 vs H7',
    summary: 'Serie H DIN/EN: H6 (LN3, 72 Ah) vs H7 (LN4, 84 Ah) difieren solo en longitud. Descubra si caben en la misma bandeja.',
    href: '/es/compare/h6-vs-h7/',
  },
  {
    title: 'H5 vs H6',
    summary: 'Serie H DIN/EN: H5 (LN2, 60 Ah) vs H6 (LN3, 72 Ah). Misma altura, distinta longitud y reserva.',
    href: '/es/compare/h5-vs-h6/',
  },
  {
    title: '55B24 vs 65B24',
    summary: 'Misma caja JIS B24, diferencia marginal: 48 Ah vs 50 Ah, ambas 370 CCA. Por qué la brecha es menor de lo que sugiere el código.',
    href: '/es/compare/55b24-vs-65b24/',
  },
  {
    title: 'AGM vs EFB',
    summary: 'AGM (malla de vidrio absorbente) vs EFB (inundada mejorada) para vehículos start-stop: construcción, vida de ciclado y cuál elegir.',
    href: '/es/compare/agm-vs-efb/',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Comparar', item: `${SITE.url}/es/compare/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Comparar</span>
    <h1>Comparación de modelos de batería</h1>
    <p class="lead">Comparaciones escritas que explican lo que la tabla de especificaciones por sí sola no puede: si dos baterías comparten caja, por qué difieren sus cifras y cuál debería elegir un comprador.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="model-list">
        {comparisons.map((c) => (
          <article class="model-card">
            <h2><a href={c.href}>{c.title}</a></h2>
            <p class="model-card__meta">{c.summary}</p>
            <a href={c.href}>Leer la comparación <span aria-hidden="true">&rarr;</span></a>
          </article>
        ))}
      </div>
      <p class="note">¿Prefiere una tabla comparativa lado a lado? Use la <a href="/es/tools/compare/">herramienta interactiva de comparación</a> para contrastar dos modelos cualesquiera de la base de datos de referencia.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Por qué importan las comparaciones</h2>
    <p>Un código de modelo rara vez cuenta toda la historia. Dos baterías JIS pueden compartir un tamaño de caja pero pertenecer a clases de rendimiento distintas, y dos referencias DIN/EN pueden parecer similares usando disposiciones de terminales diferentes. Estas comparaciones repasan la diferencia y qué verificar antes de pedir.</p>
    <p><a href="/es/data/">Explore la base de datos completa de modelos &rarr;</a> · <a href="/es/knowledge/jis-vs-din-vs-bci/">Lea la guía de estándares &rarr;</a></p>
  </section>

  <CTASection title="Confirme el modelo correcto para su mercado" />
</BaseLayout>
