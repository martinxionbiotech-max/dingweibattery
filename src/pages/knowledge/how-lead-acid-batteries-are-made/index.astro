const articleTitle = 'How lead-acid batteries are made';

const faqs = [
  { q: 'How is a lead-acid battery made?', a: 'Through ten stages: grid casting, paste mixing, pasting, curing, assembly, welding, electrolyte filling, formation charging, sealing and testing.' },
