const title = '6V vs 12V Battery: Series, Parallel & System Voltage | Dingwei Battery';
const description = '6V vs 12V batteries: how series and parallel wiring change voltage and capacity, why heavy vehicles use 24V, and the risk of wiring a battery to the wrong system voltage.';
const articleTitle = '6V vs 12V batteries: system voltage explained';

const faqs = [
  { q: 'Do two 6V batteries in series make 12V?', a: 'Yes. Wiring two 6 V batteries in series adds the voltages to give 12 V while the amp-hour capacity stays the same — two 6 V, 200 Ah batteries become a 12 V, 200 Ah bank.' },
  { q: 'Why do heavy trucks use 24V systems?', a: 'A 24 V system uses twelve 2 V cells (often two 12 V batteries in series) to deliver the cranking power a large diesel needs at half the current of a 12 V system, which reduces cable size and voltage drop.' },
  { q: 'When did cars switch from 6V to 12V?', a: 'Through the mid-1950s, as higher-compression engines needed more starting power. Some small cars kept 6 V longer — the Volkswagen Beetle into the mid-1960s.' },
  { q: 'What happens if I fit a 12V battery to a 6V system?', a: 'The electrical components receive twice their rated voltage, which can overheat and damage bulbs, regulators and electronics. Voltage is a system decision — the battery must match the vehicle, not the other way around.' },
];
