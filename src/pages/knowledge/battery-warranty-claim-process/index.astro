const faqs = [
  { q: 'How long does a battery warranty typically last?', a: '12 months from bill of lading is the common factory term, while retail brands often run 12–36 months free replacement followed by pro-rata credit — and the pro-rata portion shrinks with the battery age.' },
  { q: 'How are battery warranty claims settled?', a: 'Usually by full replacement inside the free-replacement window (commonly the first 12–24 months), then pro-rata credit after — meaning you receive a fraction of the battery value based on its age, not a full refund.' },
  { q: 'What does a battery warranty exclude?', a: 'Deep discharge (below about 50% charge), misuse, physical damage, incorrect charging and sulfation from long storage — the exclusions are where most claims are refused, so read them before you file.' },
