const title = 'Why Two Batteries with the Same Ah Can Have Different CCA | Dingwei Battery';
const description = 'Why identical amp-hour (Ah) capacity does not mean identical cold cranking amps (CCA). Plate surface area, internal resistance, grid design and design intent decouple capacity from starting power.';
const articleTitle = 'Why two batteries with the same Ah can have different CCA';

const faqs = [
  { q: 'Are Ah and CCA the same thing?', a: 'No. Ah (amp-hours) is total energy storage — how long a battery can deliver a current before depletion. CCA is instantaneous starting power — how much current it can deliver for 30 seconds at a cold temperature. They are controlled by different design factors.' },
  { q: 'Why does a 60Ah battery show 540 CCA while another 60Ah shows 500?', a: 'Because CCA is set by plate surface area, internal resistance and grid design, not by capacity. A thinner-plate starting battery exposes more plate surface and delivers more CCA; a thicker-plate design stores similar Ah but has less exposed surface, so less CCA.' },
  { q: 'Should I always choose the higher CCA at the same Ah?', a: 'Not necessarily. Match CCA to the engine\u2019s cold-start demand and the OEM specification, not a higher number. Over-specifying CCA adds cost and plate surface you will not use.' },
];
