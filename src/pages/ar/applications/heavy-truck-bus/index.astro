---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import ModelCard from '../../../../components/ModelCard.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import DirectAnswer from '../../../../components/DirectAnswer.astro';
import { SITE, MANUFACTURER, RELATIONSHIP } from '../../../../data/site';
import { batteryModels } from '../../../../data/battery-models';

const title = 'بطاريات الشاحنات الثقيلة والحافلات | Dingwei Battery';
const description = 'بطاريات تشغيل الخدمة الشاقة للشاحنات ورؤوس القطر والحافلات — أنظمة 24 فولت، وتشغيل ديزل بتيار CCA عالٍ، وبنية مقاومة للاهتزاز. توريد OEM من Chengguang Power Tech Co., Ltd.';

const breadcrumbs = [{ label: 'الشاحنات الثقيلة والحافلات' }];

const models = batteryModels.filter((m) => ['N150', 'N200'].includes(m.model));

const faqs = [
  {
    q: 'ما البطارية التي تستخدمها الشاحنة الثقيلة أو الحافلة؟',
    a: 'تعمل الشاحنات الثقيلة والحافلات عادةً بنظام 24 فولت مبني من بطاريتي خدمة شاقة 12 فولت على التوالي، مع CCA عالٍ لتدوير الديزل الكبير. تتبع المجموعة أصل الماكينة وتركيبها — سلسلة JIS N (N150/N200) في المركبات التجارية الآسيوية، وDIN الثقيل أو BCI في المعدات الأوروبية والأمريكية الشمالية — دائمًا بما يطابق الحاضنة وترتيب الأطراف ومواصفة CCA.',
  },
  {
    q: 'لماذا تعمل الشاحنات الثقيلة بـ24 فولت بدلًا من 12 فولت؟',
    a: 'مضاعفة الجهد إلى 24 فولت تسلّم نفس قدرة التدوير بنصف التيار، ما يعني كابلات أنحف وانخفاض جهد أقل عبر شاسيه طويل. يُبنى نظام شاحنة 24 فولت عادةً من بطاريتي 12 فولت موصولتين على التوالي ويجب استبداله كزوج متطابق — نفس الموديل والعمر والتصنيف.',
  },
  {
    q: 'كم CCA تحتاج الشاحنة الثقيلة؟',
    a: 'محركات الديزل الكبيرة ذات ضغط عالٍ وتحتاج تيار تدوير قويًا، خاصة في الطقس البارد. تقع مراجع الخدمة الشاقة في حدود 740–1100 CCA حسب المحرك والمناخ، لكن CCA تعتمد على طريقة الاختبار (JIS أو EN أو SAE). تعتمد القيمة الدقيقة على تكوين المركبة ويجب تأكيدها وفق مواصفة OE.',
  },
  {
    q: 'هل يجب استبدال بطاريات الشاحنات الثقيلة في أزواج؟',
    a: 'نعم. يستخدم نظام 24 فولت بطاريتي 12 فولت على التوالي، والبطارية الجديدة المقترنة ببالية تسحب كلتيهما للأسفل. استبدل الزوج معًا — نفس الموديل ونفس العمر ونفس التصنيف — وأكّد المثبّتات ونظافة الأطراف في الوقت نفسه.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/ar/` },
      { '@type': 'ListItem', position: 2, name: 'الشاحنات الثقيلة والحافلات', item: `${SITE.url}/ar/applications/heavy-truck-bus/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} hreflangLocales={['en', 'es', 'ar', 'ru', 'zh']}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">التطبيقات</span>
    <h1>بطاريات الشاحنات الثقيلة والحافلات</h1>
    <p class="lead">{RELATIONSHIP} بطاريات تشغيل الخدمة الشاقة للشاحنات ورؤوس القطر والحافلات — حيث يضع التشغيل الديزل بتيار CCA العالي وأنظمة 24 فولت والاهتزاز المستمر العمل أعلى بكثير من سيارة الركاب.</p>
    <DirectAnswer label="إجابة مباشرة">تحتاج الشاحنات الثقيلة ورؤوس القطر والحافلات إلى بطارية تشغيل خدمة شاقة تسلّم تيار تدوير بارد عاليًا لمحرك الديزل وتتحمل الاهتزاز المستمر على الطريق. يعمل معظمها بنظام 24 فولت مبني من بطاريتي 12 فولت على التوالي، ويتبع حجم المجموعة المركبة — سلسلة JIS N (N150/N200) في المركبات التجارية الآسيوية، وDIN الثقيل أو BCI في المعدات الأوروبية والأمريكية الشمالية. تعتمد المواصفة الدقيقة على تكوين المركبة، لذا يجب تأكيد المجموعة والجهد وأساس CCA وترتيب الأطراف وفق الأسطول قبل الطلب.</DirectAnswer>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>نظرة عامة على التطبيق</h2>
      <p>يغطي هذا التطبيق قطاع المركبات التجارية على الطرق: رؤوس القطر لمسافات طويلة، والشاحنات الصلبة، وحافلات المدينة وبين المدن. الخيط المشترك هو محرك ديزل كبير ونظام كهربائي 24 فولت وعمر عمل من الاهتزاز والتبريد الساخن وبدايات الصباح الباردة — دورة عمل تدمّر بطارية سيارة خفيفة في أشهر.</p>
      <p>تتبع مجموعة البطارية أصل المركبة وتركيبها لا أي قاعدة عامة. تُرجع المركبات التجارية الآسيوية عادةً إلى سلسلة JIS N (N150، N200)؛ وتميل المعدات الأوروبية إلى هياكل DIN الثقيلة؛ وتستخدم الأساطيل الأمريكية الشمالية مجموعات BCI. تختلف أحجام الهياكل وترتيب الأطراف والقطبية بين هذه العائلات وغير قابلة للتبادل حتى عند تصنيف Ah متشابه.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>دورة العمل</h2>
    <p>تواجه بطارية الشاحنة الثقيلة أو الحافلة ثلاثة متطلبات مميزة:</p>
    <ul>
      <li><strong>متطلب تشغيل الديزل.</strong> محرك الديزل الكبير ذو ضغط عالٍ ويحتاج تيار تدوير قويًا، خاصة في الطقس البارد. هذا هو القيد الحاسم على CCA، لا على السعة.</li>
      <li><strong>تكرار تشغيل عالٍ.</strong> قد تشغّل حافلة المدينة وتتوقف عشرات المرات يوميًا، فتدوّر البطارية أكثر بكثير من سيارة خاصة. تشغّل شاحنات المسافات الطويلة أقل لكنها تقضي ليالٍ باردة بين الرحلات.</li>
      <li><strong>فترات تحميل منخفض طويلة.</strong> أثناء التباطؤ أو الوقوف، تدعم البطارية أحمال الفندق — الإضاءة والتدفئة والتبريد والاتصالات عن بُعد — دون أن يستعيد المولّد غالبًا السحب كاملًا. هذا يفضّل بطارية بسعة احتياطية، لا CCA ذروة فقط.</li>
    </ul>
    <p class="note">يعتمد التوازن الدقيق بين متطلب التدوير وحمل الفندق على تكوين المركبة — ملف المسار والمناخ وحمل الملحقات — لذا فإن تصنيفًا «واحدًا يناسب الكل» ليس ذا معنى.</p>
  </section>

  <section class="section container prose">
    <h2>متطلب التشغيل: نظام 24 فولت</h2>
    <p>تعمل الشاحنات الثقيلة والحافلات عادةً بنظام كهربائي 24 فولت مبني من بطاريتي 12 فولت موصولتين على التوالي. مضاعفة الجهد تسلّم نفس قدرة التدوير بنصف التيار، ما يقلّص حجم الكابل وانخفاض الجهد عبر شاسيه طويل — وهو نفس سبب وجود النظام في معدات البناء والآلات الزراعية الكبيرة.</p>
    <p>النتيجة العملية هي أن الزوج يجب أن يُعامل كوحدة واحدة. البطارية الجديدة المقترنة ببالية تُسحب إلى مستوى البطارية الأضعف، لذا يُستبدل الزوج معًا — نفس الموديل ونفس العمر ونفس التصنيف. أكّد التوصيل (توالي لـ24 فولت، لا توازٍ) وترتيب الأطراف قبل التركيب.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>البيئة</h2>
      <ul>
        <li><strong>الاهتزاز.</strong> صدمات الطريق والأسطح الخشنة تُتعب الصفائح وتفكّ الأطراف والمثبّتات. بنية الخدمة الشاقة — صفائح أسمك وهيكل أصلب ولحامات داخلية أقوى — فرق بنيوي، لا مجرد رقم CCA أكبر.</li>
        <li><strong>الغبار وتلوث الطريق.</strong> الغبار ورذاذ الملح والرطوبة تسرّع تآكل الأطراف وقد تجسر أطرافًا مكشوفة. يقلّل الهيكل المحكم دون صيانة وجدول تنظيف الأطراف المنتظم من الخطر.</li>
        <li><strong>درجة الحرارة.</strong> يرفع البرد متطلب التدوير (CCA أهم في الشتاء)، بينما حرارة حجرة المحرك هي القاتل طويل الأمد الذي يدفع فقدان الماء وتآكل الصفائح. تُقاس البطارية لأبرد صباح وتُبنى لأحرّ ظهيرة.</li>
      </ul>
    </div>
  </section>

  <section class="section container prose">
    <h2>متطلبات البطارية</h2>
    <p>تُحدَّد بطارية الشاحنة الثقيلة أو الحافلة بسلسلة قرار قصيرة:</p>
    <ol>
      <li><strong>المجموعة وعائلة المعيار أولًا.</strong> سلسلة JIS N وDIN الثقيل ومجموعات BCI غير قابلة للتبادل — أكّد أبعاد الحاضنة وترتيب الأطراف قبل أي شيء آخر.</li>
      <li><strong>الجهد.</strong> 24 فولت (بطاريتا 12 فولت على التوالي) هو المعيار للشاحنات والحافلات؛ أكّد النظام قبل التحديد.</li>
      <li><strong>CCA مع أساس اختباره.</strong> رقم التدوير لا يعني شيئًا إلا مقابل معيار معلن (JIS أو EN أو SAE). تعتمد القيمة الدقيقة على المحرك والمناخ.</li>
      <li><strong>السعة والاحتياطي.</strong> تدعم السعة (Ah عند C20) والسعة الاحتياطية أحمال الفندق وعمل التباطؤ؛ يعتمد التوازن على ملف ملحقات المركبة.</li>
    </ol>
    <p class="note">لا تنطبق قيمة CCA أو سعة عالمية على جميع الشاحنات الثقيلة والحافلات — تعتمد القيمة الصحيحة على التكوين ويجب تأكيدها وفق مواصفة OE والشركة المصنعة.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">الموديلات المرجعية</span>
      <h2>بطاريات DINGWEY ذات الصلة</h2>
      <p class="lead">مرجعان للخدمة الشاقة من سلسلة JIS N من مجموعة الموديلات الحالية، مطابقان لتطبيق الشاحنات الثقيلة والحافلات. المواصفات قيم مرجعية — أكّد الأرقام النهائية مع الشركة المصنعة.</p>
      <div class="model-list">
        {models.map((model) => <ModelCard model={model} />)}
      </div>
      <p class="lead">يقع كلا المرجعين في عائلة سلسلة JIS N المستخدمة في المركبات التجارية الآسيوية. انظر النطاق الكامل في <a href="/ar/heavy-duty-batteries/">فئة بطاريات الخدمة الشاقة</a>.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>كيانات ذات صلة</h2>
    <ul>
      <li><a href="/ar/knowledge/jis-vs-din-vs-bci/">معايير البطاريات JIS مقابل DIN مقابل BCI</a> — افهم لماذا عائلة المعيار، لا Ah فقط، تحدد التركيب.</li>
      <li><a href="/ar/tools/battery-finder/">أداة اختيار البطارية</a> — ضيّق الموديل وفق الجهد والمجموعة والتطبيق.</li>
      <li><a href="/ar/tools/compare/">قارن بين موديلين</a> — مواصفات جنبًا إلى جنب للقائمة المختصرة.</li>
      <li><a href="/ar/knowledge/battery-applications-by-vehicle/">تطبيقات البطارية حسب نوع المركبة</a> — كيف يختلف عمل الشاحنات والحافلات عن الركاب والبناء.</li>
      <li><a href="/ar/data/">مرجع بيانات الموديلات</a> — المجموعة الكاملة للموديلات مع أساس CCA وحالة التحقق.</li>
    </ul>
  </section>

  <section class="section container prose">
    <h2>الأسئلة الشائعة</h2>
    {faqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
    <p><a href="/ar/knowledge/oem-battery-specification-guide/">استخدم دليل مواصفات بطارية OEM &larr;</a></p>
  </section>

  <CTASection title="اطلب عرض سعر بطارية الشاحنات الثقيلة والحافلات" />
</BaseLayout>
