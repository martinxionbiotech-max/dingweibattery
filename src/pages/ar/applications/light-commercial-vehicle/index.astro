---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import ModelCard from '../../../../components/ModelCard.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import DirectAnswer from '../../../../components/DirectAnswer.astro';
import { SITE, MANUFACTURER, RELATIONSHIP } from '../../../../data/site';
import { batteryModels } from '../../../../data/battery-models';

const title = 'بطاريات المركبات التجارية الخفيفة | Dingwei Battery';
const description = 'بطاريات تشغيل للشاحنات الخفيفة والبيك أب والشاحنات الصغيرة والمركبات الخدمية — أنظمة 12 فولت وتشغيل ديزل ومقاومة للاهتزاز. توريد OEM من Chengguang Power Tech Co., Ltd.';

const breadcrumbs = [{ label: 'المركبات التجارية الخفيفة' }];

const models = batteryModels.filter((m) => ['N100', '80D26', '85D26', '95D26', '105D31'].includes(m.model));

const faqs = [
  {
    q: 'ما البطارية التي تستخدمها المركبة التجارية الخفيفة؟',
    a: 'تعمل الشاحنات الخفيفة والبيك أب والشاحنات الصغيرة غالبًا بنظام 12 فولت ببطارية تشغيل واحدة مقاسة للمحرك والحمل الكهربائي. تحتاج المركبات التجارية الخفيفة الديزل CCA أعلى من سيارة الركاب لنفس حجم المحرك، وتتبع المجموعة المركبة — عادةً JIS D26/D31 أو N100 في التركيبات الآسيوية، ومكافئات DIN/BCI في الأسواق الأخرى.',
  },
  {
    q: 'لماذا تحتاج شاحنة الديزل الخفيفة CCA أكثر من سيارة البنزين؟',
    a: 'محرك الديزل ذو ضغط أعلى من محرك بنزين بحجم مماثل، لذا يحتاج تيار تدوير أقوى — خاصة في البرد. يعتمد متطلب CCA على طريقة الاختبار (JIS أو EN أو SAE)، وتعتمد القيمة الدقيقة على المحرك، لذا يجب تأكيدها وفق مواصفة OE.',
  },
  {
    q: 'هل تستطيع المركبة التجارية الخفيفة استخدام بطارية شاحنة ثقيلة؟',
    a: 'لا. بطاريات الشاحنات الثقيلة مبنية لأنظمة توالي 24 فولت ومجموعات أكبر ماديًا. المركبة التجارية الخفيفة عادةً 12 فولت بحاضنة أصغر، لذا لن تلائم بطارية الشاحنة الثقيلة وجهدها خاطئ. يجب أن تطابق المجموعة وترتيب الأطراف المركبة، لا تصنيف Ah فقط.',
  },
  {
    q: 'ما الذي يهلك البطارية التجارية الخفيفة أسرع؟',
    a: 'عمل التوصيل الحضري بالتشغيل والإيقاف، وأحمال الملحقات التي تعمل مع إيقاف المحرك، والحرارة. الرحلات القصيرة المتكررة والتباطؤ الطويل يمنعان الشحن الكامل، بينما تسرّع حرارة حجرة المحرك فقدان الماء وتآكل الصفائح. البطارية المقاسة صحيحًا مع جدول تنظيف أطراف منتظم تدوم أطول.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/ar/` },
      { '@type': 'ListItem', position: 2, name: 'المركبات التجارية الخفيفة', item: `${SITE.url}/ar/applications/light-commercial-vehicle/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} hreflangLocales={['en', 'es', 'ar', 'ru', 'zh']}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">التطبيقات</span>
    <h1>بطاريات المركبات التجارية الخفيفة</h1>
    <p class="lead">{RELATIONSHIP} بطاريات تشغيل للشاحنات الخفيفة والبيك أب والشاحنات الصغيرة والمركبات الخدمية — حيث يقف التشغيل الديزل وعمل التوصيل بالتشغيل والإيقاف وأحمال الملحقات درجة فوق سيارة الركاب، لكن دون عالم 24 فولت للشاحنات الثقيلة.</p>
    <DirectAnswer label="إجابة مباشرة">تعمل الشاحنات الخفيفة والبيك أب والشاحنات الصغيرة والمركبات الخدمية غالبًا بنظام 12 فولت ببطارية تشغيل واحدة مقاسة للمحرك والحمل الكهربائي. تحتاج المركبات التجارية الخفيفة الديزل CCA أعلى من سيارة الركاب لنفس حجم المحرك، وتتبع المجموعة المركبة — عادةً JIS D26/D31 أو N100 في التركيبات الآسيوية، ومكافئات DIN/BCI في أماكن أخرى. تعتمد المجموعة وأساس CCA وترتيب الأطراف الدقيقة على تكوين المركبة ويجب تأكيدها قبل الطلب.</DirectAnswer>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>نظرة عامة على التطبيق</h2>
      <p>يغطي هذا التطبيق القطاع التجاري الخفيف بين سيارات الركاب والشاحنات الثقيلة: البيك أب والشاحنات المتوسطة وشاحنات التوصيل وشاحنات الصندوق والمركبات الخدمية الخفيفة. العمل نظام 12 فولت ببطارية واحدة، لكن المحرك والحمل الكهربائي يطلبان أكثر مما تسلّمه بطارية سيارة الركاب — ضغط ديزل وساعات تشغيل أطول وأحمال ملحقات تعمل مع إيقاف المحرك.</p>
      <p>تتبع المجموعة المركبة لا قاعدة عامة. تُرجع التركيبات التجارية الخفيفة الآسيوية عادةً إلى JIS D26/D31 أو N100؛ وتميل المركبات الأوروبية إلى هياكل DIN/EN؛ وتستخدم أسواق أمريكا الشمالية وأستراليا BCI أو مكافئات نوع N. تختلف أحجام الهياكل وترتيب الأطراف والقطبية بين العائلات وغير قابلة للتبادل عند تصنيف Ah متشابه.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>دورة العمل</h2>
    <p>تواجه البطارية التجارية الخفيفة ثلاثة متطلبات تفصلها عن سيارة الركاب:</p>
    <ul>
      <li><strong>متطلب تشغيل الديزل.</strong> شاحنات الديزل الخفيفة ذات ضغط أعلى من محركات البنزين بحجم مماثل، لذا تحتاج تيار تدوير أقوى — متطلب CCA هو القيد الحاسم، خاصة في الطقس البارد.</li>
      <li><strong>تكرار تشغيل يومي عالٍ.</strong> التوصيل بالتشغيل والإيقاف وعمل النقاط المتعددة يدوّران البطارية أكثر بكثير من سيارة خاصة، مع رحلات قصيرة متكررة لا تشحنها كاملًا أبدًا.</li>
      <li><strong>فترات تحميل منخفض طويلة.</strong> الروافع الخلفية والتبريد ومراوح المقصورة والاتصالات عن بُعد تسحب الطاقة مع إيقاف المحرك أو تباطؤه، ما يفضّل السعة الاحتياطية إضافة إلى CCA الذروة.</li>
    </ul>
    <p class="note">يعتمد التوازن بين متطلب التدوير وحمل الملحقات على تكوين المركبة — ملف المسار والمناخ والمعدات — لذا فإن تصنيفًا عالميًا واحدًا ليس ذا معنى.</p>
  </section>

  <section class="section container prose">
    <h2>متطلب التشغيل: نظام 12 فولت</h2>
    <p>بخلاف الشاحنات الثقيلة، تعمل المركبات التجارية الخفيفة غالبًا بنظام كهربائي 12 فولت ببطارية تشغيل واحدة. تُقاس البطارية مباشرة لحمل تدوير المحرك وملف ملحقات المركبة، فلا يوجد زوج توالي للموازنة — قرار التركيب هو مجموعة صحيحة وجهد صحيح وأساس CCA صحيح.</p>
    <p>النتيجة العملية هي أن بطارية الشاحنة الثقيلة خيار خاطئ: فهي مبنية لنظام توالي 24 فولت ومجموعة أكبر ماديًا، لذا لن تلائم الحاضنة وجهدها خاطئ. تحمل المركبة التجارية الخفيفة مجموعة 12 فولت مطابقة لأبعادها وترتيب أطرافها، لا رقم Ah أكبر من قطاع آخر.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>البيئة</h2>
      <ul>
        <li><strong>الاهتزاز.</strong> الشاحنات الخفيفة والشاحنات الصغيرة على طرق وعرة وأسطح غير معبّدة تنقل اهتزازًا يُتعب الصفائح ويفكّ الأطراف. الهيكل الصلب والمثبّت الآمن مهمان بقدر تصنيف CCA.</li>
        <li><strong>الغبار والتلوث.</strong> عمل التوصيل والموقع يعرّض البطارية للغبار والرطوبة ورذاذ الطريق التي تآكل الأطراف. الهيكل المحكم دون صيانة وجدول تنظيف الأطراف المنتظم يقلّلان الخطر.</li>
        <li><strong>درجة الحرارة.</strong> يرفع البرد متطلب التدوير، بينما حرارة حجرة المحرك هي القاتل طويل الأمد الذي يدفع فقدان الماء وتآكل الصفائح. تُقاس البطارية لأبرد صباح وتُبنى لأحرّ ظهيرة.</li>
      </ul>
    </div>
  </section>

  <section class="section container prose">
    <h2>متطلبات البطارية</h2>
    <p>تُحدَّد البطارية التجارية الخفيفة بنفس سلسلة القرار القصيرة، مصغّرة من الخدمة الشاقة:</p>
    <ol>
      <li><strong>المجموعة وعائلة المعيار أولًا.</strong> مجموعات JIS D26/D31/N100 وDIN/EN وBCI غير قابلة للتبادل — أكّد أبعاد الحاضنة وترتيب الأطراف قبل أي شيء آخر.</li>
      <li><strong>الجهد.</strong> 12 فولت هو المعيار للمركبات التجارية الخفيفة؛ أكّد النظام قبل التحديد.</li>
      <li><strong>CCA مع أساس اختباره.</strong> رقم التدوير لا يعني شيئًا إلا مقابل معيار معلن (JIS أو EN أو SAE). تحتاج نسخ الديزل أكثر من مكافئات البنزين.</li>
      <li><strong>السعة والاحتياطي.</strong> تدعم السعة (Ah عند C20) أحمال الملحقات وعمل التباطؤ؛ يعتمد التوازن على معدات المركبة.</li>
    </ol>
    <p class="note">لا تنطبق قيمة CCA أو سعة عالمية على جميع المركبات التجارية الخفيفة — تعتمد القيمة الصحيحة على التكوين ويجب تأكيدها وفق مواصفة OE والشركة المصنعة.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">الموديلات المرجعية</span>
      <h2>بطاريات DINGWEY ذات الصلة</h2>
      <p class="lead">مراجع تجارية خفيفة من مجموعة الموديلات الحالية، مطابقة لتطبيق الشاحنات الخفيفة والبيك أب والشاحنات الصغيرة. المواصفات قيم مرجعية — أكّد الأرقام النهائية مع الشركة المصنعة.</p>
      <div class="model-list">
        {models.map((model) => <ModelCard model={model} />)}
      </div>
      <p class="lead">تغطي هذه المراجع عائلات JIS D26/D31 وN100 المستخدمة في التركيبات التجارية الخفيفة. انظر النطاق الكامل في <a href="/ar/data/">مرجع بيانات الموديلات</a>.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>كيانات ذات صلة</h2>
    <ul>
      <li><a href="/ar/knowledge/jis-vs-din-vs-bci/">معايير البطاريات JIS مقابل DIN مقابل BCI</a> — افهم لماذا عائلة المعيار، لا Ah فقط، تحدد التركيب.</li>
      <li><a href="/ar/tools/battery-finder/">أداة اختيار البطارية</a> — ضيّق الموديل وفق الجهد والمجموعة والتطبيق.</li>
      <li><a href="/ar/tools/compare/">قارن بين موديلين</a> — مواصفات جنبًا إلى جنب للقائمة المختصرة.</li>
      <li><a href="/ar/knowledge/battery-applications-by-vehicle/">تطبيقات البطارية حسب نوع المركبة</a> — كيف يختلف العمل التجاري الخفيف عن الركاب والشاحنات الثقيلة.</li>
      <li><a href="/ar/applications/heavy-truck-bus/">بطاريات الشاحنات الثقيلة والحافلات</a> — الخطوة التالية في العمل والجهد.</li>
    </ul>
  </section>

  <section class="section container prose">
    <h2>الأسئلة الشائعة</h2>
    {faqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
    <p><a href="/ar/knowledge/oem-battery-specification-guide/">استخدم دليل مواصفات بطارية OEM &larr;</a></p>
  </section>

  <CTASection title="اطلب عرض سعر بطارية المركبات التجارية الخفيفة" />
</BaseLayout>
