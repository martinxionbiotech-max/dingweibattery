---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';
import { STANDARDS } from '../../../../data/site';

const title = 'كيف تكتب RFQ لبطاريات OEM | Dingwei Battery';
const description = 'كيف تكتب RFQ لبطاريات OEM يحصل على عروض أسعار دقيقة: حقول المواصفات، الحجم، التغليف، الشهادة ومتطلبات التسليم.';
const articleTitle = 'دليل RFQ بطاريات OEM';

const faqs = [
  { q: 'لماذا تفشل معظم طلبات RFQ؟', a: 'ثلاثة حقول مفقودة: أساس CCA، والحجم السنوي، ومعيار واحد لكل سطر. لا يمكن للمورد التسعير بدقة إلا على نطاق واحد، لا على نطاق غامض.' },
  { q: 'هل أدرج سعرًا مستهدفًا في RFQ؟', a: 'ليس في RFQ الأولى. سعّر على النطاق أولًا لتحصل على ردود هندسية صادقة، ثم فاوض على السعر بعد تثبيت النطاق.' },
  { q: 'كم موديلًا يجب أن يغطيه بند سطر RFQ واحد؟', a: 'موديل واحد. خلط موديلات JIS وDIN في سطر واحد يجبر المورد على التخمين، فتحصل على نطاق بدلًا من عرض سعر.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="التوريد" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة</span>
    <h1>دليل RFQ بطاريات OEM</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-01 · المصدر: الوثائق الفنية لشركة Chengguang Power Tech Co., Ltd.</p>
    <p class="lead">يمنحك RFQ الكامل عروض أسعار قابلة للمقارنة؛ أما الغامض فيمنحك نطاقًا واسعًا بلا فائدة. أدرج هذه الحقول.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> تفشل معظم طلبات RFQ لبطاريات OEM بسبب ثلاثة حقول مفقودة — أساس اختبار CCA، والحجم السنوي، ومعيار واحد لكل سطر. لا يمكن للمورد التسعير بدقة إلا على نطاق واحد، لذا فإن RFQ الغامض يعيد نطاقًا واسعًا بلا فائدة.
    </div>

    <h2>كتلة المواصفات</h2>
    <ul>
      <li>نوع البطارية (SLI أو AGM أو EFB أو الخدمة الشاقة)</li>
      <li>عائلة المعايير ({STANDARDS.join(', ')})</li>
      <li>الموديل المرجعي (مثل 65D26)</li>
      <li>الجهد والسعة (Ah) وCCA</li>
      <li>حجم الهيكل ونوع الطرف والقطبية</li>
    </ul>

    <h2>كتلة الحجم</h2>
    <ul>
      <li>الحجم السنوي</li>
      <li>كمية الطلب الأول</li>
      <li>التوقع حسب الموديل إذا كان مختلطًا</li>
      <li>السوق المستهدف (يؤثر على المعيار والشهادة)</li>
    </ul>

    <h2>كتلة العلامة التجارية</h2>
    <ul>
      <li>علامة خاصة أم OEM</li>
      <li>تصميم الملصق والتغليف</li>
      <li>تكوين المنصات (الباليتات)</li>
      <li>وثائق متعددة اللغات</li>
    </ul>

    <h2>الكتلة التجارية</h2>
    <ul>
      <li>السعر المستهدف (اختياري)</li>
      <li>شروط التسليم (Incoterms)</li>
      <li>شروط الدفع</li>
      <li>جدول التسليم</li>
    </ul>
    <p><a href="/ar/contact/">أرسل RFQ بطاريات OEM &larr;</a> · <a href="/ar/knowledge/oem-battery-specification-guide/">ابنِ مواصفات نظيفة &larr;</a></p>

    <h2>قائمة مراجعة حقول RFQ</h2>
    <p>عادةً ما يحوّل حقل مفقود واحد عرض السعر إلى تخمين. راجع هذا الجدول قبل الإرسال.</p>
    <table>
      <thead><tr><th>الكتلة</th><th>الحقل</th><th>لماذا يهم</th></tr></thead>
      <tbody>
        <tr><td>المواصفات</td><td>عائلة المعايير + الموديل المرجعي</td><td>هياكل JIS وDIN وBCI غير قابلة للتبادل؛ فالموديل يثبّت حجم الهيكل.</td></tr>
        <tr><td>المواصفات</td><td>أساس اختبار CCA</td><td>JIS (&minus;15&deg;م) وEN/SAE (&minus;18&deg;م) اختباران مختلفان؛ وبدون الأساس لا يكون العرضان قابلين للمقارنة.</td></tr>
        <tr><td>المواصفات</td><td>نوع الطرف &amp; القطبية</td><td>يقرر توزيع الأطراف ما إذا كانت البطارية تتسع ماديًا في المركبة.</td></tr>
        <tr><td>الحجم</td><td>الحجم السنوي + الطلب الأول</td><td>يعتمد MOQ والتسعير المتدرج عليه؛ فالحجم المفقود يجعل المورد يفترض أسوأ الحالات.</td></tr>
        <tr><td>الحجم</td><td>السوق المستهدف</td><td>يقرر السوق عائلة المعايير ومجموعة الشهادات.</td></tr>
        <tr><td>العلامة التجارية</td><td>الملصق + التغليف + الوثائق</td><td>يغيّر نطاق العلامة الخاصة القوالب ومهلة التسليم.</td></tr>
        <tr><td>التجاري</td><td>شروط التسليم + الدفع</td><td>تنقل FOB وCFR وCIF التكلفة والمخاطر بشكل مختلف بين المشتري والمورد.</td></tr>
      </tbody>
    </table>
    <p class="note">لا تضع هدف سعر في RFQ الأولى إلا إذا أردت أن يسعّر الموردون وفق الرقم بدلًا من النطاق. سعّر على النطاق أولًا؛ وفاوض على السعر ثانيًا.</p>

    <h2>قارن عروض الأسعار على النطاق، لا السعر</h2>
    <p>عند عودة عروض الأسعار، افحص ستة أشياء قبل مقارنة رقم الوحدة:</p>
    <ul>
      <li><strong>نفس أساس CCA</strong> — أرقام JIS وEN غير قابلة للمقارنة.</li>
      <li><strong>نفس مرجع الهيكل</strong> — عرض سعر لموديل «مشابه» هو بطارية مختلفة.</li>
      <li><strong>نفس شريحة MOQ</strong> — سعر عند 10,000 وحدة ليس سعرًا عند 1,000 وحدة.</li>
      <li><strong>القوالب مشمولة</strong> — هل تكلفة القالب أو الملصق ضمن سعر الوحدة أم تُحتسب منفصلة؟</li>
      <li><strong>نفس Incoterm</strong> — FOB وCFR وCIF ثلاثة أسس تكلفة مختلفة.</li>
      <li><strong>نطاق الضمان</strong> — ضمان 12 شهرًا مع استثناءات ليس كضمان 12 شهرًا.</li>
    </ul>

    <h2>لماذا تفشل معظم طلبات RFQ</h2>
    <ul>
      <li>أساس CCA مفقود، فتصل العروض بطرق اختبار مختلفة.</li>
      <li>الحجم السنوي مفقود، فيختلف MOQ وافتراضات الإنتاج.</li>
      <li>معايير متعددة مخلوطة في سطر واحد، فيخمّن المورد بدلًا من تسعير نطاق واحد.</li>
    </ul>
    <p>قارن العروض المعادة فقط بعد تثبيت تلك الحقول. ابدأ بـ<a href="/ar/knowledge/oem-battery-specification-guide/">دليل المواصفات</a> وأبقِ موديلًا واحدًا لكل بند سطر.</p>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002).</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>رأي المؤلف</h2>
      <p><strong>الموقف:</strong> في رأيي، طلب العرض الكامل يمنحك عروضًا قابلة للمقارنة، والغامض يمنحك نطاقًا عريضًا بلا فائدة — وثلاثة حقول ناقصة تُفشل كل طلب عرض تقريبًا.</p>
      <p><strong>الأسباب:</strong></p>
      <ul>
        <li>أساس اختبار CCA والحجم السنوي ومعيار واحد لكل سطر هي الحقول التي تحوّل العرض إلى تخمين.</li>
        <li>قارن العروض العائدة على أساس النطاق قبل السعر؛ فالمورّد غير القابل للمقارنة في ثلاثة من ستة حقول لا يخبرك بشيء مهما رخص الرقم.</li>
        <li>لا تضع سعرًا مستهدفًا في طلب العرض الأول — المورّدون يقدّرون على رقم عندما تعطيهم إياه، والنطاق يجب أن يسبق السعر.</li>
      </ul>
      <p><em>إفصاح: هذا حكم تحريري وتجربة ميدانية للمؤلف، وليس ادعاءً تقنيًا موثّقًا.</em></p>
    </div>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="أرسل RFQ OEM كاملًا" />
</ArticleLayout>
