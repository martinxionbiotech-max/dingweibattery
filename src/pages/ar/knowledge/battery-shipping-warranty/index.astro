---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';
import { MANUFACTURER, TRADE_TERMS } from '../../../../data/site';

const title = 'شحن البطاريات وتغليفها وضمانها | Dingwei Battery';
const description = 'كيف تُعبأ بطاريات الرصاص الحمضي وتُشحن وتُضمن — تحميل الحاوية، وثائق التصدير، وما الذي يغطيه ضمان 12 شهرًا فعلًا.';
const articleTitle = 'شحن البطاريات وتغليفها وضمانها';

const faqs = [
  { q: 'هل بطاريات الرصاص الحمضي بضائع خطرة؟', a: 'بطاريات التشغيل بالرصاص الحمضي بضائع خطرة من الفئة 8 (أكّالة) بموجب مدونة IMDG — UN 2794 (مملوءة بالحمض) أو UN 2800 (غير قابلة للانسكاب). الميزة العملية مقارنة بالليثيوم أنها لا تتطلب تقرير اختبار UN 38.3. ومع ذلك تحتاج إلى تغليف بضائع خطرة مطابق، وحيثما ينطبق ذلك، إقرار بضائع خطرة. راجع سياسة الشحن والامتثال لدينا.' },
  { q: 'لماذا يتبع MOQ البطاريات الحاوية؟', a: 'البطاريات ثقيلة، لذا تصل حاوية 20 قدمًا غالبًا إلى حد وزنها قبل حد حجمها — ولهذا يرتبط MOQ بالحاوية.' },
  { q: 'ما الذي يغطيه ضمان 12 شهرًا فعلًا؟', a: 'يعتمد على النطاق المكتوب — المدة والاستثناءات ومعالجة المطالبات. أكّد الثلاثة كتابيًا قبل الاعتماد عليه.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="الخدمات اللوجستية" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة · الخدمات اللوجستية</span>
    <h1>شحن البطاريات وتغليفها وضمانها</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-03 · المصدر: ممارسات لوجستيات التصدير</p>
    <p class="lead">لا يكتمل طلب البطاريات عندما يغادر الخط — بل يكتمل عندما يصل دون تلف، بالوثائق الصحيحة، وبضمان تفهمه.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> بطاريات الرصاص الحمضي بضائع خطرة من الفئة 8 (أكّالة) — UN 2794 مملوءة بالحمض، أو UN 2800 غير قابلة للانسكاب — لكنها، على عكس الليثيوم، لا تتطلب تقرير UN 38.3. النقاط اللوجستية الرئيسية هي حدود وزن الحاوية، وثائق التصدير، وضمان نطاقه — المدة والاستثناءات والمعالجة — مكتوب.
    </div>

    <h2>لماذا الرصاص الحمضي أبسط شحنًا</h2>
    <p>على عكس خلايا الليثيوم (الفئة 9)، تُعدّ بطاريات التشغيل بالرصاص الحمضي بضائع خطرة من الفئة 8 (أكّالة) — UN 2794 مملوءة بالحمض، أو UN 2800 غير قابلة للانسكاب. الميزة الرئيسية للمستوردين هي أنها لا تتطلب تقرير UN 38.3؛ ومع ذلك تحتاج إلى تغليف بضائع خطرة مطابق، وحيثما ينطبق ذلك، إقرار بضائع خطرة.</p>

    <h2>التغليف وتحميل الحاوية</h2>
    <p>البطاريات ثقيلة، لذا تصل حاوية 20 قدمًا غالبًا إلى حد وزنها قبل حد حجمها. لهذا يتبع MOQ الحاوية (عادةً {TRADE_TERMS.moq}). يجب أن يحمي التغليف الأطراف من القصر والهيكل من الصدمات أثناء المناولة.</p>
    <ul>
      <li>منصات وكراتين بحجم خطة الحاوية.</li>
      <li>حماية الأطراف والتوجيه الرأسي.</li>
      <li>تحميل موديلات مختلطة لملء حاوية بكفاءة وتوزيع تكلفة الوحدة.</li>
    </ul>

    <h2>وثائق التصدير</h2>
    <p>مجموعة تصدير نظيفة تتجنب تأخيرات الجمارك. تشمل الوثائق النموذجية:</p>
    <ul>
      <li>الفاتورة التجارية وقائمة التعبئة</li>
      <li>بوليصة الشحن</li>
      <li>شهادة المنشأ</li>
      <li>تقارير الاختبار (CCA / السعة) عند الاقتضاء</li>
    </ul>
    <p>تتبع شروط الشحن {TRADE_TERMS.incoterms}، مع التصدير من {MANUFACTURER.exportPorts}.</p>

    <h2>الضمان: اقرأ النطاق، لا الرقم فقط</h2>
    <p>الضمان هو {TRADE_TERMS.warranty}. لكن الضمان لا يكون إلا بقدر نطاقه المكتوب. أكّد ثلاثة أشياء:</p>
    <ol>
      <li><strong>المدة</strong> — من تاريخ بوليصة الشحن.</li>
      <li><strong>الاستثناءات</strong> — ما <em>لا</em> يغطيه (التفريغ العميق، سوء الاستخدام، التلف المادي).</li>
      <li><strong>المعالجة</strong> — كيف تُقدَّم المطالبة وتُفحص وتُسوى.</li>
    </ol>
    <p class="note">«ضمان 12 شهرًا» باستثناءات واسعة ليس كضمان 12 شهرًا باستثناءات واضحة وضيقة. احصل على الشروط كتابيًا.</p>

    <h2>ما الذي يجب أن يسأله المشترون</h2>
    <ul>
      <li>كيف تُعبأ البطاريات وتُحمّل — هل الحاوية محدودة بالوزن أم الحجم؟</li>
      <li>ما وثائق التصدير المقدمة كمعيار؟</li>
      <li>ما استثناءات الضمان ومعالجة المطالبات بالضبط؟</li>
      <li>ما Incoterm المطبق، وأين ينتقل الخطر؟</li>
    </ul>

    <p>اطّلع على عمل مهلة التسليم وMOQ في <a href="/ar/knowledge/oem-battery-moq-lead-time/">دليل MOQ ومهلة التسليم</a>، وكيفية قفل الشروط في <a href="/ar/knowledge/oem-battery-rfq-guide/">RFQ</a>.</p>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002).</p>
    <p><a href="/ar/contact/">شروط شحن البطاريات وضمانها &larr;</a></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="أكّد شروط الشحن والضمان" />
</ArticleLayout>
