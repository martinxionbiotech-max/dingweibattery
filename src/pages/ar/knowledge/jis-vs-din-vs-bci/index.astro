---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';

const title = 'معايير البطاريات JIS مقابل DIN مقابل BCI | Dingwei Battery';
const description = 'كيف تختلف معايير البطاريات JIS وDIN/EN وBCI في حجم الهيكل وتوزيع الأطراف وطريقة اختبار CCA — وكيف تختار المعيار الصحيح لسوقك.';
const articleTitle = 'معايير البطاريات JIS مقابل DIN مقابل BCI';

const faqs = [
  { q: 'ما الفرق بين بطاريات JIS وDIN وBCI؟', a: 'تحدد أبعاد هيكل وتوزيعات أطراف وطرق اختبار CCA مختلفة لأسواق مختلفة — JIS لليابان/آسيا، وDIN/EN لأوروبا، وBCI لأمريكا الشمالية.' },
  { q: 'هل بطاريات JIS وDIN قابلة للتبادل؟', a: 'لا. حتى مع تصنيفات كهربائية متشابهة، يختلف الهيكل المادي وتوزيع الأطراف، فلن تتسع عائلة في مركبة محددة لأخرى.' },
  { q: 'كيف أختار معيار البطارية الصحيح؟', a: 'اختر وفق سوق المركبة، لا مواصفات البطارية — JIS للمركبات اليابانية/الآسيوية، وDIN/EN للأوروبية، وBCI لأمريكا الشمالية.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="المعايير" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة · المعايير</span>
    <h1>معايير البطاريات JIS مقابل DIN مقابل BCI</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-03 · المصدر: وثائق معايير البطاريات</p>
    <p class="lead">يحدد «حجم» البطارية عائلة المعايير التي يستخدمها سوقك. بطاريات JIS وDIN/EN وBCI ذات التصنيفات الكهربائية المتشابهة مختلفة ماديًا — وغير قابلة للتبادل.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> بطاريات JIS وDIN/EN وBCI غير قابلة للتبادل حتى عند تصنيفات Ah متشابهة — تختلف أبعاد الهيكل وتوزيع الأطراف وطريقة اختبار CCA. طلب العائلة الخاطئة يعني أن البطارية لن تتسع في الحاضنة، بغض النظر عن ورقة المواصفات.
    </div>

    <h2>العائلات الثلاث في لمحة</h2>
    <table>
      <thead><tr><th>المعيار</th><th>المنطقة</th><th>مرجع الهيكل النموذجي</th><th>اختبار CCA</th></tr></thead>
      <tbody>
        <tr><td>JIS</td><td>اليابان / آسيا</td><td>D23، D26، D31، B24</td><td>&minus;15&deg;م</td></tr>
        <tr><td>DIN / EN</td><td>أوروبا</td><td>H5–H8 (LN2–LN5)، L3–L5</td><td>&minus;18&deg;م</td></tr>
        <tr><td>BCI</td><td>أمريكا الشمالية</td><td>المجموعة 24، 27، 31، 34، 48، 65</td><td>&minus;18&deg;م (SAE)</td></tr>
      </tbody>
    </table>

    <h2>لماذا ليست قابلة للتبادل</h2>
    <p>تمنع ثلاثة فروق البطارية من عبور عائلات المعايير:</p>
    <ol>
      <li><strong>أبعاد الهيكل</strong> — قد يكون JIS D26 وDIN H6 كلاهما ~12 فولت/72 أمبير-ساعة، لكن طولهما وعرضهما وارتفاعهما يختلف، فلا يتسعان في الحاضنة نفسها.</li>
      <li><strong>توزيع الأطراف</strong> — يختلف نوع الطرف والموضع واصطلاح القطبية بين الأسواق. فبطارية تتسع ماديًا قد تظل بأطراف خاطئة.</li>
      <li><strong>طريقة اختبار CCA</strong> — يختبر JIS عند &minus;15&deg;م، وEN/SAE عند &minus;18&deg;م، لذا فإن CCA المطبوع غير قابل للمقارنة المباشرة بين العائلات.</li>
    </ol>

    <h2>كيف تختار المعيار الصحيح</h2>
    <p>اختر وفق سوق المركبة، لا مواصفات البطارية:</p>
    <ul>
      <li><strong>المركبات اليابانية أو الآسيوية</strong> → حدد JIS واختر مجموعة الهيكل D/B.</li>
      <li><strong>المركبات الأوروبية</strong> → حدد DIN/EN واختر مجموعة الهيكل H/LN/L.</li>
      <li><strong>مركبات أمريكا الشمالية</strong> → حدد BCI واختر رقم المجموعة.</li>
    </ul>
    <p class="note">يمكن لمصنع واحد توفير كل معيار رئيسي، لكن يجب على المشتري تسمية العائلة الصحيحة. «بطارية 72 أمبير-ساعة» بدون معيار ليست مواصفات كاملة.</p>

    <h2>ما الذي يجب أن يسأله المشترون</h2>
    <ul>
      <li>ما عائلة المعايير التي تستخدمها مركبتي المستهدفة؟</li>
      <li>ما مرجع الهيكل الدقيق (D26 أو H6 أو المجموعة 34)؟</li>
      <li>ما نوع الطرف والقطبية الذي تحتاجه المركبة؟</li>
      <li>هل رقم CCA هو JIS أم EN/SAE؟</li>
    </ul>

    <p>اطّلع على اختلاف CCA بين المعايير في <a href="/ar/knowledge/what-is-cca/">دليل CCA</a>، وتصفح الموديلات حسب المعيار في <a href="/ar/data/">قاعدة بيانات الموديلات</a>.</p>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002).</p>
    <p><a href="/ar/data/">تصفح الموديلات حسب المعيار &larr;</a> · <a href="/ar/knowledge/oem-battery-specification-guide/">ابنِ مواصفات نظيفة &larr;</a></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="حدد المعيار الصحيح لسوقك" />
</ArticleLayout>
