const articleTitle = 'ما هي CCA (أمبير التدوير البارد)؟';

const faqs = [
  { q: 'ما الذي ترمز إليه CCA؟', a: 'أمبير التدوير البارد — التيار الذي يمكن للبطارية توفيره لمدة 30 ثانية عند درجة حرارة باردة قبل الانخفاض دون جهد القطع.' },
