---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';
import ModelCard from '../../../../components/ModelCard.astro';
import { STANDARDS, MANUFACTURER } from '../../../../data/site';
import { batteryModels } from '../../../../data/battery-models';

const title = 'دليل مواصفات بطاريات OEM | Dingwei Battery';
const description = 'دليل للمشترين حول مواصفات بطاريات OEM: عائلة المعايير، الجهد، السعة، CCA، الأبعاد، الطرف، القطبية وكيفية تأكيد القيم.';
const articleTitle = 'دليل مواصفات بطاريات OEM';

const faqs = [
  { q: 'ما الخطأ الأكثر شيوعًا في المواصفات؟', a: 'تسعير CCA دون أساس الاختبار. أرقام JIS وEN غير قابلة للمقارنة، لذا فإن المواصفات دون الأساس ليست مواصفات فعلية.' },
  { q: 'هل يمكنني نسخ مواصفات منافس؟', a: 'يمكنك استخدامها كمرجع انطلاق، لكن أكّد كل حقل وفق توافق مركبتك — حجم الهيكل والطرف والقطبية خاصة بكل سوق وحرجة للتوافق.' },
  { q: 'ماذا تعني «يُؤكَّد عند الاستفسار» في ورقة المواصفات؟', a: 'تعني أن القيمة محذوفة عمدًا بدلًا من تقديرها. نوع الطرف والقطبية، على سبيل المثال، يجب تأكيدهما مع مركبتك قبل الطلب.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="الهندسة" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة</span>
    <h1>دليل مواصفات بطاريات OEM</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-01 · المصدر: الوثائق الفنية لشركة Chengguang Power Tech Co., Ltd.</p>
    <p class="lead">مواصفات البطارية لا تكون مفيدة إلا بقدر الحقول التي تثبتها مسبقًا. يشرح هذا الدليل كل حقل يجب على المشترين تأكيده.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> تثبت مواصفات بطارية OEM القابلة للاستخدام عائلة المعايير والجهد والسعة وCCA مع أساس اختبارها والأبعاد ونوع الطرف والقطبية. لا تقارن قيم CCA أبدًا دون ذكر ما إذا كانت JIS (&minus;15&deg;م) أم EN (&minus;18&deg;م).
    </div>

    <h2>عائلة المعايير</h2>
    <p>ابدأ بالمعيار الذي تستخدمه مركباتك: {STANDARDS.join(', ')}. تصف موديلات JIS مثل 65D26 وموديلات DIN/EN مثل H6 اصطلاحات تسمية واختبار مختلفة.</p>

    <h2>الجهد</h2>
    <p>بطاريات تشغيل سيارات الركاب عادة 12 فولت؛ ويمكن لتطبيقات الخدمة الشاقة استخدام 6 فولت أيضًا. أكّد جهد نظام المركبة المستهدفة.</p>

    <h2>السعة (Ah)</h2>
    <p>تصف السعة محتوى الطاقة للبطارية خلال اختبار تفريغ محدد. يجب قراءتها مع المعيار لأن الحجم المادي نفسه قد يحمل تصنيفات مختلفة عبر العائلات.</p>

    <h2>CCA</h2>
    <p>يشير أمبير التدوير البارد إلى أداء التشغيل عند درجة حرارة منخفضة. تعتمد قيم CCA على طريقة الاختبار ويجب أن تحمل أساسًا مرجعيًا — مثل JIS (-15&deg;م) أو EN (-18&deg;م). أكّد دائمًا CCA النهائية مع الشركة المصنعة قبل الطلب.</p>

    <h2>الأبعاد والطرف والقطبية</h2>
    <p>ثبّت الطول &times; العرض &times; الارتفاع بالمليمتر، ونوع الطرف والقطبية. إذا كان حقل غير معروف بعد، علّمه «يُؤكَّد عند الاستفسار» بدلًا من التخمين.</p>

    <h2>الموديلات المرجعية</h2>
    <div class="model-list">
      {batteryModels.map((model) => <ModelCard model={model} />)}
    </div>
    <p>المواصفات أعلاه للمرجعية؛ أكّد القيم النهائية مع الشركة المصنعة. <a href="/ar/tools/battery-finder/">أداة البحث عن البطارية &larr;</a></p>

    <h2>منظور Dingwei Battery</h2>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002). تصنّع {MANUFACTURER.name} وفق معايير JIS وDIN وBCI وAS وSA.</p>
    <p><a href="/ar/oem/">ابدأ برنامج بطاريات OEM &larr;</a></p>

    <h2>CCA: رقمان لبطارية واحدة</h2>
    <p>لا تُقارن قيم أمبير التدوير البارد إلا عند ذكر طريقة الاختبار. يمكن للبطارية نفسها أن تحمل رقم JIS أقل ورقم EN / SAE أعلى لأن كل طريقة تستخدم حالة اختبار مختلفة.</p>
    <table>
      <thead>
        <tr><th>طريقة الاختبار</th><th>درجة الحرارة</th><th>ملاحظة</th></tr>
      </thead>
      <tbody>
        <tr><td>JIS</td><td>&minus;15&deg;م</td><td>رقم أقل؛ شائع في آسيا</td></tr>
        <tr><td>EN / SAE</td><td>&minus;18&deg;م</td><td>رقم أعلى؛ دولي</td></tr>
      </tbody>
    </table>
    <p>هذه غير قابلة للتحويل المباشر. اذكر دائمًا طريقة الاختبار بجانب قيمة CCA عند إصدار RFQ.</p>

    <h2>حقول المواصفات التي تهم فعلًا</h2>
    <ul>
      <li>عائلة المعايير والموديل المرجعي</li>
      <li>الجهد والسعة</li>
      <li>CCA مع أساس اختباره</li>
      <li>حجم الهيكل ونوع الطرف</li>
      <li>القطبية</li>
      <li>متطلبات الملصق والتغليف</li>
    </ul>
    <p>ضع هذه الحقول في <a href="/ar/knowledge/oem-battery-rfq-guide/">دليل RFQ بطاريات OEM</a>، ثم افحص الردود مقابل <a href="/ar/knowledge/oem-battery-supplier-checklist/">قائمة مراجعة المورد</a>.</p>

    <h2>انجراف المواصفات: الخطر الخفي</h2>
    <p>يحدث انجراف المواصفات بهدوء في الطلب المتكرر: تُستبدل العينة المعتمدة بسبيكة شبكة مختلفة، أو وقت معالجة أقصر، أو تغيير طرف غير معتمد. لا يلاحظ المشتري إلا عندما يختبر الحاوية الجديدة بشكل مختلف عن الأولى.</p>
    <p>التحكم الدائم الوحيد هو تثبيت المواصفات المعتمدة واشتراط تحكم رسمي بالتغيير لأي انحراف. وثّق هذا التحكم كتابيًا باستخدام <a href="/ar/knowledge/oem-battery-supplier-checklist/">قائمة مراجعة المورد</a> قبل استئناف الإنتاج.</p>

    <h2>CCA: لماذا تحمل بطارية واحدة رقمين</h2>
    <p>يمكن لبطارية واحدة أن تُظهر قيمتي CCA لأن JIS (&minus;15&deg;م) وEN / SAE (&minus;18&deg;م) طريقتا اختبار مختلفتان، وليستا تصنيفًا «مرتفعًا» و«منخفضًا». إذا لم تذكر RFQ طريقة الاختبار، فقد يبدو موردان يعرضان بطاريات مختلفة بينما يعرضان المنتج نفسه على أساسين مختلفين.</p>
    <p>اذكر الأساس في كل سطر وقارن فقط قيم الطريقة نفسها. اطّلع على كيفية تناسب هذه التعليمات مع الطلب الأوسع في <a href="/ar/knowledge/oem-battery-rfq-guide/">دليل RFQ بطاريات OEM</a>.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>رأي المؤلف</h2>
      <p><strong>الموقف:</strong> في رأيي، مواصفة البطارية لا تفيد إلا بقدر الحقول التي تثبّتها مسبقًا — وقيمة CCA بلا طريقة اختبار هي رقمان يتظاهران بأنهما واحد.</p>
      <p><strong>الأسباب:</strong></p>
      <ul>
        <li>قد تحمل البطارية نفسها رقم JIS أقل ورقم EN/SAE أعلى لأن كل طريقة تستخدم شروطًا مختلفة؛ فالقيَم غير قابلة للتحويل.</li>
        <li>إذا كان الحقل غير معروف، فضع علامة «يُؤكد عند الاستفسار» بدلاً من التخمين — فالقطب الخاطئ يحوّل بطارية صحيحة إلى خاطئة.</li>
        <li>انحراف المواصفة هو الخطر الخفي، والرقابة الوحيدة الدائمة هي مواصفة مقفلة مع ضبط تغيير رسمي مكتوب.</li>
      </ul>
      <p><em>إفصاح: هذا حكم تحريري وتجربة ميدانية للمؤلف، وليس ادعاءً تقنيًا موثّقًا.</em></p>
    </div>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="أكمل مواصفات بطاريتك" />
</ArticleLayout>
