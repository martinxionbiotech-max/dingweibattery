---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';

const title = 'أنواع أطراف البطارية وقطبيتها | Dingwei Battery';
const description = 'أنواع أطراف البطارية ومواضعها وقطبيتها — ولماذا يعني الخطأ فيها أن البطارية لن تتسع في المركبة. دليل للمشترين OEM.';
const articleTitle = 'أنواع أطراف البطارية وقطبيتها';

const faqs = [
  { q: 'ماذا يعني L وR على البطارية؟', a: 'يحددان ما إذا كان الطرف الموجب على يسار الهيكل أم يمينه. يهم الموضع لأن أطوال كابلات المركبة ثابتة.' },
  { q: 'لماذا قطب البطارية مهم؟', a: 'عكس القطبية عند التوصيل قد يغذي التيار عكسيًا عبر النظام الكهربائي للمركبة ويسبب ضررًا حقيقيًا، لذا يجب تأكيد القطبية مقابل الأسلاك قبل التركيب. البطارية الصحيحة بقطبية معكوسة تظل بطارية خاطئة.' },
  { q: 'لماذا تُعلَّم تفاصيل الأطراف «يُؤكَّد عند الاستفسار»؟', a: 'لأن مواصفة طرف خاطئة تحوّل بطارية صحيحة إلى خاطئة. تؤكد الشركة المصنعة تفاصيل الطرف مقابل مركبة المشتري بدلًا من التخمين.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="الهندسة" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة · الهندسة</span>
    <h1>أنواع أطراف البطارية وقطبيتها</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-03 · المصدر: وثائق معايير البطاريات</p>
    <p class="lead">قد تطابق البطارية المعيار الصحيح وحجم الهيكل الصحيح ولا تتسع بعد — لأن نوع الطرف أو الموضع أو القطبية خاطئ. تفاصيل الطرف قرار توافق، لا فكرة متأخرة.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> قد تكون البطارية ذات حجم الهيكل والسعة الصحيحين بطارية خاطئة إذا كان نوع الطرف أو الموضع أو القطبية خاطئًا — فتفاصيل الطرف قرار توافق، لا فكرة متأخرة. يجب تأكيد الثلاثة مقابل المركبة قبل الطلب.
    </div>

    <h2>نوع الطرف</h2>
    <p>تستخدم الأسواق المختلفة تصاميم أقطاب مختلفة. تشمل الأنواع الشائعة للسيارات القطب العلوي المخروطي (معظم سيارات JIS/DIN/BCI)، والطرف الجانبي (بعض تطبيقات GM في أمريكا الشمالية)، وأطراف المسمار/العلَم المستخدمة في بطاريات الخدمة الشاقة والبحرية.</p>
    <p>الطرف الذي لا يطابق مشبك كابل المركبة لن يتصل بأمان — هذه مشكلة توافق مادي، لا مشكلة أداء.</p>

    <h2>موضع الطرف</h2>
    <p>قد يُشحن موديل البطارية نفسه بالقطب الموجب على اليسار أو اليمين. غالبًا ما يشير المصنعون إلى ذلك بلاحقة L أو R (مثلًا D23L مقابل D23R). يهم الموضع لأن أطوال كابلات المركبة ثابتة.</p>

    <h2>القطبية</h2>
    <p>القطبية هي إسناد الموجب والسالب إلى القطبين. قد يؤدي عكس القطبية عند التوصيل إلى إتلاف النظام الكهربائي للمركبة، لذا تُؤكد القطبية مقابل أسلاك المركبة قبل التركيب.</p>

    <h2>لماذا تُؤكد هذه عند الاستفسار</h2>
    <p>في صفحات Dingwei المرجعية، يُعلَّم نوع الطرف والقطبية «يُؤكَّد عند الاستفسار» بدلًا من التخمين. هذا مقصود: فمواصفة طرف خاطئة تحوّل بطارية صحيحة إلى خاطئة. تؤكد الشركة المصنعة تفاصيل الطرف مقابل مركبة المشتري أو متطلبات أسطوله.</p>

    <h2>ما الذي يجب أن يسأله المشترون</h2>
    <ul>
      <li>ما نوع الطرف الذي تستخدمه المركبة — قطب علوي أم طرف جانبي أم مسمار؟</li>
      <li>هل القطب الموجب على اليسار أم اليمين (L/R)؟</li>
      <li>ما القطبية الصحيحة لأسلاك المركبة؟</li>
      <li>هل يحتاج تطبيق الخدمة الشاقة أطرافًا مزدوجة أو علَمية؟</li>
    </ul>

    <p>أكّد الأطراف مع <a href="/ar/knowledge/battery-dimensions-case-size/">الأبعاد وحجم الهيكل</a>، ثم اقفلها في <a href="/ar/knowledge/oem-battery-specification-guide/">مواصفات OEM</a>.</p>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002).</p>
    <p><a href="/ar/contact/">أكّد تفاصيل الأطراف في RFQ الخاصة بك &larr;</a></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="أكّد نوع الطرف والقطبية" />
</ArticleLayout>
