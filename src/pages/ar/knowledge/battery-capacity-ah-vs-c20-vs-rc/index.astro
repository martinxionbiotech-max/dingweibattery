---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';

const title = 'سعة البطارية: Ah مقابل C20 مقابل RC | Dingwei Battery';
const description = 'افهم تصنيفات سعة البطارية — الأمبير-ساعة (Ah)، ومعدل C20 والسعة الاحتياطية (RC) — وكيف تقارنها في مواصفات بطارية OEM.';
const articleTitle = 'سعة البطارية: Ah مقابل C20 مقابل RC';

const faqs = [
  { q: 'ما الفرق بين Ah وC20؟', a: 'Ah هي الشحنة المخزنة الكلية، بينما C20 هو معدل التفريغ على 20 ساعة الذي يُقاس عنده ذلك الـAh. تسلّم البطارية نفسها طاقة كلية أقل عند معدل تفريغ أسرع.' },
  { q: 'ماذا تعني السعة الاحتياطية (RC)؟', a: 'السعة الاحتياطية هي عدد الدقائق التي تستطيع البطارية فيها تسليم حمل ثابت 25 أمبير قبل الانخفاض دون 10.5 فولت — مقياس زمن تشغيل تحت الحمل.' },
  { q: 'هل الـAh الأعلى أفضل دائمًا؟', a: 'ليس دائمًا. يخزن Ah الأعلى طاقة أكثر لكنه يجعل البطارية أكبر وأثقل ماديًا — ويجب أن تتسع في الحاضنة وتطابق نظام شحن المركبة. المبالغة في السعة تعني دفع ثمن طاقة لن تستخدمها أبدًا.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="الهندسة" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة · الهندسة</span>
    <h1>سعة البطارية: Ah مقابل C20 مقابل RC</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-03 · المصدر: معايير اختبار البطاريات</p>
    <p class="lead">تصف ثلاثة أرقام سعة البطارية، وتقيس أشياء مختلفة. الخلط بينها أحد أخطاء التوريد الأكثر شيوعًا.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> يجيب Ah وC20 وRC عن أسئلة مختلفة وليست قابلة للتبادل — الخلط بينها أحد أخطاء التوريد الأكثر شيوعًا. Ah هي الشحنة المخزنة الكلية، وC20 هو معدل التفريغ على 20 ساعة الذي يُقاس عنده الـAh، وRC هو زمن التشغيل بالدقائق تحت حمل ثابت.
    </div>

    <h2>Ah: الشحنة المخزنة الكلية</h2>
    <p>الأمبير-ساعة هي الشحنة الكلية التي يمكن للبطارية تسليمها خلال تفريغ. يمكن لبطارية 60 أمبير-ساعة، من حيث المبدأ، تزويد 1 أمبير لمدة 60 ساعة، أو 6 أمبير لمدة 10 ساعات — ضمن حدود معدل التفريغ المقنن.</p>
    <p>النقطة الأساسية: الـAh يكون ذا معنى فقط عند ربطه بمعدل تفريغ. البطارية المقيّمة «60 أمبير-ساعة» دون معدل غير مكتملة.</p>

    <h2>C20: معدل 20 ساعة</h2>
    <p>C20 (أو معدل 20 ساعة) هو معدل التفريغ القياسي لمعظم بطاريات السيارات: التيار الذي يفرّغ البطارية كليًا على 20 ساعة. البطارية 60 أمبير-ساعة (C20) مقيّمة لتسليم 3 أمبير لمدة 20 ساعة.</p>
    <p>يقلل التفريغ الأسرع السعة الفعلية (تسلّم البطارية طاقة كلية أقل عند معدل تفريغ مرتفع). لهذا تُظهر البطارية نفسها Ah أعلى عند C20 منه عند معدل سريع مثل C5.</p>

    <h2>RC: السعة الاحتياطية</h2>
    <p>تقيس السعة الاحتياطية الدقائق التي تستطيع بطارية مشحونة بالكامل تسليم حمل ثابت 25 أمبير قبل الانخفاض دون 10.5 فولت. تجيب عن سؤال مختلف: كم يمكن للبطارية تشغيل الحمل الكهربائي للمركبة إذا فشل نظام الشحن.</p>
    <p>RC أنفع من Ah للمركبات ذات أحمال الملحقات الثقيلة — إنه مقياس زمن تشغيل تحت الحمل، لا مقياس طاقة كلية.</p>

    <h2>كيف ترتبط — وكيف لا ترتبط</h2>
    <table>
      <thead><tr><th>المقياس</th><th>يقيس</th><th>الوحدة</th><th>يجيب</th></tr></thead>
      <tbody>
        <tr><td>Ah</td><td>الشحنة المخزنة الكلية</td><td>أمبير-ساعة</td><td>كم الطاقة المخزنة؟</td></tr>
        <tr><td>C20</td><td>معدل التفريغ لتصنيف Ah</td><td>معدل 20 ساعة</td><td>بأي معدل يُقاس الـAh؟</td></tr>
        <tr><td>RC</td><td>زمن التشغيل تحت حمل ثابت</td><td>دقائق</td><td>كم المدة تحت الحمل إذا فشل الشحن؟</td></tr>
      </tbody>
    </table>
    <p class="note">لا يعني Ah الأعلى تلقائيًا RC أعلى — تعتمد العلاقة على تصميم البطارية. أكّد كل قيمة على حدة لمواصفاتك.</p>

    <h2>ما الذي يجب أن يسأله المشترون</h2>
    <ul>
      <li>هل تصنيف Ah عند C20 أم معدل آخر؟</li>
      <li>ما السعة الاحتياطية (RC) التي تحملها البطارية؟</li>
      <li>أي قيمة تهم أكثر لتطبيقي — زمن التشغيل (RC) أم الطاقة الكلية (Ah)؟</li>
    </ul>

    <p>استخدم هذا مع <a href="/ar/knowledge/what-is-cca/">دليل CCA</a> — فـCCA قوة تشغيل، وAh/RC سعة، وكلاهما ينتمي إلى <a href="/ar/knowledge/oem-battery-specification-guide/">مواصفات OEM</a>.</p>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002).</p>
    <p><a href="/ar/data/">تصفح مراجع سعة الموديلات &larr;</a></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="أكّد تصنيفات السعة لموديلك" />
</ArticleLayout>
