---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';

const title = 'أبعاد البطارية وحجم الهيكل | Dingwei Battery';
const description = 'كيف تحدد أبعاد البطارية (الطول × العرض × الارتفاع) ومجموعات حجم الهيكل التوافق، وكيف تقرأ مرجع هيكل مثل D26 أو H6 أو المجموعة 34.';
const articleTitle = 'أبعاد البطارية وحجم الهيكل';

const faqs = [
  { q: 'ماذا تعني أبعاد البطارية؟', a: 'الطول × العرض × الارتفاع بالمليمتر — البصمة المادية التي يجب أن تتسع في الحاضنة والمثبّت وخلوص غطاء المحرك. يكفي فرق بضعة مليمترات في الارتفاع أو الطول لمنع البطارية من الجلوس بشكل صحيح.' },
  { q: 'ما حجم الهيكل؟', a: 'اختصار لبصمة ثابتة ضمن عائلة معايير — D26 في JIS، وH6 في DIN/EN، والمجموعة 34 في BCI. يتيح حجم الهيكل لطرفين الإشارة إلى البطارية نفسها دون ذكر ثلاثة أرقام كل مرة.' },
  { q: 'هل تتسع بطاريتان بنفس حجم الهيكل دائمًا؟', a: 'ليس بالضرورة — قد يختلف موضع الطرف (L/R) ونوعه بعد، لذا أكّد أبعاد الهيكل وتوزيع الأطراف معًا.' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="الهندسة" dateModified="2026-09-03" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">المعرفة · الهندسة</span>
    <h1>أبعاد البطارية وحجم الهيكل</h1>
    <p class="byline">نُشر بواسطة Dingwei Battery · آخر مراجعة 2026-09-03 · المصدر: وثائق معايير البطاريات</p>
    <p class="lead">البصمة المادية للبطارية — الطول والعرض والارتفاع — تقرر ما إذا كانت تتسع في الحاضنة والمثبّت وخلوص غطاء المحرك. حجم الهيكل هو اختصار تلك البصمة.</p>

    <div class="takeaways">
      <strong>الإجابة المختصرة:</strong> البطارية الأطول أو الأعلى ببضعة مليمترات لن تتسع في الحاضنة أو تغلق غطاء المحرك — لذا تقرر الأبعاد التوافق قبل أي شيء آخر. حجم الهيكل (D26 في JIS، وH6 في DIN، والمجموعة 34 في BCI) هو اختصار تلك البصمة الثابتة.
    </div>

    <h2>ماذا تعني الأبعاد</h2>
    <p>الطول هو الحافة الطويلة، والعرض الحافة القصيرة، ويقاس الارتفاع إلى أعلى الهيكل (تضيف بعض المعايير «ارتفاعًا كليًا» يشمل الطرف). البطارية الأطول أو الأعلى ببضعة مليمترات لن تتسع في الحاضنة أو تغلق غطاء المحرك.</p>

    <h2>حجم الهيكل كاختصار</h2>
    <p>بدلًا من ذكر ثلاثة أرقام، يستخدم المشترون مرجع الهيكل من عائلة المعايير:</p>
    <table>
      <thead><tr><th>المعيار</th><th>مراجع الهيكل</th><th>أبعاد مثال</th></tr></thead>
      <tbody>
        <tr><td>JIS</td><td>D23، D26، D31، B24</td><td>D26 ≈ 256 × 175 × 220 مم</td></tr>
        <tr><td>DIN / EN</td><td>H5–H8 (LN2–LN5)</td><td>H6/LN3 ≈ 278 × 175 × 190 مم</td></tr>
        <tr><td>BCI</td><td>المجموعة 24، 27، 31، 34، 48، 65</td><td>المجموعة 34 ≈ 260 × 173 × 200 مم</td></tr>
      </tbody>
    </table>
    <p class="note">الأبعاد المثال مراجع نموذجية، لا عالمية — أكّد دائمًا الأبعاد الدقيقة للموديل المحدد.</p>

    <h2>لماذا يجب تأكيد حجم الهيكل والطرف معًا</h2>
    <p>قد تختلف بطاريتان بنفس حجم الهيكل في موضع الطرف (L/R) ونوع الطرف. يُؤكد التوافق بمطابقة أبعاد الهيكل <em>و</em> توزيع الأطراف مع المركبة. اطّلع على <a href="/ar/knowledge/battery-terminal-types-polarity/">دليل الطرف والقطبية</a>.</p>

    <h2>ما الذي يجب أن يسأله المشترون</h2>
    <ul>
      <li>ما الأبعاد الدقيقة (ط × ع × ا) لهذا الموديل؟</li>
      <li>هل الارتفاع إلى أعلى الهيكل، أم الارتفاع الكلي شاملاً الأطراف؟</li>
      <li>هل يطابق حجم الهيكل هذا حاضنة ومثبّت مركبتي المستهدفة؟</li>
      <li>هل موضع الطرف (L/R) متوافق؟</li>
    </ul>

    <p>رشّح الموديلات حسب حجم الهيكل والأبعاد في <a href="/ar/data/">قاعدة بيانات الموديلات</a>، واطّلع على اختلاف المعايير في <a href="/ar/knowledge/jis-vs-din-vs-bci/">JIS مقابل DIN مقابل BCI</a>.</p>
    <p>توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002).</p>
    <p><a href="/ar/data/">تصفح الموديلات بالأبعاد &larr;</a> · <a href="/ar/contact/">أكّد التوافق &larr;</a></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="أكّد الأبعاد وحجم الهيكل" />
</ArticleLayout>
