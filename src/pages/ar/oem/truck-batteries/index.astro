---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER } from '../../../../data/site';

const title = 'بطاريات شاحنات OEM | Dingwei Battery';
const description = 'بطاريات شاحنات OEM من Dingwei Battery، تصنّعها Chengguang Power Tech Co., Ltd.: بطاريات خدمة شاقة 6V و12V للشاحنات والحافلات ومعدات البناء.';

const breadcrumbs = [
  { label: 'OEM', href: '/ar/oem/' },
  { label: 'بطاريات الشاحنات', href: '/ar/oem/truck-batteries/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/ar/` },
      { '@type': 'ListItem', position: 2, name: 'OEM', item: `${SITE.url}/ar/oem/` },
      { '@type': 'ListItem', position: 3, name: 'بطاريات الشاحنات', item: `${SITE.url}/ar/oem/truck-batteries/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">OEM / الشاحنات</span>
    <h1>بطاريات شاحنات OEM</h1>
    <p class="lead">توفر Dingwei Battery برامج بطاريات OEM والعلامة الخاصة المصنّعة من قبل Chengguang Power Tech Co., Ltd. (تأسست عام 2002). بطاريات تشغيل للخدمة الشاقة بجهد 6V و12V للشاحنات والحافلات ومعدات البناء، مورّدة تحت علامتك التجارية.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>برامج بطاريات الشاحنات</h2>
      <div class="grid grid--2">
        <div class="card"><h3>خدمة شاقة 6V و12V</h3><p>بطاريات تشغيل للشاحنات والحافلات وآلات الطرق الوعرة، تغطي معايير JIS وDIN وBCI وSA.</p></div>
        <div class="card"><h3>اتساق الأسطول</h3><p>حجم هيكل ثابت وتوزيع أطراف ووسم ثابت عبر طلبات OEM المتكررة.</p></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>التطبيقات</h2>
    <div class="grid grid--3">
      <div class="card"><h3>الشاحنات نصف المقطورة</h3><p>أنظمة تشغيل 24V باستخدام بطاريتين 12V على التوالي.</p></div>
      <div class="card"><h3>الحافلات</h3><p>تشغيل موثوق ودعم كهربائي لأساطيل الركاب.</p></div>
      <div class="card"><h3>معدات الطرق الوعرة</h3><p>بطاريات تشغيل متينة لآلات البناء والزراعة.</p></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>معايير بطاريات الشاحنات</h2>
      <p>توافقات الشاحنات غير قابلة للتبادل عبر الأسواق. قد يستخدم التطبيق نفسه بطارية JIS من سلسلة N في آسيا، أو مرجع DIN ثقيل في أوروبا، أو مجموعة BCI 31 / 4D / 8D في أمريكا الشمالية. أكّد عائلة المعيار وحجم الهيكل مع متطلبات المركبة أو الأسطول قبل الطلب.</p>
      <ul>
        <li><strong>سلسلة JIS N</strong> — N150 / N200، توافقات الشاحنات الثقيلة الآسيوية.</li>
        <li><strong>DIN الثقيل</strong> — DIN88 / DIN100، التوافقات التجارية الأوروبية.</li>
        <li><strong>مجموعة BCI 31 / 4D / 8D</strong> — توافقات الخدمة الشاقة في أمريكا الشمالية.</li>
      </ul>
    </div>
  </section>

  <section class="section container prose">
    <h2>ما الذي يجب تحديده لبطارية الشاحنة</h2>
    <ul>
      <li>عائلة المعيار وحجم الهيكل (JIS / DIN / BCI / SA).</li>
      <li>الجهد (12V قياسي؛ تتوفر تكوينات 6V و24V على التوالي).</li>
      <li>السعة، عادة في نطاق 100–225 Ah لاستخدام الخدمة الشاقة.</li>
      <li>CCA — تحتاج محركات الديزل الكبيرة إلى أمبير تشغيل بارد عالٍ؛ أكّد أساس الاختبار (مرجعي) مع الشركة المصنعة.</li>
      <li>نوع الطرف وموضعه بما يناسب تمديد الكابلات لديك.</li>
    </ul>
    <p><a href="/ar/knowledge/oem-battery-specification-guide/">اقرأ دليل مواصفات بطاريات OEM &larr;</a></p>
  </section>

  <section class="section container">
    <h2>التصنيع والتصدير</h2>
    <p class="lead">تصنّعها {MANUFACTURER.name} (تأسست عام {MANUFACTURER.founded}) في منشأة بمساحة {MANUFACTURER.factoryArea} في {MANUFACTURER.address}، مع {MANUFACTURER.productionLines} وتصدير إلى {MANUFACTURER.exportMarkets}.</p>
    <p><a href="/ar/factory/">عرض نظرة عامة على المصنع &larr;</a> · <a href="/ar/heavy-duty-batteries/">تفاصيل بطاريات الخدمة الشاقة &larr;</a></p>
  </section>

  <CTASection title="اطلب عرض سعر لبطاريات شاحنات OEM" />
</BaseLayout>
