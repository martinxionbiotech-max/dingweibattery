---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsBar from '../../components/StatsBar.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER, CERTIFICATIONS, STANDARDS, RELATIONSHIP } from '../../data/site';

const title = 'Battery Factory & Manufacturing | Dingwei Battery';
const description = 'Dingwei Battery programs are manufactured by Chengguang Power Tech Co., Ltd. (founded 2002), a 200,000 m² battery plant in Jinzhou, Hebei, China with 18 production lines.';

const breadcrumbs = [{ label: 'Factory', href: '/factory/' }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: MANUFACTURER.name,
    legalName: MANUFACTURER.legalName,
    foundingDate: String(MANUFACTURER.founded),
    address: { '@type': 'PostalAddress', addressLocality: 'Jinzhou', addressRegion: 'Hebei', addressCountry: 'CN' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Factory', item: `${SITE.url}/factory/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Manufacturing</span>
    <h1>Battery factory &amp; manufacturing</h1>
    <p class="lead">{RELATIONSHIP} Manufacturing is performed by {MANUFACTURER.name} at its facility in {MANUFACTURER.address}.</p>
  </section>

  <StatsBar />

  <section class="section container">
    <h2>Factory floor</h2>
    <p class="lead">Inside the {MANUFACTURER.name} lead-acid battery plant in {MANUFACTURER.address}.</p>
    <div class="gallery gallery--uniform">
      <figure class="gallery__item">
        <img src="/images/factory/factory-05.webp" alt="Battery production line at the Chengguang Power Tech Co., Ltd. facility" width="1530" height="641" loading="lazy" decoding="async" />
      </figure>
      <figure class="gallery__item">
        <img src="/images/factory/factory-18.webp" alt="Battery production equipment at the Chengguang Power Tech Co., Ltd. facility" width="1517" height="633" loading="lazy" decoding="async" />
      </figure>
      <figure class="gallery__item">
        <img src="/images/factory/factory-23.webp" alt="Battery manufacturing process at the Chengguang Power Tech Co., Ltd. facility" width="1514" height="633" loading="lazy" decoding="async" />
      </figure>
      <figure class="gallery__item">
        <img src="/images/factory/factory-24.webp" alt="Battery production line at the Chengguang Power Tech Co., Ltd. facility" width="1515" height="632" loading="lazy" decoding="async" />
      </figure>
      <figure class="gallery__item">
        <img src="/images/factory/factory-25.webp" alt="Battery factory floor at the Chengguang Power Tech Co., Ltd. facility" width="1526" height="793" loading="lazy" decoding="async" />
      </figure>
      <figure class="gallery__item">
        <img src="/images/factory/factory-26.webp" alt="Battery manufacturing equipment at the Chengguang Power Tech Co., Ltd. facility" width="1530" height="645" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Manufacturer profile</h2>
      <div class="grid grid--2">
        <div class="card"><h3>Company</h3><p>{MANUFACTURER.legalName} ({MANUFACTURER.shortName})</p></div>
        <div class="card"><h3>Founded</h3><p>{MANUFACTURER.founded}</p></div>
        <div class="card"><h3>Location</h3><p>{MANUFACTURER.address}</p></div>
        <div class="card"><h3>Facility</h3><p>{MANUFACTURER.factoryArea}, {MANUFACTURER.productionLines}</p></div>
        <div class="card"><h3>Daily output</h3><p>{MANUFACTURER.dailyOutput}</p></div>
        <div class="card"><h3>Annual capacity</h3><p>{MANUFACTURER.annualCapacity}</p></div>
        <div class="card"><h3>Export markets</h3><p>{MANUFACTURER.exportMarkets}, via {MANUFACTURER.exportPorts}</p></div>
      </div>
    </div>
  </section>

  <section class="section container prose">
    <h2>The manufacturing process: ten stages — and what each controls</h2>
    <p class="lead">A buyer who understands these ten stages can audit a factory properly — each stage is a quality checkpoint, and each checkpoint controls a specific output.</p>
    <ol>
      <li><strong>Grid casting</strong> — lead alloy grid; maintenance-free batteries use lead-calcium. <em>Controlled: grid thickness, alloy composition and weight</em> — they set mechanical strength and conductivity.</li>
      <li><strong>Paste mixing</strong> — paste consistency determines capacity. <em>Controlled: paste density and acid-to-oxide ratio</em> — they set capacity and cycle life.</li>
      <li><strong>Pasting</strong> — even paste application on the grid. <em>Controlled: paste weight and distribution</em> — uneven paste is the root of capacity variation.</li>
      <li><strong>Curing</strong> — 2–4 days of crystallisation that determines mechanical strength. <em>Controlled: temperature and humidity over the curing window</em> — they set plate strength and porosity.</li>
      <li><strong>Assembly</strong> — plates and separators into the case. <em>Controlled: plate count, alignment and compression</em> — they set internal resistance and therefore CCA.</li>
      <li><strong>Welding</strong> — lug and terminal welding. <em>Controlled: weld integrity</em> — a poor weld adds resistance and heat under load.</li>
      <li><strong>Electrolyte filling</strong> — acid fill. <em>Controlled: acid density and fill level</em> — they set both capacity and cold-cranking performance.</li>
      <li><strong>Formation charging</strong> — activates the active material. <em>Controlled: charge profile and duration</em> — under-formation leaves capacity on the table.</li>
      <li><strong>Sealing &amp; finishing</strong> — lid sealing. <em>Controlled: seal integrity</em> — the leak-prevention checkpoint.</li>
      <li><strong>Testing &amp; packaging</strong> — 100% electrical performance testing. <em>Controlled: CCA, capacity, voltage and leak</em> — every battery is tested before packing.</li>
    </ol>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Quality control — what is verified</h2>
      <table>
        <thead><tr><th>Control</th><th>What it verifies</th><th>Record</th></tr></thead>
        <tbody>
          <tr><td>100% end-of-line electrical test</td><td>CCA, capacity, voltage and leak on every unit</td><td>Batch test record</td></tr>
          <tr><td>Batch traceability</td><td>Raw material to finished battery</td><td>Lot number</td></tr>
          <tr><td>Random sampling inspection</td><td>Dimensions, appearance and performance against spec</td><td>Inspection record</td></tr>
          <tr><td>IATF 16949 quality system</td><td>Process control and corrective action</td><td>Certificate + audit record</td></tr>
        </tbody>
      </table>
      <p class="note">Specific acceptance limits (for example CCA tolerance or capacity tolerance) are defined per product specification. Request the batch certificate of analysis (CoA) for the lot you are buying.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Capacity</h2>
    <p>{MANUFACTURER.factoryArea} facility, {MANUFACTURER.productionLines}, {MANUFACTURER.dailyOutput}.</p>
    <p><a href="/oem/">See OEM capability &rarr;</a></p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Export capability</h2>
      <p>Export to {MANUFACTURER.exportMarkets} from {MANUFACTURER.exportPorts}, with full export documentation including certificate of analysis, packing list, bill of lading, certificate of origin and test reports.</p>
    </div>
  </section>

  <section class="section container">
    <h2>Certifications</h2>
    <p class="lead">Certifications held by {MANUFACTURER.name}:</p>
    <ul>
      {CERTIFICATIONS.map((cert) => <li>{cert}</li>)}
    </ul>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Standards manufactured</h2>
      <p class="lead">Battery platforms are supplied to these standard families: {STANDARDS.join(', ')}.</p>
      <p><a href="/oem/">See OEM capability &rarr;</a> · <a href="/knowledge/oem-battery-supplier-checklist/">What to check in a supplier &rarr;</a></p>
    </div>
  </section>

  <CTASection title="Evaluate our manufacturing capability" />
</BaseLayout>
