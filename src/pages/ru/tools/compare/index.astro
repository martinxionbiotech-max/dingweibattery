---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE } from '../../../../data/site';
import { batteryModels, modelPath } from '../../../../data/battery-models';

const title = 'Сравнить модели аккумуляторов | Dingwei Battery';
const description = 'Сравните две модели аккумуляторов бок о бок — напряжение, ёмкость, CCA, размеры, размер корпуса и применение — из справочной базы данных Dingwei Battery.';

const breadcrumbs = [{ label: 'Сравнение', href: '/ru/tools/compare/' }];

const modelsJson = JSON.stringify(
  batteryModels.map((m) => ({
    model: m.model,
    standard: m.standard,
    standard_code: m.standard_code,
    voltage: m.voltage,
    capacity: m.capacity_ah,
    c20: m.c20_ah,
    cca: m.cca.value,
    cca_basis: m.cca.basis,
    rc: m.rc_min,
    dims: `${m.dimensions_mm.length} × ${m.dimensions_mm.width} × ${m.dimensions_mm.height}`,
    case_size: m.case_size,
    weight: m.weight_kg,
    technology: m.technology,
    application: m.application,
    aliases: m.aliases ?? [],
    href: '/ru' + modelPath(m.model),
  })),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/ru/` },
      { '@type': 'ListItem', position: 2, name: 'Сравнение', item: `${SITE.url}/ru/tools/compare/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Инструмент</span>
    <h1>Сравнить модели аккумуляторов</h1>
    <p class="lead">Выберите две модели, чтобы сравнить их спецификации бок о бок. CCA зависит от метода испытания, поэтому сравнивайте в пределах одного семейства стандартов, где это возможно.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="finder-filters">
        <div class="field">
          <label for="c-a">Модель A</label>
          <select id="c-a"></select>
        </div>
        <div class="field">
          <label for="c-b">Модель B</label>
          <select id="c-b"></select>
        </div>
      </div>
      <div id="compare-output" aria-live="polite"></div>
    </div>
  </section>

  <section class="section container prose">
    <h2>Как читать сравнение</h2>
    <p>Физические размеры и размер корпуса определяют установку; ёмкость и CCA определяют электрическую производительность. Больший номер корпуса в одном семействе стандартов обычно означает больший аккумулятор, но тип клеммы и полярность всё равно нужно подтверждать отдельно.</p>
    <p><a href="/ru/data/">Просмотреть полную базу моделей &rarr;</a> · <a href="/ru/knowledge/oem-battery-specification-guide/">Прочитать руководство по спецификации &rarr;</a></p>
  </section>

  <CTASection title="Подтвердите спецификацию у производителя" />

  <script type="application/json" id="compare-data" set:html={modelsJson}></script>
  <script is:inline>
    const MODELS = JSON.parse(document.getElementById('compare-data').textContent);
    const selA = document.getElementById('c-a');
    const selB = document.getElementById('c-b');
    const out = document.getElementById('compare-output');

    const opts = MODELS.map((m) => `<option value="${m.model}">${m.model} (${m.standard}, ${m.capacity}Ah)</option>`).join('');
    selA.innerHTML = opts;
    selB.innerHTML = opts;
    selA.value = MODELS[0].model;
    selB.value = MODELS[1].model;

    function field(label, a, b) {
      const same = a === b;
      return `<tr><th>${label}</th><td${same ? '' : ' class="diff"'}>${a}</td><td${same ? '' : ' class="diff"'}>${b}</td></tr>`;
    }

    function render() {
      const a = MODELS.find((m) => m.model === selA.value);
      const b = MODELS.find((m) => m.model === selB.value);
      if (!a || !b) return;

      const aliases = (m) => (m.aliases.length ? m.aliases.join(', ') : '—');

      out.innerHTML = `
        <table class="data-table compare-table">
          <thead><tr><th>Поле</th><th>${a.model}</th><th>${b.model}</th></tr></thead>
          <tbody>
            ${field('Стандарт', a.standard + ' (' + a.standard_code + ')', b.standard + ' (' + b.standard_code + ')')}
            ${field('Напряжение', a.voltage + ' V', b.voltage + ' V')}
            ${field('Ёмкость (C20)', a.capacity + ' Ah', b.capacity + ' Ah')}
            ${field('CCA (справочно)', a.cca + ' CCA', b.cca + ' CCA')}
            ${field('Основа CCA', a.cca_basis, b.cca_basis)}
            ${field('Резервная ёмкость', a.rc !== null ? a.rc + ' min' : 'Уточняется по запросу', b.rc !== null ? b.rc + ' min' : 'Уточняется по запросу')}
            ${field('Размеры (мм)', a.dims, b.dims)}
            ${field('Размер корпуса', a.case_size, b.case_size)}
            ${field('Вес', a.weight + ' kg', b.weight + ' kg')}
            ${field('Технология', a.technology, b.technology)}
            ${field('Применение', a.application, b.application)}
            ${field('Псевдонимы', aliases(a), aliases(b))}
          </tbody>
        </table>
        <p class="note">CCA зависит от метода испытания (JIS −15°C vs EN/SAE −18°C). Выделенные ячейки показывают, где две модели различаются. Подтвердите все значения у производителя.</p>
        <p style="margin-top:0.8rem"><a href="${a.href}">Смотреть ${a.model} &rarr;</a> · <a href="${b.href}">Смотреть ${b.model} &rarr;</a> · <a href="/ru/contact/">Запросить расчёт &rarr;</a></p>
      `;
    }

    selA.addEventListener('change', render);
    selB.addEventListener('change', render);
    render();
  </script>
</BaseLayout>
