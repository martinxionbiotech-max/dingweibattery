---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import ModelCard from '../../../../components/ModelCard.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import DirectAnswer from '../../../../components/DirectAnswer.astro';
import { SITE, MANUFACTURER, RELATIONSHIP } from '../../../../data/site';
import { batteryModels } from '../../../../data/battery-models';

const title = 'Аккумуляторы для тяжёлых грузовиков и автобусов | Dingwei Battery';
const description = 'Стартерные аккумуляторы тяжёлого режима для грузовиков, седельных тягачей, автобусов и междугородних автобусов — системы 24 В, дизельный пуск с высоким CCA и виброустойчивая конструкция. OEM-поставка от Chengguang Power Tech Co., Ltd.';

const breadcrumbs = [{ label: 'Тяжёлые грузовики и автобусы' }];

const models = batteryModels.filter((m) => ['N150', 'N200'].includes(m.model));

const faqs = [
  {
    q: 'Какой аккумулятор используется в тяжёлом грузовике или автобусе?',
    a: 'Тяжёлые грузовики и автобусы обычно работают на системе 24 В, построенной из двух аккумуляторов тяжёлого режима 12 В последовательно, с высоким CCA для пуска большого дизеля. Группа следует за происхождением и установкой машины — серия JIS N (N150/N200) на азиатском коммерческом транспорте, тяжёлый DIN или BCI на европейском и североамериканском оборудовании — всегда с соответствием лотку, раскладке клемм и спецификации CCA.',
  },
  {
    q: 'Почему тяжёлые грузовики работают на 24 В, а не на 12 В?',
    a: 'Удвоение напряжения до 24 В даёт ту же пусковую мощность при вдвое меньшем токе, что означает более тонкие кабели и меньшее падение напряжения на длинном шасси. Система грузовика 24 В обычно строится из двух аккумуляторов 12 В последовательно и должна заменяться парой — одна модель, возраст и номинал.',
  },
  {
    q: 'Сколько CCA нужно тяжёлому грузовику?',
    a: 'Большие дизельные двигатели имеют высокую компрессию и нуждаются в сильном пусковом токе, особенно в холодную погоду. Справочные значения тяжёлого режима находятся в порядке 740–1100 CCA в зависимости от двигателя и климата, но CCA зависит от метода испытаний (JIS, EN или SAE). Точное значение зависит от конфигурации автомобиля и должно подтверждаться по спецификации OE.',
  },
  {
    q: 'Нужно ли заменять аккумуляторы тяжёлого грузовика парами?',
    a: 'Да. Система 24 В использует два аккумулятора 12 В последовательно, и новый аккумулятор в паре с изношенным тянет оба вниз. Заменяйте пару вместе — одна модель, один возраст и один номинал — и одновременно подтверждайте крепления и чистоту клемм.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE.url}/ru/` },
      { '@type': 'ListItem', position: 2, name: 'Тяжёлые грузовики и автобусы', item: `${SITE.url}/ru/applications/heavy-truck-bus/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} hreflangLocales={['en', 'es', 'ar', 'ru', 'zh']}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Применения</span>
    <h1>Аккумуляторы для тяжёлых грузовиков и автобусов</h1>
    <p class="lead">{RELATIONSHIP} Стартерные аккумуляторы тяжёлого режима для грузовиков, седельных тягачей, автобусов и междугородних автобусов — где дизельный пуск с высоким CCA, системы 24 В и постоянная вибрация ставят нагрузку намного выше легкового автомобиля.</p>
    <DirectAnswer label="Прямой ответ">Тяжёлым грузовикам, седельным тягачам, автобусам и междугородним автобусам нужен стартерный аккумулятор тяжёлого режима, который отдаёт высокий ток холодной прокрутки дизельному двигателю и выдерживает постоянную вибрацию на дороге. Большинство работает на системе 24 В, построенной из двух аккумуляторов 12 В последовательно, а размер группы следует за автомобилем — серия JIS N (N150/N200) на азиатском коммерческом транспорте, тяжёлый DIN или BCI на европейском и североамериканском оборудовании. Точная спецификация зависит от конфигурации автомобиля, поэтому группу, напряжение, основу CCA и раскладку клемм нужно подтверждать по парку перед заказом.</DirectAnswer>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Обзор применения</h2>
      <p>Это применение охватывает сегмент коммерческого дорожного транспорта: магистральные седельные тягачи, жёсткие грузовики, городские и междугородние автобусы. Общая черта — большой дизельный двигатель, электрическая система 24 В и рабочая жизнь из вибрации, горячего холостого хода и холодных утренних пусков — цикл, который разрушает лёгкий автомобильный аккумулятор за месяцы.</p>
      <p>Группа аккумулятора следует за происхождением и установкой автомобиля, а не за каким-то универсальным правилом. Азиатский коммерческий транспорт обычно привязан к серии JIS N (N150, N200); европейское оборудование опирается на тяжёлые корпуса DIN; североамериканские парки используют группы BCI. Размер корпуса, раскладка клемм и полярность различаются между этими семействами и не взаимозаменяемы даже при схожем номинале Ah.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Рабочий цикл</h2>
    <p>Аккумулятор тяжёлого грузовика или автобуса сталкивается с тремя различными нагрузками:</p>
    <ul>
      <li><strong>Нагрузка пуска дизеля.</strong> Большой дизельный двигатель имеет высокую компрессию и нуждается в сильном пусковом токе, особенно в холод. Это определяющее ограничение для CCA, а не для ёмкости.</li>
      <li><strong>Высокая частота пусков.</strong> Городской автобус может запускаться и останавливаться десятки раз в день, циклируя аккумулятор гораздо чаще, чем личный автомобиль. Магистральные грузовики запускаются реже, но проводят холодные ночи между рейсами.</li>
      <li><strong>Длительные периоды низкой нагрузки.</strong> На холостом ходу или стоянке аккумулятор всё ещё питает «гостиничные» нагрузки — свет, отопление, холодильник и телематику — при этом генератор часто не восстанавливает расход полностью. Это благоприятствует аккумулятору с резервной ёмкостью, а не только пиковым CCA.</li>
    </ul>
    <p class="note">Точный баланс между пусковой нагрузкой и гостиничной нагрузкой зависит от конфигурации автомобиля — профиля маршрута, климата и нагрузки аксессуаров — поэтому единый «универсальный» номинал не имеет смысла.</p>
  </section>

  <section class="section container prose">
    <h2>Пусковая нагрузка: система 24 В</h2>
    <p>Тяжёлые грузовики и автобусы обычно работают на электрической системе 24 В, построенной из двух аккумуляторов 12 В, соединённых последовательно. Удвоение напряжения даёт ту же пусковую мощность при вдвое меньшем токе, что уменьшает размер кабеля и падение напряжения на длинном шасси — по той же причине система существует на строительной технике и крупной сельхозтехнике.</p>
    <p>Практическое следствие — пару нужно рассматривать как единое целое. Новый аккумулятор в паре с изношенным опускается до уровня слабого, поэтому пара заменяется вместе — одна модель, один возраст и один номинал. Подтвердите проводку (последовательно для 24 В, не параллельно) и раскладку клемм перед установкой.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Окружающая среда</h2>
      <ul>
        <li><strong>Вибрация.</strong> Дорожные удары и неровные поверхности утомляют пластины и ослабляют клеммы и крепления. Конструкция тяжёлого режима — более толстые пластины, более жёсткий корпус и более прочные внутренние сварные соединения — это структурное отличие, а не просто большее число CCA.</li>
        <li><strong>Пыль и дорожное загрязнение.</strong> Пыль, соляной туман и влага ускоряют коррозию клемм и могут замкнуть открытые клеммы. Герметичный необслуживаемый корпус и регулярная очистка клемм снижают риск.</li>
        <li><strong>Температура.</strong> Холод повышает пусковую нагрузку (CCA важнее всего зимой), а жара в моторном отсеке — долгосрочный убийца, ведущий к потере воды и коррозии пластин. Аккумулятор подбирается на самое холодное утро и строится на самый жаркий день.</li>
      </ul>
    </div>
  </section>

  <section class="section container prose">
    <h2>Требования к аккумулятору</h2>
    <p>Аккумулятор тяжёлого грузовика или автобуса задаётся короткой цепочкой решений:</p>
    <ol>
      <li><strong>Сначала группа и семейство стандартов.</strong> Серии JIS N, тяжёлый DIN и группы BCI не взаимозаменяемы — подтвердите размеры лотка и раскладку клемм прежде всего остального.</li>
      <li><strong>Напряжение.</strong> 24 В (два по 12 В последовательно) — норма для грузовиков и автобусов; подтвердите систему перед спецификацией.</li>
      <li><strong>CCA с основой испытания.</strong> Пусковая цифра имеет смысл только относительно заявленного стандарта (JIS, EN или SAE). Точное значение зависит от двигателя и климата.</li>
      <li><strong>Ёмкость и резерв.</strong> Ёмкость (Ah при C20) и резервная ёмкость поддерживают гостиничные нагрузки и холостой ход; баланс зависит от профиля аксессуаров автомобиля.</li>
    </ol>
    <p class="note">Не существует универсального значения CCA или ёмкости для всех тяжёлых грузовиков и автобусов — правильная цифра зависит от конфигурации и должна подтверждаться по спецификации OE и производителю.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">Справочные модели</span>
      <h2>Связанные аккумуляторы DINGWEY</h2>
      <p class="lead">Два справочных номера тяжёлого режима серии JIS N из текущего набора моделей, сопоставленные с применением тяжёлых грузовиков и автобусов. Спецификации — справочные значения; подтвердите итоговые цифры у производителя.</p>
      <div class="model-list">
        {models.map((model) => <ModelCard model={model} />)}
      </div>
      <p class="lead">Оба справочных номера относятся к семейству серии JIS N, используемому на азиатском коммерческом транспорте. См. полный ассортимент в <a href="/ru/heavy-duty-batteries/">категории аккумуляторов тяжёлого режима</a>.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Связанные сущности</h2>
    <ul>
      <li><a href="/ru/knowledge/jis-vs-din-vs-bci/">Стандарты аккумуляторов JIS против DIN против BCI</a> — поймите, почему семейство стандартов, а не только Ah, определяет установку.</li>
      <li><a href="/ru/tools/battery-finder/">Инструмент подбора аккумулятора</a> — сузьте модель по напряжению, группе и применению.</li>
      <li><a href="/ru/tools/compare/">Сравнить две модели</a> — спецификации рядом для короткого списка.</li>
      <li><a href="/ru/knowledge/battery-applications-by-vehicle/">Применения аккумуляторов по типу автомобиля</a> — как нагрузка грузовика и автобуса отличается от легковой и строительной.</li>
      <li><a href="/ru/data/">Справочник данных моделей</a> — полный набор моделей с основой CCA и статусом проверки.</li>
    </ul>
  </section>

  <section class="section container prose">
    <h2>Часто задаваемые вопросы</h2>
    {faqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
    <p><a href="/ru/knowledge/oem-battery-specification-guide/">Используйте руководство по спецификации OEM-аккумулятора &rarr;</a></p>
  </section>

  <CTASection title="Запросить расчёт на аккумулятор для тяжёлых грузовиков и автобусов" />
</BaseLayout>
