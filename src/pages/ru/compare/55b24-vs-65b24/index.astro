---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE, BRAND, PUBLISHED_DATE } from '../../../../data/site';
import { findModel } from '../../../../data/battery-models';

const m55 = findModel('55B24');
const m65 = findModel('65B24');

const title = 'Аккумулятор 55B24 vs 65B24: один корпус B24, незначительная разница | Dingwei Battery';
const description = '55B24 (48 Ач) и 65B24 (50 Ач) делят корпус JIS B24 и одинаковые 370 CCA. Узнайте, почему разрыв меньше, чем подсказывает код.';
const articleTitle = 'Аккумулятор 55B24 vs 65B24: один корпус B24, незначительная разница';

const breadcrumbs = [
  { label: 'Сравнение', href: '/ru/compare/' },
  { label: '55B24 vs 65B24' },
];

const faqs = [
  { q: '65B24 больше, чем 55B24?', a: 'Нет. Оба используют корпус JIS B24 (примерно 238 × 129 × 220 мм; кросс-ссылка BCI указывает 238 × 129 × 227 мм). 65B24 — это незначительный шаг ёмкости, а не другой размер.' },
  { q: 'Можно ли поменять 55B24 и 65B24 местами?', a: 'Физически да — они делят одну нишу B24 и одну зону клемм. Электрическая разница всего около 2 Ач, поэтому они почти взаимозаменяемы; подтвердите тип клемм и полярность.' },
  { q: 'Почему 55B24 и 65B24 обе показывают 370 CCA?', a: 'Потому что шаг ёмкости слишком мал, чтобы изменить класс холодного пуска в большинстве справочных данных. На практике CCA различается между производителями гораздо больше, чем между этими двумя кодами.' },
  { q: 'Означает ли «65» в 65B24 65 Ач?', a: 'Нет. В кодировке JIS ведущее число — это индикатор класса производительности, а не Ач. 65B24 обычно около 48–52 Ач в зависимости от завода, а не 65 Ач.' },
];

const url = `${SITE.url}/ru/compare/55b24-vs-65b24/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleTitle,
    description,
    author: { '@type': 'Organization', name: BRAND },
    publisher: { '@type': 'Organization', name: BRAND, url: SITE.url },
    datePublished: PUBLISHED_DATE,
    dateModified: '2026-09-09',
    image: `${SITE.url}/images/factory/factory-19.webp`,
    mainEntityOfPage: url,
    articleSection: 'Сравнение',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Сравнение', item: `${SITE.url}/ru/compare/` },
      { '@type': 'ListItem', position: 3, name: '55B24 vs 65B24', item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} ogType="article">
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container prose">
    <span class="tag">Сравнение · JIS</span>
    <h1>Аккумулятор 55B24 vs 65B24: один корпус B24, незначительная разница</h1>
    <p class="byline">Опубликовано Dingwei Battery · Последняя проверка 2026-09-09 · Только справочные значения</p>
    <p class="lead">55B24 и 65B24 имеют один и тот же физический корпус — узкий корпус JIS B24, используемый в азиатских компактах и вспомогательных позициях гибридов. В отличие от пар D26 или D31, разрыв здесь действительно мал: 65B24 — это незначительный шаг ёмкости, а не ощутимый апгрейд мощности.</p>

    <div class="takeaways">
      <strong>Краткий ответ:</strong> Это две соседние ступени одного корпуса B24 с почти идентичными электрическими параметрами (48 против 50 Ач, обе 370 CCA справочно). Они фактически взаимозаменяемы в одной нише. Реальное решение — цена и наличие, а не производительность.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Ключевые характеристики (справочно)</h2>
      <table class="data-table">
        <thead>
          <tr><th>Поле</th><th>55B24</th><th>65B24</th></tr>
        </thead>
        <tbody>
          <tr><th>Стандарт</th><td>JIS (JIS D 5301)</td><td>JIS (JIS D 5301)</td></tr>
          <tr><th>Напряжение</th><td>{m55?.voltage} В</td><td>{m65?.voltage} В</td></tr>
          <tr><th>Ёмкость (справочно)</th><td>{m55?.capacity_ah} Ач</td><td>{m65?.capacity_ah} Ач</td></tr>
          <tr><th>CCA (справочно, JIS &minus;15&deg;C)</th><td>{m55?.cca.value}</td><td>{m65?.cca.value}</td></tr>
          <tr><th>Размер корпуса</th><td>{m55?.case_size}</td><td>{m65?.case_size}</td></tr>
          <tr><th>Габариты (мм)</th><td>{m55?.dimensions_mm.length} × {m55?.dimensions_mm.width} × {m55?.dimensions_mm.height}</td><td>{m65?.dimensions_mm.length} × {m65?.dimensions_mm.width} × {m65?.dimensions_mm.height}</td></tr>
          <tr><th>Типовое применение</th><td>{m55?.application}</td><td>{m65?.application}</td></tr>
          <tr><th>OEM / частная марка</th><td>Доступно</td><td>Доступно</td></tr>
        </tbody>
      </table>
      <p class="note">Значения справочные из базы моделей Dingwei. Окончательные характеристики — включая базис CCA, тип клемм и полярность — подтверждайте у производителя перед заказом.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Что на самом деле означает код модели</h2>
    <p>Код JIS раскладывается как <code>[класс производительности][класс корпуса][длина]</code>:</p>
    <ul>
      <li><strong>55 / 65</strong> — <em>класс производительности</em>. Вот ключевой момент: <strong>это число — не ёмкость в Ач.</strong> 65B24 — это не батарея 65 Ач; реальная ёмкость C20 обычно около 48–52 Ач в зависимости от завода.</li>
      <li><strong>B</strong> — <em>класс размера корпуса</em>. &ldquo;B&rdquo; — узкий высокий корпус (шириной 129 мм) для малых азиатских автомобилей.</li>
      <li><strong>24</strong> — <em>длина</em> в сантиметрах, примерно 238 мм.</li>
    </ul>
    <p>Корпус B24 — это «малый азиатский» форм-фактор (кросс-ссылка BCI Group 51 и семейство NS60 / N40). Это компактный аналог более широкой серии D: та же высота, но всего ~129 мм ширины против ~173 мм. Именно узкая ширина ограничивает площадь пластин, поэтому B24 достигают около 50 Ач, тогда как D26 достигают 72–84 Ач.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Разрыв меньше, чем подсказывает код</h2>
      <p>В справочных данных Dingwei разница между двумя кодами — <strong>2 Ач и 0 CCA</strong>. Это не опечатка — так распределяются классы производительности JIS в этом малом корпусе.</p>
      <p>Чтобы оценить эти 2 Ач в контексте: <strong>разброс CCA <em>между производителями</em> для одного и того же кода 55B24 гораздо больше, чем разница между 55B24 и 65B24 внутри одного завода.</strong> Опубликованные значения 55B24 идут от ~330 до 570 А по брендам, а ёмкость от ~45 до 48 Ач. 55B24 «высокой ступени» с одного завода может превзойти 65B24 «низкой ступени» с другого.</p>
      <p>Практическое правило: <strong>внутри одного производителя 65B24 — это незначительный апгрейд пластин над 55B24. Между производителями код говорит очень мало.</strong> Покупайте по фактической спецификации завода, а не по двухзначному префиксу.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Взаимозаменяемы ли они?</h2>
    <p><strong>Да, на практике.</strong> Оба занимают одну нишу B24 и одно крепление, а электрическая разница достаточно мала, чтобы они вели себя почти одинаково в компактных и вспомогательно-гибридных применениях, которые обслуживает этот корпус.</p>
    <ol>
      <li><strong>Тип клемм и полярность.</strong> Аккумуляторы B24 используют узкий тип клемм JIS и бывают в вариантах «лево/право». Это единственное, что должно совпадать точно.</li>
      <li><strong>Применение.</strong> Корпус B24 распространён в азиатских компактах (семейство NS60 / N40) и всё чаще как вспомогательная батарея в гибридах, где правильный тип и вентиляция важнее разницы в 2 Ач.</li>
      <li><strong>Цена.</strong> Поскольку разрыв в производительности незначителен, решение о покупке обычно исходит из цены, наличия и ступени завода, а не из того, какой код «лучше».</li>
    </ol>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Какую выбрать?</h2>
      <table class="data-table">
        <thead><tr><th>Выбирайте…</th><th>Когда…</th></tr></thead>
        <tbody>
          <tr><td><strong>55B24</strong></td><td>Бюджетные программы замены, стандартные азиатские компакты или где ступень 48 Ач — устоявшаяся база и решает цена.</td></tr>
          <tr><td><strong>65B24</strong></td><td>Где спецификация автомобиля или каталог покупателя требуют более высокого кода, или где небольшой прирост резерва стоит малой наценки.</td></tr>
        </tbody>
      </table>
      <p>Для импортёра честная рамка такова: <strong>эти два кода — почти дубликаты в одном корпусе.</strong> Многие программы держат один и относятся к другому как к кросс-ссылке. Реальное решение о марже — какую ступень производительности брендировать как стандарт против эконом, — диктуется фактическими Ач/CCA завода, а не двухзначным префиксом.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Распространённые ошибки</h2>
    <ul>
      <li>Считать, что &ldquo;65&rdquo; означает 65 Ач. Это код класса производительности, а реальная ёмкость около 48–52 Ач.</li>
      <li>Переплачивать за 65B24 в ожидании ощутимого апгрейда. На одном заводе прирост ~2 Ач.</li>
      <li>Сравнивать 55B24 высокой ступени одного бренда с 65B24 низкой ступени другого и делать вывод, что код бессмыслен.</li>
      <li>Игнорировать узкий тип клемм JIS и полярность «лево/право» — единственный фактор, который действительно мешает замене.</li>
    </ul>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Примечание об OEM и частной марке</h2>
      <p>Dingwei Battery предлагает программы OEM и частных марок аккумуляторов, произведённых Chengguang Power Tech Co., Ltd. (основана в 2002). Обе модели доступны для программ OEM и частной марки. Поскольку они делят корпус и почти идентичные параметры, владелец марки может рационализировать семейство B24 до одного-двух SKU вместо всех префиксов. Подтверждайте напряжение, ёмкость, базис CCA, тип клемм, полярность и макет этикетки на этапе спецификации.</p>
      <p><a href="/ru/oem/">Программы OEM &rarr;</a> · <a href="/ru/private-label/">Программы частной марки &rarr;</a> · <a href="/ru/data/55b24/">Спецификация 55B24 &rarr;</a> · <a href="/ru/data/65b24/">Спецификация 65B24 &rarr;</a></p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Частые вопросы</h2>
    {faqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Вывод</h2>
      <p>55B24 и 65B24 — один корпус B24 на двух соседних ступенях, и разница незначительна: около 2 Ач и никакого изменения класса холодного пуска. Относитесь к ним как к почти взаимозаменяемым, подтвердите узкие клеммы JIS и полярность, и пусть цена и фактическая спецификация завода ведут решение о покупке.</p>
      <p><a href="/ru/compare/65d26-vs-80d26/">Сравните семейство D26 &rarr;</a> · <a href="/ru/knowledge/battery-dimensions-case-size/">Читать руководство по размерам корпуса &rarr;</a> · <a href="/ru/tools/compare/">Сравнить две модели рядом &rarr;</a></p>
    </div>
  </section>

  <CTASection title="Подтвердите спецификацию 55B24 или 65B24 для вашей программы" />
</BaseLayout>
