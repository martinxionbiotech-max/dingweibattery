---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE, BRAND, PUBLISHED_DATE } from '../../../../data/site';
import { findModel } from '../../../../data/battery-models';

const m65 = findModel('65D26');
const m80 = findModel('80D26');

const title = 'Аккумулятор 65D26 vs 80D26: один корпус, разная мощность | Dingwei Battery';
const description = '65D26 и 80D26 имеют один корпус JIS D26, но различаются ёмкостью (60 против 72 Ач) и CCA. Узнайте, взаимозаменяемы ли они и какой выбрать.';
const articleTitle = 'Аккумулятор 65D26 vs 80D26: один корпус, разная мощность';

const breadcrumbs = [
  { label: 'Сравнение', href: '/ru/compare/' },
  { label: '65D26 vs 80D26' },
];

const faqs = [
  { q: '80D26 больше, чем 65D26?', a: 'Нет. Они делят корпус JIS D26 (примерно 260 × 175 × 220 мм). У 80D26 больше ёмкость и CCA, но не физический размер.' },
  { q: 'Можно ли заменить 65D26 на 80D26?', a: 'Обычно да, физически, при условии совпадения типа клемм и полярности. 80D26 добавляет ёмкость и пусковую мощность, что безопасно для большинства автомобилей — но сначала подтвердите клеммы.' },
  { q: 'Можно ли заменить 80D26 на 65D26?', a: 'Он встанет и заведёт автомобиль в мягких условиях, но даёт меньший резерв и более низкий CCA. В дизеле или приложении с большим числом потребителей он будет работать на износ и не является надёжной долгосрочной заменой.' },
  { q: 'Почему CCA у 80D26 указан по-разному на разных сайтах?', a: 'Потому что JIS (&minus;15&deg;C) и SAE/EN (&minus;18&deg;C) — разные методы испытаний, а производители строят по разным ступеням. Сравнивайте только в рамках одного стандарта.' },
];

const url = `${SITE.url}/ru/compare/65d26-vs-80d26/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleTitle,
    description,
    author: { '@type': 'Organization', name: BRAND },
    publisher: { '@type': 'Organization', name: BRAND, url: SITE.url },
    datePublished: PUBLISHED_DATE,
    dateModified: '2026-09-09',
    image: `${SITE.url}/images/factory/factory-19.webp`,
    mainEntityOfPage: url,
    articleSection: 'Сравнение',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Сравнение', item: `${SITE.url}/ru/compare/` },
      { '@type': 'ListItem', position: 3, name: '65D26 vs 80D26', item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} ogType="article">
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container prose">
    <span class="tag">Сравнение · JIS</span>
    <h1>Аккумулятор 65D26 vs 80D26: один корпус, разная мощность</h1>
    <p class="byline">Опубликовано Dingwei Battery · Последняя проверка 2026-09-09 · Только справочные значения</p>
    <p class="lead">65D26 и 80D26 имеют один и тот же физический корпус (JIS D26, примерно 260 × 175 × 220 мм), поэтому встают в одну и ту же нишу для аккумулятора. Разница электрическая: 80D26 — это более высокая ступень производительности того же корпуса, с большей ёмкостью и более высоким током холодной прокрутки.</p>

    <div class="takeaways">
      <strong>Краткий ответ:</strong> Это две ступени производительности одного корпуса JIS D26, а не два разных размера аккумулятора. Выбирайте 65D26 для экономичной замены в легковых / лёгких коммерческих автомобилях; выбирайте 80D26 для пикапов, внедорожников, дизелей или более высокой нагрузки от потребителей. Они физически взаимозаменяемы в одной нише, но тип клемм и полярность всё равно нужно подтверждать.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Ключевые характеристики (справочно)</h2>
      <table class="data-table">
        <thead>
          <tr><th>Поле</th><th>65D26</th><th>80D26</th></tr>
        </thead>
        <tbody>
          <tr><th>Стандарт</th><td>JIS (JIS D 5301)</td><td>JIS (JIS D 5301)</td></tr>
          <tr><th>Напряжение</th><td>{m65?.voltage} В</td><td>{m80?.voltage} В</td></tr>
          <tr><th>Ёмкость (справочно)</th><td>{m65?.capacity_ah} Ач</td><td>{m80?.capacity_ah} Ач</td></tr>
          <tr><th>CCA (справочно, JIS &minus;15&deg;C)</th><td>{m65?.cca.value}</td><td>{m80?.cca.value}</td></tr>
          <tr><th>Размер корпуса</th><td>{m65?.case_size}</td><td>{m80?.case_size}</td></tr>
          <tr><th>Габариты (мм)</th><td>{m65?.dimensions_mm.length} × {m65?.dimensions_mm.width} × {m65?.dimensions_mm.height}</td><td>{m80?.dimensions_mm.length} × {m80?.dimensions_mm.width} × {m80?.dimensions_mm.height}</td></tr>
          <tr><th>Типовое применение</th><td>{m65?.application}</td><td>{m80?.application}</td></tr>
          <tr><th>OEM / частная марка</th><td>Доступно</td><td>Доступно</td></tr>
        </tbody>
      </table>
      <p class="note">Значения справочные из базы моделей Dingwei. Окончательные характеристики — включая базис CCA, тип клемм и полярность — подтверждайте у производителя перед заказом.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Что на самом деле означает код модели</h2>
    <p>Код модели JIS — не случайное имя. Он раскладывается как <code>[класс производительности][класс корпуса][длина]</code>:</p>
    <ul>
      <li><strong>65 / 80</strong> — <em>класс производительности</em>, который примерно соотносится с ёмкостью (Ач) и CCA. Большее число означает более высокую электрическую ступень, <strong>а не физически больший аккумулятор</strong>.</li>
      <li><strong>D</strong> — <em>класс размера корпуса</em> (ширина и высота). A — самый маленький, H — самый большой. Оба аккумулятора класса &ldquo;D&rdquo;.</li>
      <li><strong>26</strong> — <em>длина</em> в сантиметрах, примерно 260 мм.</li>
    </ul>
    <p>Именно эту часть пропускает большинство страниц сравнения: <strong>65D26 и 80D26 — это один и тот же корпус.</strong> Начальное число меняет количество активного пластинчатого материала и, следовательно, энергию и пусковую мощность — внешние габариты остаются прежними.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Взаимозаменяемы ли они?</h2>
      <p>Физически да — в том смысле, что оба занимают одну нишу и используют одну и ту же зону крепления. Если автомобиль принимает один аккумулятор D26, то другой встанет без изменения крепления.</p>
      <p>Однако перед тем как считать их взаимозаменяемыми, нужно проверить три вещи:</p>
      <ol>
        <li><strong>Тип клемм и полярность.</strong> Аккумуляторы JIS бывают в вариантах «лево/право» (например <code>65D26L</code> против <code>65D26R</code>) и с разными типами клемм. Один корпус &ne; одни и те же клеммы.</li>
        <li><strong>Соответствие ёмкости генератору и нагрузке потребителей.</strong> 65D26 в автомобиле, рассчитанном на 80D26, всё равно заведёт, но будет работать на износ и быстрее выйдет из строя при длительной нагрузке от потребителей или дизельном запуске.</li>
        <li><strong>Базис CCA.</strong> Подтвердите, указан ли CCA по JIS (&minus;15&deg;C) или по SAE/EN (&minus;18&deg;C). Для одной и той же батареи это разные числа.</li>
      </ol>
    </div>
  </section>

  <section class="section container prose">
    <h2>Почему цифры CCA могут выглядеть запутанно</h2>
    <p>Вы увидите значения CCA у 80D26 примерно от 490 до 650 в зависимости от источника. Обычно это не противоречие — это два одновременных явления:</p>
    <ul>
      <li><strong>Метод испытания.</strong> JIS измеряет при &minus;15&deg;C; SAE/EN измеряют при &minus;18&deg;C. Одна и та же батарея даёт разные числа по разным стандартам.</li>
      <li><strong>Ступень производителя.</strong> Разные заводы строят корпус D26 с разной плотностью пластин и пасты, поэтому класс &ldquo;80&rdquo; имеет законный разброс по производительности.</li>
    </ul>
    <p>Практическое правило: <strong>сравнивайте CCA в рамках одного стандарта и считайте напечатанное число справочным, пока производитель не подтвердит его по конкретной процедуре испытания.</strong> Подробнее в <a href="/ru/knowledge/what-is-cca/">руководстве по CCA</a> и в разборе <a href="/ru/knowledge/jis-vs-din-vs-bci/">JIS vs DIN vs BCI</a>.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Какую выбрать?</h2>
      <table class="data-table">
        <thead><tr><th>Выбирайте…</th><th>Когда…</th></tr></thead>
        <tbody>
          <tr><td><strong>65D26</strong></td><td>Стандартные легковые и лёгкие коммерческие автомобили с умеренной нагрузкой потребителей; ценово-чувствительные программы замены; рынки, где 60 Ач — это OEM-база.</td></tr>
          <tr><td><strong>80D26</strong></td><td>Пикапы, средние внедорожники, дизели или автомобили с высокой электрической нагрузкой (лебёдки, доп. свет, телематика автопарков); рынки, где покупатели ждут апгрейда относительно OEM-базы.</td></tr>
        </tbody>
      </table>
      <p>Для импортёра или владельца частной марки полезная рамка такова: <strong>это два SKU в одном корпусе, а не два разных аккумулятора.</strong> Можно предлагать обе ступени производительности одному клиенту с одной нишей, одной оснасткой и одной логистической зоной.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Распространённые ошибки</h2>
    <ul>
      <li>Считать, что аккумулятор &ldquo;80&rdquo; <em>больше</em> аккумулятора &ldquo;65&rdquo;, и заказывать разные ниши. Ниша одна и та же.</li>
      <li>Сравнивать CCA по SAE у 80D26 с CCA по JIS у 65D26 и делать вывод о большем разрыве, чем есть на самом деле.</li>
      <li>Держать на складе только высшую ступень и терять ценово-чувствительный сегмент замены.</li>
      <li>Игнорировать клеммы и полярность при замене одной на другую.</li>
    </ul>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Примечание об OEM и частной марке</h2>
      <p>Dingwei Battery предлагает программы OEM и частных марок аккумуляторов, произведённых Chengguang Power Tech Co., Ltd. (основана в 2002). Обе модели доступны для программ OEM и частной марки. Поскольку они делят корпус, владелец марки может запустить двухуровневую линейку (стандарт + производительность) под одной маркой с одной пресс-формой и одним семейством упаковки. Подтверждайте напряжение, ёмкость, базис CCA, тип клемм, полярность и макет этикетки на этапе спецификации.</p>
      <p><a href="/ru/oem/">Программы OEM &rarr;</a> · <a href="/ru/private-label/">Программы частной марки &rarr;</a> · <a href="/ru/data/65d26/">Спецификация 65D26 &rarr;</a> · <a href="/ru/data/80d26/">Спецификация 80D26 &rarr;</a></p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Частые вопросы</h2>
    {faqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
  </section>

  <section class="section section--alt">
    <div class="container prose">
        <section class="section section--alt">
    <div class="container prose">
      <h2>Мнение автора</h2>
      <p><strong>Позиция:</strong> На мой взгляд, 80D26 — более безопасный выбор по умолчанию для холодного климата и высокой электрической нагрузки, но 65D26 — более разумная покупка при скромных требованиях: избыточный CCA это расход, а не запас.</p>
      <p><strong>Обоснование:</strong></p>
      <ul>
      <li>Они делят один корпус, так что единственный реальный вопрос — ёмкость и CCA против фактической потребности автомобиля.</li>
      <li>Дополнительная ёмкость и пуск 80D26 окупаются только там, где грузовик сталкивается с холодными пусками или тяжёлыми аксессуарами.</li>
      <li>Для владельца бренда общий корпус позволяет одной платформе нести два класса — реальное преимущество линейки.</li>
      </ul>
      <p><em>Раскрытие: это редакционное суждение и полевой опыт автора, а не проверенное техническое утверждение.</em></p>
    </div>
  </section>

<h2>Вывод</h2>
      <p>65D26 и 80D26 — это один корпус на двух ступенях производительности. Решение не о размере — оно о том, чтобы подобрать ёмкость и CCA к электрической и пусковой нагрузке автомобиля, а затем подтвердить клеммы и полярность. Для покупателей и владельцев марок это превращает два внешне разных аккумулятора в одну гибкую платформу.</p>
      <p><a href="/ru/data/">Просмотреть базу моделей &rarr;</a> · <a href="/ru/tools/compare/">Сравнить две модели рядом &rarr;</a> · <a href="/ru/knowledge/battery-dimensions-case-size/">Читать руководство по размерам корпуса &rarr;</a></p>
    </div>
  </section>

  <CTASection title="Подтвердите спецификацию 65D26 или 80D26 для вашей программы" />
</BaseLayout>
