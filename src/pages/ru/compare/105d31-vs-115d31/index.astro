---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE, BRAND, PUBLISHED_DATE } from '../../../../data/site';
import { findModel } from '../../../../data/battery-models';

const m105 = findModel('105D31');
const m115 = findModel('115D31');

const title = 'Аккумулятор 105D31 vs 115D31: один корпус D31, две ступени мощности | Dingwei Battery';
const description = '105D31 (84 Ач) и 115D31 (96 Ач) делят корпус JIS D31. Узнайте реальную разницу, взаимозаменяемы ли они и какую ступень держать на складе.';
const articleTitle = 'Аккумулятор 105D31 vs 115D31: один корпус D31, две ступени мощности';

const breadcrumbs = [
  { label: 'Сравнение', href: '/ru/compare/' },
  { label: '105D31 vs 115D31' },
];

const faqs = [
  { q: '115D31 больше, чем 105D31?', a: 'Нет. Оба используют корпус JIS D31 (примерно 305 × 175 × 220 мм; кросс-ссылка BCI указывает 306 × 173 × 225 мм). У 115D31 больше ёмкость и CCA, но не физический размер.' },
  { q: 'Можно ли заменить 105D31 на 115D31?', a: 'Обычно да, физически, при условии совпадения типа клемм и полярности. 115D31 добавляет резерв и пусковую мощность, что безопасно для большинства тяжёлых внедорожников, полноприводных машин и морского запуска — но сначала подтвердите клеммы.' },
  { q: 'Можно ли заменить 115D31 на 105D31?', a: 'Он встанет и заведёт в мягких условиях, но даёт меньший резерв и более низкий CCA. При длительном дизельном запуске, лебёдке или глубокой нагрузке потребителей он работает на износ и не является надёжной долгосрочной заменой.' },
  { q: 'Почему CCA у 105D31 различается между брендами?', a: 'Потому что JIS (&minus;15&deg;C) и SAE/EN (&minus;18&deg;C) — разные методы испытаний, а заводы строят корпус D31 по разным спецификациям пластин и пасты. Сравнивайте только в рамках одного стандарта и одного производителя.' },
];

const url = `${SITE.url}/ru/compare/105d31-vs-115d31/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleTitle,
    description,
    author: { '@type': 'Organization', name: BRAND },
    publisher: { '@type': 'Organization', name: BRAND, url: SITE.url },
    datePublished: PUBLISHED_DATE,
    dateModified: '2026-09-09',
    image: `${SITE.url}/images/factory/factory-19.webp`,
    mainEntityOfPage: url,
    articleSection: 'Сравнение',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Сравнение', item: `${SITE.url}/ru/compare/` },
      { '@type': 'ListItem', position: 3, name: '105D31 vs 115D31', item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} ogType="article">
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container prose">
    <span class="tag">Сравнение · JIS</span>
    <h1>Аккумулятор 105D31 vs 115D31: один корпус D31, две ступени мощности</h1>
    <p class="byline">Опубликовано Dingwei Battery · Последняя проверка 2026-09-09 · Только справочные значения</p>
    <p class="lead">105D31 и 115D31 имеют один и тот же физический корпус — JIS D31, крупнейший из стандартных японских корпусов для легковых и лёгких коммерческих автомобилей. Разница электрическая: 115D31 — это более высокая ступень производительности того же корпуса, с большей ёмкостью и более высоким током холодной прокрутки.</p>

    <div class="takeaways">
      <strong>Краткий ответ:</strong> Это две ступени производительности одного корпуса JIS D31, а не два разных размера. Выбирайте 105D31 для экономичной замены в стандартных внедорожниках / лёгком коммерческом дизеле и полном приводе; выбирайте 115D31 для тяжёлых внедорожников, полного привода, морского запуска или любого применения, которому нужен больший резерв. Они встают в одну нишу, но тип клемм и полярность нужно подтверждать.
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Ключевые характеристики (справочно)</h2>
      <table class="data-table">
        <thead>
          <tr><th>Поле</th><th>105D31</th><th>115D31</th></tr>
        </thead>
        <tbody>
          <tr><th>Стандарт</th><td>JIS (JIS D 5301)</td><td>JIS (JIS D 5301)</td></tr>
          <tr><th>Напряжение</th><td>{m105?.voltage} В</td><td>{m115?.voltage} В</td></tr>
          <tr><th>Ёмкость (справочно)</th><td>{m105?.capacity_ah} Ач</td><td>{m115?.capacity_ah} Ач</td></tr>
          <tr><th>CCA (справочно, JIS &minus;15&deg;C)</th><td>{m105?.cca.value}</td><td>{m115?.cca.value}</td></tr>
          <tr><th>Размер корпуса</th><td>{m105?.case_size}</td><td>{m115?.case_size}</td></tr>
          <tr><th>Габариты (мм)</th><td>{m105?.dimensions_mm.length} × {m105?.dimensions_mm.width} × {m105?.dimensions_mm.height}</td><td>{m115?.dimensions_mm.length} × {m115?.dimensions_mm.width} × {m115?.dimensions_mm.height}</td></tr>
          <tr><th>Типовое применение</th><td>{m105?.application}</td><td>{m115?.application}</td></tr>
          <tr><th>OEM / частная марка</th><td>Доступно</td><td>Доступно</td></tr>
        </tbody>
      </table>
      <p class="note">Значения справочные из базы моделей Dingwei. Окончательные характеристики — включая базис CCA, тип клемм и полярность — подтверждайте у производителя перед заказом.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Что на самом деле означает код модели</h2>
    <p>Код JIS раскладывается как <code>[класс производительности][класс корпуса][длина]</code>, точно так же, как в более мелком семействе D26:</p>
    <ul>
      <li><strong>105 / 115</strong> — <em>класс производительности</em>, который примерно соотносится с ёмкостью (Ач) и CCA. Большее число означает более высокую электрическую ступень, <strong>а не физически больший аккумулятор</strong>.</li>
      <li><strong>D</strong> — <em>класс размера корпуса</em> (ширина и высота). Оба аккумулятора класса &ldquo;D&rdquo;.</li>
      <li><strong>31</strong> — <em>длина</em> в сантиметрах, примерно 305 мм. Это то, что большинство упускает: <strong>D31 — это не та же ниша, что D26.</strong></li>
    </ul>
    <p>Корпус D31 стоит на вершине стандартной японской лестницы для легковых автомобилей: D23 (232 мм) &rarr; D26 (256 мм) &rarr; D31 (305 мм). Дополнительная длина по сравнению с D26 — источник большей площади пластин и, следовательно, более высоких Ач и CCA. Если автомобиль рассчитан на D26, то D31 обычно <em>не</em> встанет в нишу, хотя все три имеют ширину и высоту класса &ldquo;D&rdquo;.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Взаимозаменяемы ли они?</h2>
      <p>Физически да — 105D31 и 115D31 занимают одну нишу D31 и одну зону крепления, поэтому любой из них встанет в автомобиль, рассчитанный на аккумулятор D31.</p>
      <p>Однако перед тем как считать их взаимозаменяемыми, нужно подтвердить три вещи:</p>
      <ol>
        <li><strong>Тип клемм и полярность.</strong> Аккумуляторы D31 бывают в вариантах «лево/право» (например <code>105D31L</code> против <code>105D31R</code>) и с разными типами клемм. Один корпус &ne; одни и те же клеммы.</li>
        <li><strong>Соответствие резерва нагрузке.</strong> 105D31 в применении, рассчитанном на 115D31, всё равно заведёт, но будет разряжаться глубже под лебёдкой, длительной нагрузкой потребителей или морской сервисной нагрузкой и изнашиваться быстрее.</li>
        <li><strong>Базис CCA.</strong> Подтвердите, указан ли CCA по JIS (&minus;15&deg;C) или по SAE/EN (&minus;18&deg;C). Для одной и той же батареи это разные числа.</li>
      </ol>
    </div>
  </section>

  <section class="section container prose">
    <h2>Почему цифры CCA различаются между брендами</h2>
    <p>Вы увидите значения CCA у 105D31 примерно от 670 до 700, а ёмкость примерно от 83 до 90 Ач, в зависимости от источника. Обычно это не противоречие — это два одновременных эффекта:</p>
    <ul>
      <li><strong>Метод испытания.</strong> JIS измеряет при &minus;15&deg;C; SAE/EN измеряют при &minus;18&deg;C. Одна и та же батарея даёт разные числа по разным стандартам.</li>
      <li><strong>Ступень производителя.</strong> Разные заводы заполняют корпус D31 разным числом пластин и спецификациями пасты, поэтому класс &ldquo;105&rdquo; имеет законный разброс. 105D31 высокой ступени с одного завода может приближаться к 115D31 низкой ступени с другого.</li>
    </ul>
    <p>Практическое правило: <strong>сравнивайте CCA в рамках одного стандарта и сравнивайте ступень со ступенью в рамках одного производителя.</strong> Сравнение 105D31 одного бренда с 115D31 другого говорит больше о заводе, чем о коде. Подробнее в <a href="/ru/knowledge/what-is-cca/">руководстве по CCA</a> и в разборе <a href="/ru/knowledge/jis-vs-din-vs-bci/">JIS vs DIN vs BCI</a>.</p>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Какую выбрать?</h2>
      <table class="data-table">
        <thead><tr><th>Выбирайте…</th><th>Когда…</th></tr></thead>
        <tbody>
          <tr><td><strong>105D31</strong></td><td>Стандартные внедорожники, полный привод и лёгкий коммерческий дизель с умеренной нагрузкой потребителей; ценово-чувствительные программы замены; рынки, где 84 Ач — это OEM-база.</td></tr>
          <tr><td><strong>115D31</strong></td><td>Тяжёлые внедорожники, полный привод с лебёдками или вспомогательными системами, морской запуск или любое применение, которому нужен больший резерв и более сильный холодный запуск.</td></tr>
        </tbody>
      </table>
      <p>Для импортёра или владельца частной марки рамка та же, что и в семействе D26: <strong>это два SKU в одном корпусе, а не два разных аккумулятора.</strong> Можно предлагать двухуровневую линейку D31 — стандартную и тяжёлую — под одной маркой с одной нишей, одной оснасткой и одной логистической зоной.</p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Распространённые ошибки</h2>
    <ul>
      <li>Считать, что аккумулятор &ldquo;115&rdquo; <em>больше</em> аккумулятора &ldquo;105&rdquo;, и заказывать разные ниши. Ниша D31 одна и та же.</li>
      <li>Считать, что D31 встанет в автомобиль D26. D31 примерно на 50 мм длиннее; это другое семейство ниш.</li>
      <li>Сравнивать CCA 105D31 одного бренда с CCA 115D31 другого и делать вывод о большем разрыве, чем подразумевает ступень.</li>
      <li>Игнорировать клеммы и полярность при замене одной ступени на другую.</li>
    </ul>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Примечание об OEM и частной марке</h2>
      <p>Dingwei Battery предлагает программы OEM и частных марок аккумуляторов, произведённых Chengguang Power Tech Co., Ltd. (основана в 2002). Обе модели доступны для программ OEM и частной марки. Поскольку они делят корпус, владелец марки может запустить двухуровневую линейку D31 (стандарт + тяжёлая) под одной маркой с одной пресс-формой и одним семейством упаковки. Подтверждайте напряжение, ёмкость, базис CCA, тип клемм, полярность и макет этикетки на этапе спецификации.</p>
      <p><a href="/ru/oem/">Программы OEM &rarr;</a> · <a href="/ru/private-label/">Программы частной марки &rarr;</a> · <a href="/ru/data/105d31/">Спецификация 105D31 &rarr;</a> · <a href="/ru/data/115d31/">Спецификация 115D31 &rarr;</a></p>
    </div>
  </section>

  <section class="section container prose">
    <h2>Частые вопросы</h2>
    {faqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Вывод</h2>
      <p>105D31 и 115D31 — это один корпус D31 на двух ступенях производительности. Решение не о размере — оно о том, чтобы подобрать ёмкость и CCA к электрической и пусковой нагрузке автомобиля, а затем подтвердить клеммы и полярность. Для покупателей и владельцев марок это превращает два внешне разных аккумулятора в одну гибкую платформу в крупнейшем стандартном корпусе JIS.</p>
      <p><a href="/ru/compare/65d26-vs-80d26/">Сравните вместо этого семейство D26 &rarr;</a> · <a href="/ru/data/">Просмотреть базу моделей &rarr;</a> · <a href="/ru/tools/compare/">Сравнить две модели рядом &rarr;</a></p>
    </div>
  </section>

  <CTASection title="Подтвердите спецификацию 105D31 или 115D31 для вашей программы" />
</BaseLayout>
