---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsBar from '../../components/StatsBar.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER, RELATIONSHIP, BATTERY_TYPES } from '../../data/site';

const title = 'Private-Label Battery Programs | Dingwei Battery';
const description = 'Private-label automotive battery programs from Dingwei Battery, manufactured by Chengguang Energy: your brand, label, packaging and repeatable supply.';

const breadcrumbs = [{ label: 'Private Label', href: '/private-label/' }];

const privateLabelFaqs = [
  {
    q: 'What does a Dingwei private-label program include?',
    a: 'It includes your brand identity on label, packaging and documentation, applied to a proven SLI, AGM, EFB or heavy-duty battery platform with a locked specification and controlled repeat supply.',
  },
  {
    q: 'Which battery types can be private-labelled?',
    a: 'SLI, AGM, EFB and heavy-duty lead-acid starting batteries can be private-labelled across JIS, DIN, BCI, AS and SA standards.',
  },
  {
    q: 'How are repeat private-label orders kept consistent?',
    a: 'Dingwei uses specification control, pre-production sampling, in-process checks and batch traceability so each production run matches your approved sample.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: privateLabelFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Private Label', item: `${SITE.url}/private-label/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Private label</span>
    <h1>Private-label battery programs</h1>
    <p class="lead">{RELATIONSHIP} Put your brand on a proven battery platform — label, case, packaging and documentation included.</p>
  </section>

  <StatsBar />

  <section class="section section--alt">
    <div class="container">
      <h2>What private label includes</h2>
      <div class="grid grid--3">
        <div class="card"><h3>Brand identity</h3><p>Your label, colour scheme and product naming applied to the battery and packaging.</p></div>
        <div class="card"><h3>Product platform</h3><p>SLI, AGM, EFB and heavy-duty platforms across JIS, DIN, BCI, AS and SA standards.</p></div>
        <div class="card"><h3>Repeatable supply</h3><p>Controlled specifications so each order matches your approved sample.</p></div>
      </div>
      <img class="mfg-photo" src="/images/factory/factory-22.webp" alt="Battery inspection area at the Chengguang Energy facility" width="1505" height="830" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="section container">
    <h2>Private label vs OEM: the difference that matters</h2>
    <p class="lead">Private label means you brand a battery the factory already makes; OEM means the factory builds to a specification you define. Private label is faster to launch; OEM gives you a product no one else can copy.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What you can brand</h2>
      <ul>
        <li>Label design and colour scheme</li>
        <li>Box, sleeve and pallet artwork</li>
        <li>Barcode and SKU</li>
        <li>Warranty card</li>
        <li>Multi-language manual</li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <h2>The private-label process</h2>
    <ol>
      <li><strong>Positioning</strong> — define target market and required standards.</li>
      <li><strong>Specification</strong> — lock voltage, capacity, CCA and case size.</li>
      <li><strong>Branding</strong> — apply label, packaging and documentation.</li>
      <li><strong>Sampling</strong> — approve a pre-production sample.</li>
      <li><strong>Production</strong> — scheduled supply that matches the approved sample.</li>
    </ol>
    <p><a href="/knowledge/how-build-private-label-battery-brand/">How to build a private-label battery brand &rarr;</a></p>
  </section>

  <section class="section container">
    <h2>Product families available</h2>
    <div class="grid grid--4">
      {BATTERY_TYPES.map((type) => (
        <div class="card">
          <span class="tag">{type.standards}</span>
          <h3>{type.name}</h3>
          <p>{type.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>How the process works</h2>
      <p>We start with your target market and required standards, agree the specification, then move to design and branding before sampling and production.</p>
      <p><a href="/oem/">See the OEM process &rarr;</a> · <a href="/knowledge/oem-vs-odm-vs-private-label/">OEM vs ODM vs private label &rarr;</a></p>
    </div>
  </section>

  <section class="section container prose">
    <h2>FAQ</h2>
    {privateLabelFaqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
  </section>

  <CTASection title="Start a private-label battery line" />
</BaseLayout>
