---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
import ModelCard from '../../components/ModelCard.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER, RELATIONSHIP } from '../../data/site';
import { batteryModels } from '../../data/battery-models';

const title = 'Heavy-Duty Batteries | Dingwei Battery';
const description = 'Heavy-duty 6V and 12V batteries for trucks, buses and construction equipment, supplied by Dingwei Battery and manufactured by Chengguang Energy.';

const breadcrumbs = [{ label: 'Heavy Duty', href: '/heavy-duty-batteries/' }];

const heavyModels = batteryModels.filter((m) => ['105D31', '115D31', 'N100', 'N150', 'N200'].includes(m.model));

const heavyDutyFaqs = [
  {
    q: 'What applications do Dingwei heavy-duty batteries cover?',
    a: 'Dingwei heavy-duty batteries cover trucks, buses and construction equipment in 6V and 12V configurations, referenced to JIS, DIN, BCI and SA standards.',
  },
  {
    q: 'Can heavy-duty batteries be supplied under my brand?',
    a: 'Yes. Heavy-duty batteries are available for OEM and private-label programs, with specification, branding, sampling and packaging confirmed on inquiry.',
  },
  {
    q: 'What should I include in a heavy-duty battery specification?',
    a: 'Include the standard family, voltage, capacity, CCA test basis, case size, terminal type, polarity, reference model and annual volume, then confirm final values with the manufacturer.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: heavyDutyFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Heavy Duty', item: `${SITE.url}/heavy-duty-batteries/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Heavy duty</span>
    <h1>Heavy-duty batteries</h1>
    <p class="lead">{RELATIONSHIP} 6V and 12V starting batteries for trucks, buses and construction equipment, covering JIS, DIN, BCI and SA standards.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Applications</h2>
      <div class="grid grid--3">
        <div class="card"><h3>Trucks</h3><p>Heavy starting power for commercial truck fleets.</p></div>
        <div class="card"><h3>Buses</h3><p>Reliable starting and electrical support for coaches and city buses.</p></div>
        <div class="card"><h3>Construction equipment</h3><p>Durable batteries for off-highway and industrial machines.</p></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>What counts as heavy-duty</h2>
    <p class="lead">Trucks, buses, construction machinery, agricultural and marine applications — where vibration, deep-cycling and cold-start demand are far higher than a passenger car.</p>
    <div class="grid grid--2">
      <div class="card"><h3>Vibration resistance</h3><p>Heavy-duty batteries are built for constant mechanical shock on rough roads and work sites.</p></div>
      <div class="card"><h3>High cold-cranking demand</h3><p>Large diesel engines need substantially more CCA to start, especially in cold climates.</p></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Standards for heavy-duty</h2>
      <div class="grid grid--3">
        <div class="card"><h3>JIS N-series</h3><p>N150 / N200 — Asian heavy-truck fitments.</p></div>
        <div class="card"><h3>DIN heavy</h3><p>DIN88 / DIN100 — European commercial fitments.</p></div>
        <div class="card"><h3>BCI Group 31 / 4D / 8D</h3><p>North American heavy-duty fitments.</p></div>
      </div>
      <p class="lead">Case sizes and terminal layouts differ between these families and are not interchangeable.</p>
    </div>
  </section>

  <section class="section container">
    <h2>Specifications</h2>
    <ul>
      <li>Predominantly 12V (some 6V configurations)</li>
      <li>Capacity in the 100–225 Ah range</li>
      <li>Diesel engines typically need high CCA (800–1100 A order of magnitude, reference) — confirm the final value with the manufacturer.</li>
    </ul>
    <p><a href="/knowledge/oem-battery-specification-guide/">Read the specification guide &rarr;</a></p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Applications by vehicle</h2>
      <div class="grid grid--3">
        <div class="card"><h3>Semi truck</h3><p>24V systems using two 12V batteries in series.</p></div>
        <div class="card"><h3>Bus</h3><p>Starting and electrical support for coaches.</p></div>
        <div class="card"><h3>Excavator / tractor / marine</h3><p>Off-highway and marine starting batteries.</p></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Manufacturing &amp; export</h2>
    <p class="lead">Manufactured by {MANUFACTURER.name} (founded {MANUFACTURER.founded}) at a {MANUFACTURER.factoryArea} facility with {MANUFACTURER.productionLines}, exporting to {MANUFACTURER.exportMarkets}.</p>
    <p><a href="/factory/">View factory overview &rarr;</a></p>
    <img class="mfg-photo" src="/images/factory/factory-16.webp" alt="Battery assembly at the Chengguang Energy facility" width="1533" height="646" loading="lazy" decoding="async" />
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">Reference models</span>
      <h2>Heavy-duty starting references</h2>
      <p class="lead">Two JIS heavy-duty references from the current model set. Specifications are for reference; confirm final values with the manufacturer.</p>
      <div class="model-list">
        {heavyModels.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Heavy-duty product range</h2>
    <p class="lead">Heavy-duty references supplied by {MANUFACTURER.name}.</p>
    <div class="gallery gallery--product">
      <figure class="gallery__item"><img src="/images/product/hd-n150.webp" alt="N150 heavy-duty battery" width="800" height="749" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/hd-n200.webp" alt="N200 heavy-duty battery" width="800" height="780" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/hd-n100.webp" alt="N100 heavy-duty battery" width="800" height="769" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="section container prose">
    <h2>FAQ</h2>
    {heavyDutyFaqs.map((f) => (
      <div class="card" style="margin-bottom:0.9rem">
        <h3>{f.q}</h3>
        <p style="margin:0">{f.a}</p>
      </div>
    ))}
    <p><a href="/knowledge/oem-battery-specification-guide/">Use the OEM battery specification guide &rarr;</a></p>
  </section>

  <CTASection title="Request a heavy-duty battery quote" />
</BaseLayout>
