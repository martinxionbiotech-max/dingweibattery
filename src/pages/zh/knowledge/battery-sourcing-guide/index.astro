---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';
import { RELATIONSHIP } from '../../../../data/site';

const title = '如何从中国采购 OEM 电池：完整指南 | Dingwei Battery';
const description = '从中国采购 OEM 电池的端到端流程——七阶段序列、决策树、加权评分卡，以及会赔掉一个货柜的常见错误。';
const articleTitle = '如何从中国采购 OEM 电池';

const faqs = [
  { q: '从中国采购一个 OEM 电池订单端到端要多久？', a: '从第一次 RFQ 到第一个货柜，预算 60–90 天：7–14 天筛选与核验供应商、10–20 天打样与批准、30–45 天生产，然后是 3–5 周海运与清关。' },
  { q: '中国电池工厂现实的首单 MOQ 是多少？', a: '一个 20 尺柜——约 600–800 只，视组别而定——因为整柜时单位运费骤降，且托盘堆码把装载卡在远低于集装箱裸体积的位置。' },
  { q: '一次工厂审厂实际花多少钱？', a: '中国一次一日第三方审厂通常 US$1,500–3,000，低于一个价值 US$200,000 首柜的 1%——对「供应商无法复现你的规格」的风险，这是便宜的保险。' },
  { q: '我需要亲自去工厂吗？', a: '首单不必——一份记录在案的审厂 + 一个生产样品能覆盖大部分风险。但年额约 US$500,000 以上的方案，一次实地考察通常值得跑一趟。' },
  { q: '从中国采购最大的单一风险是什么？', a: '从冒充工厂的贸易公司采购——通常加 5–15% 加价并拿走你的质量控制权——所以付款前一定要核验营业执照与产线。' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="Sourcing" dateModified="2026-09-10" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">知识库 · 采购</span>
    <h1>如何从中国采购 OEM 电池：完整指南</h1>
    <p class="byline">由 Dingwei Battery 发布 · 最后审校 2026-09-10 · 来源：晋州成光电源有限公司技术文档</p>
    <p class="lead">从 RFQ 到第一个货柜，七阶段、60–90 天。最大的坑不是质量问题，而是从一个冒充工厂的贸易商那里采购。</p>

    <div class="takeaways">
      <strong>简短回答：</strong> 从中国采购 OEM 电池分七阶段——先锁规格、从正确地区建短名单、核验供应商身份、审厂、发一份完整 RFQ、确认 MOQ 与交期、打通进口路径。最大的单一风险是从冒充工厂的贸易商采购（加 5–15% 加价、拿走质控权）。
    </div>

    <h2>七阶段序列</h2>
    <p>锁规格 → 建短名单 → 核验身份 → 审厂 → 发完整 RFQ → 确认 MOQ/交期 → 打通进口。</p>

    <h2>决策树：每阶段问什么</h2>
    <p>每个阶段都有对应的核验问题。跳过任何一环，风险都会在下一环放大。</p>

    <h2>第 1 阶段——先锁规格</h2>
    <p>标准系列、壳体、电压、容量、CCA 基准、端子与极性先写清。规格不清，一切后续都是猜。</p>

    <h2>第 2 阶段——从正确地区建短名单</h2>
    <p>铅酸电池产业有地域聚集。河北、山东等地是主要产区。从产区里筛，而非全国乱找。</p>

    <h2>第 3 阶段——核验供应商身份</h2>
    <p>核验营业执照、生产资质，确认是真工厂而非贸易商。贸易商冒充工厂是行业常态。</p>

    <h2>第 4 阶段——审厂</h2>
    <p>一日第三方审厂约 US$1,500–3,000，是首柜价值不到 1% 的便宜保险。</p>

    <h2>第 5 阶段——发一份完整 RFQ</h2>
    <p>15 个字段、四块、每行一个型号。范围清，报价才可比。</p>

    <h2>第 6 阶段——确认 MOQ 与交期</h2>
    <p>MOQ 跟着集装箱走（一个 20 尺柜、600–800 只）；交期 30–45 天生产 + 3–5 周海运。</p>

    <h2>第 7 阶段——打通进口路径</h2>
    <p>危险品申报、目的国认证与清关要求提前办，别货到再补。</p>

    <h2>加权供应商评分卡</h2>
    <p>标准覆盖、认证、规模、可重复性、出口经验——按业务重点加权打分。</p>

    <h2>两个重新框定决策的演算</h2>
    <p>①年量 ÷ 日产能 = 您在对方排产里的分量；②审厂成本 ÷ 首柜价值 = 不到 1% 的保险费率。</p>

    <h2>供应商不会主动说的</h2>
    <p>MOQ 也反映他们的库存压力，不只是您的运费经济。要问 MOQ 的逻辑，而非接受裸数字。</p>

    <h2>会赔掉一个货柜的常见错误</h2>
    <p>跨标准比 CCA、先定标签后定规格、只看最低价、从不冒充工厂的贸易商采购。</p>

    <h2>The Author's Take</h2>
    <p><strong>立场：</strong>从中国采购最大的坑不是质量，而是从冒充工厂的贸易商那里买——先核验「有没有厂」，再谈别的。</p>
    <p><strong>理由：</strong></p>
    <ul>
      <li>贸易商加 5–15% 加价，还拿走你的质控权。</li>
      <li>一份一日审厂不到首柜价值的 1%，是便宜保险。</li>
      <li>敢公开型号数据、让你核验的供应商，才配谈长期合作。</li>
    </ul>
    <p><em>声明：这是作者的编辑判断与行业经验；审厂成本与货值均为行业典型估算，非对具体交易的承诺。</em></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="开始您的中国 OEM 采购" />
</ArticleLayout>
