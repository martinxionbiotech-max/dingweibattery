const articleTitle = '电池运输、合规与质保：完整指南';

const faqs = [
  { q: '铅酸电池算危险品运输吗？', a: '算——第 8 类腐蚀性。富液启动电池按 UN 2794（湿电池、充有酸液）运输；防溢漏设计按 UN 2800 运输。相对锂电的实际优势是：铅酸不需要 UN 38.3 测试报告。' },
  { q: '一个 20 尺柜能装多少只启动电池？', a: '首单大约 600–800 只（视壳体组大小可达 900–1,200）。20 尺柜的载重上限约 28,000 公斤，而电池货在填满 33 立方体积之前就先撞上重量天花板。' },
  { q: '铅酸电池在仓库能放多久？', a: '大约 6 个月就需要补电——铅酸每月自放电约 3–5%，且每升高 10°C 速率翻倍，所以热仓库里的库存流失更快。' },
