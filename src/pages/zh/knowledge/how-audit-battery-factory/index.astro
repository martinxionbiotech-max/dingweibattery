---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';
import { MANUFACTURER, CERTIFICATIONS, RELATIONSHIP } from '../../../../data/site';

const title = '如何审铅酸电池工厂：走线流程与单证 | Dingwei Battery';
const description = '如何为 OEM 采购审一家铅酸电池工厂：按生产顺序的现场走线、要索取的单证、IATF 16949 审核点，以及审厂成本计算。';
const articleTitle = '如何审铅酸电池工厂';

const faqs = [
  { q: '我需要亲自到访工厂吗？', a: '不一定。一套有单证的审核——证书、过程描述和测试数据——加上一只生产样品，就能覆盖大部分风险。但年采购额超过约 50 万美元的项目，一次实地到访通常是值得跑一趟的。' },
  { q: '最说明问题的要看什么？', a: '固化时间。一家为了省几天而赶固化的工厂，会产出过早失效的弱极板——要问它们的固化窗口（通常是 2–4 天），而不只是问产能数字。' },
  { q: '为什么铅酸审核比锂电审核简单？', a: '铅酸不需要热失控或电芯安全审核。审核重心转向过程一致性和原材料管控——整条走线是 10 个阶段，比锂电审核更容易验证。' },
  { q: '一次实地审厂要花多少钱？', a: '在中国，一天第三方审核通常 1,500–3,000 美元——不到一个价值 28,000 美元首柜的 1%——所以为省钱而跳过它，反而是最贵的选择。' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="质量" dateModified="2026-09-11" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">知识库 · 采购</span>
    <h1>如何审铅酸电池工厂</h1>
    <p class="byline">由 Dingwei Battery 发布 · 最后审校 2026-09-11 · 来源：晋州成光电源有限公司技术文档；IATF 16949</p>
    <p class="lead">工厂审核是你验证一家电池制造商能否反复交付你的规格——而不只是交付一次——的方式。按生产顺序走线，每个阶段问一个问题，再把单证对照你亲眼看到的东西。</p>

    <div class="takeaways">
      <strong>简短回答：</strong> 按生产顺序审电池工厂——铸板、和膏、涂板、固化、装配、化成、封盖和测试——并在每个阶段问测量了什么、不合格品如何处理。最说明问题的单一问题是固化时间：一家为了省几天而赶固化的工厂，会发出过早失效的弱极板，所以问固化窗口（通常 2–4 天）。一次一天第三方审核花 1,500–3,000 美元，不到一个首柜的 1%。
    </div>

    <h2>到访之前：单证集</h2>
    <p>一半的审核发生在你走线之前。索取这些单证并先读——它们告诉你工厂 <em>声称</em> 了什么，走线再确认或推翻它：</p>
    <ul>
      <li><strong>证书</strong>——IATF 16949 / ISO 9001 的编号与范围，用于核实其当前有效。{MANUFACTURER.name} 持有 {CERTIFICATIONS.join('、')}。</li>
      <li><strong>过程流程图</strong>——一份带各阶段控制点的书面生产流程。</li>
      <li><strong>控制计划与 FMEA</strong>——这些汽车风格的单证表明一家工厂是在失效模式上思考，而不只是吞吐量。</li>
      <li><strong>批次记录</strong>——一份从原材料追溯到成品电池的样本批次。</li>
      <li><strong>测试程序</strong>——CCA 和容量方法，并点明测试基准。</li>
    </ul>
    <p>一家拥有 IATF 16949 体系的工厂，应能在要求下拿出这些。一家在控制计划上犹豫的工厂，是在告诉你它靠习惯运转，而不是靠一套有单证的系统。</p>

    <h2>按生产顺序走十个阶段</h2>
    <p>按电池被制造出来的顺序走工厂。每个阶段问测量了什么、不合格品如何管控：</p>
    <ol>
      <li><strong>铸板</strong>——查栅格厚度与合金一致性；问超出公差的栅格怎么处理。</li>
      <li><strong>和膏</strong>——查配料管控与批次记录；问批次之间铅膏密度如何保持。</li>
      <li><strong>涂板</strong>——查极板重量与涂膏；问极板重量如何验证。</li>
      <li><strong>固化</strong>——查时间与条件；典型窗口是 2–4 天。这是要最严格的阶段——赶固化是经典捷径。</li>
      <li><strong>装配</strong>——查极板对齐与隔板处理。</li>
      <li><strong>焊接</strong>——查跨格与端子焊缝；一处差焊是一次隐藏的早期失效。</li>
      <li><strong>加酸</strong>——查酸量与密度控制。</li>
      <li><strong>化成充电</strong>——查充电曲线与时长；化成通常是产能瓶颈。</li>
      <li><strong>封盖</strong>——查盖、排气孔与泄漏控制。</li>
      <li><strong>测试</strong>——确认 100% 下线电气测试，加上 CCA 和容量抽检。</li>
    </ol>
    <p>带上这个顺序，与 <a href="/zh/knowledge/oem-battery-supplier-checklist/">OEM 电池供应商清单</a> 上的有单证核查项对照。</p>

    <h2>IATF 16949 审核点</h2>
    <p>如果工厂声称 <a href="https://www.iatfglobaloversight.org/">IATF 16949</a>，应能看到三样非认证工厂通常缺的东西：</p>
    <ul>
      <li><strong>每个过程步骤的控制计划</strong>——不只是末端的一张质检桌，而是在铸板、涂板、固化和化成处有明确控制。</li>
      <li><strong>变更管理</strong>——一套书面的工程变更（ECO）流程，让规格变更被批准，而不是即兴改动。</li>
      <li><strong>可追溯性</strong>——一个批次能向后映射到原材料批次、向前映射到成品，这正是召回和质保裁决得以可能的原因。</li>
    </ul>
    <p>走线时要求看这三样。一张没有可见控制计划和变更流程的 IATF 证书，是墙上装饰，不是体系。</p>

    <h2>审厂成本计算</h2>
    <p>这组算术应当终结任何对审核的犹豫：</p>
    <p class="lead">审核成本 ÷ 订单价值 = 百分之一的零头。</p>
    <p>在中国，一次一天第三方审核约 1,500–3,000 美元。一个 700 只电池、落地单价 40 美元的首柜是 28,000 美元。一个月一柜的 12 个月项目超过 300,000 美元。审核不到单个货柜的 1%——而它是项目里唯一 <em>防止</em> 更大损失的一项。定金付完后才发现的规格漂移，烧掉的是一个货柜，不是一笔审核费。</p>

    <h2>从审厂带回家什么</h2>
    <ul>
      <li>当前有效的证书，带可核验的编号。</li>
      <li>近期生产批次的一只样品。</li>
      <li>你参考型号的一张规格表。</li>
      <li>书面约定的商务条款。</li>
      <li>如果你做长期项目，控制计划与变更流程。</li>
    </ul>
    <p><a href="/zh/knowledge/oem-battery-supplier-checklist/">OEM 电池供应商清单 →</a> · <a href="/zh/factory/">电池工厂能力 →</a></p>

    <h2>铅酸审核比锂电简单</h2>
    <p>铅酸审核的精力集中在过程一致性和原材料上。锂电电芯审核还要加上电芯安全和热失控管控；铅酸不背同样的电芯安全审核负担。这让铅酸审核更短、更易标准化——进而便宜到跳过它才是昂贵的选择。{RELATIONSHIP} 以 <a href="/zh/factory/">Dingwei 工厂概览</a> 为一个应索取审核数据的现成示例。</p>

    <h2>审核在流程中的位置</h2>
    <p>审核是 <a href="/zh/knowledge/battery-sourcing-guide/">采购指南</a> 七个阶段里的第四阶段：在你 <a href="/zh/knowledge/battery-supplier-verification/">核验过供应商是真的</a> 之后、在你 <a href="/zh/knowledge/oem-battery-rfq-guide/">发出 RFQ</a> 之前。审核一个未经核验的供应商是浪费到访；报价一个未经审核的供应商是浪费订单。</p>

    <h2>要拍什么、记什么</h2>
    <p>一次审核只和你带回来的东西一样有用。记录这些，因为它们是几个月后你要依赖的证据：</p>
    <ul>
      <li><strong>固化房</strong>——温湿度显示和极板堆，日期入镜。固化是最可能在宣传册里造假的阶段。</li>
      <li><strong>化成区</strong>——在运行的回路数量，你将用它交叉核对产能宣称。</li>
      <li><strong>下线测试工位</strong>——正在进行的测试，在真实单元上显示 CCA/容量数值。</li>
      <li><strong>批次记录</strong>——一份从原铅到成品电池的完整追溯。</li>
      <li><strong>证书编号</strong>——拍下来以便事后核验，而不只是读一遍。</li>
    </ul>
    <p>如果工厂不让你拍固化房或化成区，那本身就是一个发现——用记录一次测试失败的方式记下它。</p>

    <h2>第三方审核 vs 自己跑</h2>
    <p>你不必飞过去才能跑审核。中国的一家第三方检验公司可以花 1,500–3,000 美元做走线，好的公司会遵循一份铅酸专用清单。取舍很简单：第三方更便宜、往往更客观，但它报告的是你要求它查的内容——所以你必须交给它一份完整清单（用 <a href="/zh/knowledge/oem-battery-supplier-checklist/">供应商清单</a>）。自己跑，你能看到细微处，但要付差旅、还得扛着自己的乐观。多数项目用第三方做首轮筛选，把亲自到访留给最终入围者。</p>

    <h2>抽样与 AQL 批次测试</h2>
    <p>下线测试对电气参数是 100% 覆盖，但破坏性或实验室测试（循环寿命、温度下的 CCA、C20 下的容量）在样品上做。确认抽样方案，而不是接受一句"我们每个批次都测"——有用的答案会点明标准和接收水平。一套基于 AQL 的抽样方案会告诉你每批测多少只、接收/拒收阈值是多少。一家描述不出自己抽样方案的工厂，是在凭感觉测试，那是一个发现。</p>

    <h2>不合格处理</h2>
    <p>问一个把质量体系和质检桌区分开的收尾问题："当一个批次测试失败，接下来发生什么？"一套真正的体系会用明确的流程回答——隔离、根因、纠正措施和复测——并能拿出上一次发生的记录。一家回答"从没发生过"的工厂，刚刚告诉你它没有在测量。这一个问题抵得上半条走线，因为它揭示你刚看到的那些控制是否真的在用。</p>

    <h2>审核背后的标准</h2>
    <p>如果你想让审核本身遵循公认方法，<a href="https://www.iso.org/standard/70017.html">ISO 19011</a> 是审核管理体系的国际指南，也是第三方审核员据以工作的参考。你不必是审核员也能用它——它的核心思想是审核基于证据、而非印象：你收集单证和观察，再把它们对照既定准则匹配。这正是本次走线所遵循的纪律，也是为什么本指南里的问题要的是记录和测量、而不是保证。</p>
    <p>一家欢迎过程审核、并能拿出控制计划、FMEA 和批次记录的工厂，已经在像一个 IATF 16949 工厂那样运转。一家抗拒单证证据的工厂，在你走到固化房之前就已经审核失败了。</p>

    <h2>来源与延伸阅读</h2>
    <ul>
      <li><a href="https://www.iatfglobaloversight.org/">IATF Global Oversight</a>——监管本指南所核查其控制计划与变更控制要点的 IATF 16949 体系。</li>
      <li><a href="https://www.iso.org/standard/70017.html">ISO 19011</a>——审核管理体系的指南，也是一次站得住脚的审核背后的方法。</li>
    </ul>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>The Author's Take</h2>
      <p><strong>立场：</strong>在我看来，最说明问题的单一审核问题是固化窗口——一家为了省几天而赶极板固化的工厂，会发出过早失效的电池。</p>
      <p><strong>理由：</strong></p>
      <ul>
        <li>一半的审核发生在到访之前：控制计划、FMEA 和批次记录告诉你工厂声称了什么，走线再确认或推翻。</li>
        <li>那个收尾问题——"当一个批次失败，接下来发生什么？"——比任何单一单证都更能把质量体系和质检桌区分开。</li>
        <li>不到单个货柜的 1%，审核是最便宜、却能防止更大损失的一项。</li>
      </ul>
      <p><em>声明：这是作者的编辑判断与行业经验，非经核验的技术结论。</em></p>
    </div>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="把 Dingwei Battery 放进您的审核流程" />
</ArticleLayout>
