---
import ArticleLayout from '../../../../layouts/ArticleLayout.astro';
import ArticleFaq from '../../../../components/ArticleFaq.astro';
import CTASection from '../../../../components/CTASection.astro';
import { RELATIONSHIP } from '../../../../data/site';

const title = '电池出口单证 | Dingwei Battery';
const description = '电池出口的五份核心单证、危险品申报详解、随货单证，以及 Incoterms 如何划分单证责任。';
const articleTitle = '电池出口单证';

const faqs = [
  { q: '一份电池出口需要多少核心单证？', a: '至少 5 份——商业发票、装箱单、提单、原产地证与危险品申报——外加目的地或承运人要求的检测报告与 MSDS。' },
  { q: '电池出口商最常漏哪份单证？', a: '危险品申报，它必须由持证人员签署。漏了就是罚款、货柜延误或拒运，因为电池是第 8 类，不是普通货物。' },
  { q: '原产地证证明什么？', a: '货物在哪里制造——它是 5 份核心单证之一，能解锁优惠关税税率，所以许多目的地海关要求它，既是合规文件也是形式。' },
  { q: '何时需要 CCA 或容量检测报告？', a: '当目的地市场或买方合同要求时——多数市场想要证明电池达到标称规格（如 72 Ah、490 CCA），所以报告随货同行作为证据。' },
  { q: 'Incoterms 如何改变单证责任？', a: '它决定谁安排并支付每份单证与每段运输——FOB 下买方控制货运与清关；CIF 下卖方安排保险与运费，风险在起运港而非目的地转移。' },
];
---
<ArticleLayout title={title} description={description} articleTitle={articleTitle} articleSection="Logistics" dateModified="2026-09-10" faqs={faqs}>
  <section class="section container prose">
    <span class="tag">知识库 · 物流</span>
    <h1>电池出口单证</h1>
    <p class="byline">由 Dingwei Battery 发布 · 最后审校 2026-09-10 · 来源：行业出口实践、IMDG Code</p>
    <p class="lead">一套标准出口单证可避免清关延误。五份核心单证里，最常漏的是危险品申报。</p>

    <div class="takeaways">
      <strong>简短回答：</strong> 电池出口至少需要 5 份核心单证——商业发票、装箱单、提单、原产地证、危险品申报——外加检测报告与 MSDS。最常漏的是危险品申报（须持证人员签署）。Incoterms 决定谁安排并支付每份单证与每段运输。
    </div>

    <h2>五份核心单证</h2>
    <ul>
      <li>商业发票</li>
      <li>装箱单</li>
      <li>提单</li>
      <li>原产地证</li>
      <li>危险品申报</li>
    </ul>

    <h2>危险品申报，详解</h2>
    <p>电池是第 8 类危险品，危险品申报必须由持证人员签署。漏了就是罚款、延误或拒运。</p>

    <h2>随货支持单证</h2>
    <p>CCA/容量检测报告、MSDS、质检单——目的地或承运人要求时随货同行。</p>

    <h2>Incoterms 如何分工</h2>
    <p>FOB 买方控制货运与清关；CIF 卖方安排保险与运费。单证责任随之划分。</p>

    <h2>什么拖慢电池出货</h2>
    <p>单证不符、危险品申报缺失、原产地证缺失——三处不符最常见。</p>

    <h2>三处导致滞留的不符</h2>
    <p>单证数据与货物不符、危险品申报缺失、原产地证缺失或错误。</p>

    <h2>谁签什么</h2>
    <p>危险品申报由持证人员签，原产地证由商会/海关签，提单由承运人签。</p>

    <h2>The Author's Take</h2>
    <p><strong>立场：</strong>危险品申报是最常漏、也最致命的一份单证——电池是第 8 类危险品，漏了就是罚款、延误或拒运。</p>
    <p><strong>理由：</strong></p>
    <ul>
      <li>电池是第 8 类，不是普通货物，申报必须持证签署。</li>
      <li>单证不符是清关滞留的头号原因。</li>
      <li>一套完整单证本身就是供应商专业度的证明。</li>
    </ul>
    <p><em>声明：这是作者的编辑判断与行业经验；单证要求以目的地海关与承运人要求为准。</em></p>
  </section>

  <ArticleFaq faqs={faqs} />

  <CTASection title="确认您订单的出口单证" />
</ArticleLayout>
