const faqs = [
  { q: '沙特阿拉伯卡车用哪种电池标准？', a: '沙特阿拉伯运营日系与欧系混合商用车队，因此 JIS N 系列电池（N150/N200/N100）是主流卡车电池组，DIN/EN 代码则作为欧洲车的替代方案。电池跟着车走、不跟着国家走——需对照车辆确认电池组尺寸、端子布局与电压。' },
