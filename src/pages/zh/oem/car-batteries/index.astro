---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CTASection from '../../../../components/CTASection.astro';
import ModelCard from '../../../../components/ModelCard.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER, RELATIONSHIP, STANDARDS } from '../../../../data/site';
import { batteryModels } from '../../../../data/battery-models';

const title = 'OEM 汽车电池 | Dingwei Battery';
const description = 'Dingwei Battery 提供 OEM 汽车电池，由晋州成光电源有限公司制造：乘用车与轻型商用车用 SLI、AGM、EFB 启动电池。';

const breadcrumbs = [
  { label: '首页', href: '/zh/' },
  { label: 'OEM', href: '/zh/oem/' },
  { label: '汽车电池', href: '/zh/oem/car-batteries/' },
];

const carModels = batteryModels.filter((m) => !['105D31', '115D31', 'N100', 'N150', 'N200'].includes(m.model));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE.url}/zh/` },
      { '@type': 'ListItem', position: 2, name: 'OEM', item: `${SITE.url}/zh/oem/` },
      { '@type': 'ListItem', position: 3, name: '汽车电池', item: `${SITE.url}/zh/oem/car-batteries/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">OEM / 汽车</span>
    <h1>OEM 汽车电池</h1>
    <p class="lead">{RELATIONSHIP} 我们以您的品牌供应乘用车与轻型商用车用 SLI、AGM、EFB 启动电池。</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>汽车电池技术</h2>
      <div class="grid grid--3">
        <div class="card"><h3>SLI</h3><p>面向标准车型的传统富液式启动、照明与点火电池。</p></div>
        <div class="card"><h3>AGM</h3><p>贫液式玻璃纤维隔板结构，面向启停系统与更高电耗。</p></div>
        <div class="card"><h3>EFB</h3><p>增强型富液电池，循环耐久性更好，面向入门级启停。</p></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>覆盖标准</h2>
    <p class="lead">按您市场所用的标准指定规格。支持系列：{STANDARDS.join('、')}。</p>
    <p><a href="/knowledge/oem-battery-specification-guide/">阅读 OEM 电池规格指南 &rarr;</a></p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="tag">参考型号</span>
      <h2>乘用车启动参考型号</h2>
      <p class="lead">常见 JIS 与 DIN/EN 汽车电池参考型号，用于适配规划。规格仅供参考，下单前请与制造商确认最终数值。</p>
      <div class="model-list">
        {carModels.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>汽车电池系列</h2>
    <p class="lead">{MANUFACTURER.name} 供应的 JIS 与 DIN/EN 汽车电池参考型号。</p>
    <div class="gallery gallery--product">
      <figure class="gallery__item"><img src="/images/product/range-55d23.webp" alt="55D23 电池" width="800" height="768" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/range-din70.webp" alt="DIN70 电池" width="800" height="787" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/range-din72.webp" alt="DIN72 电池" width="800" height="778" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/range-din75.webp" alt="DIN75 电池" width="800" height="798" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/range-din80a.webp" alt="DIN80 电池" width="800" height="783" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/range-din80b.webp" alt="DIN80 电池" width="800" height="783" loading="lazy" decoding="async" /></figure>
      <figure class="gallery__item"><img src="/images/product/range-din100.webp" alt="DIN100 电池" width="800" height="751" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="section container">
    <h2>从规格到出货</h2>
    <p>OEM 汽车电池方案遵循七步流程：咨询、规格、设计与品牌、打样、量产、质控、出货。</p>
    <p><a href="/zh/oem/">查看完整 OEM 流程 &rarr;</a></p>
  </section>

  <CTASection title="索取 OEM 汽车电池报价" />
</BaseLayout>
