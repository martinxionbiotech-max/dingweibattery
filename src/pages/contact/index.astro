---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { SITE, RELATIONSHIP, TRADE_TERMS } from '../../data/site';

const title = 'Contact & RFQ | Dingwei Battery';
const description = 'Request an OEM or private-label battery quote from Dingwei Battery. Share your specification, target market and annual volume for a custom program.';

const breadcrumbs = [{ label: 'Contact', href: '/contact/' }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${SITE.url}/contact/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">Contact / RFQ</span>
    <h1>Request an OEM or private-label battery quote</h1>
    <p class="lead">{RELATIONSHIP} Use the brief below to organise your requirements, then share it with the manufacturer&rsquo;s export team.</p>
  </section>

  <section class="section--tight container">
    <form id="rfq-form" action="/contact/" method="post">
      <div class="form-grid">
        <div class="field">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" autocomplete="organization" required />
        </div>
        <div class="field">
          <label for="country">Country / market</label>
          <input id="country" name="country" type="text" autocomplete="country-name" required />
        </div>
        <div class="field">
          <label for="buyer-type">Buyer type</label>
          <select id="buyer-type" name="buyer_type">
            <option value="">Select</option>
            <option>Distributor</option>
            <option>Retailer</option>
            <option>Fleet operator</option>
            <option>Brand owner</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="battery-type">Battery type</label>
          <select id="battery-type" name="battery_type">
            <option value="">Select</option>
            <option>SLI</option>
            <option>AGM</option>
            <option>EFB</option>
            <option>Heavy Duty</option>
            <option>Not sure</option>
          </select>
        </div>
        <div class="field">
          <label for="standard">Standard</label>
          <select id="standard" name="standard">
            <option value="">Select</option>
            <option>JIS</option>
            <option>DIN</option>
            <option>BCI</option>
            <option>AS</option>
            <option>SA</option>
            <option>EN</option>
            <option>Not sure</option>
          </select>
        </div>
        <div class="field">
          <label for="model">Model / case reference</label>
          <input id="model" name="model" type="text" placeholder="e.g. 65D26, H6" />
        </div>
        <div class="field">
          <label for="voltage">Voltage</label>
          <select id="voltage" name="voltage">
            <option value="">Select</option>
            <option>6V</option>
            <option>12V</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="capacity">Capacity (Ah)</label>
          <input id="capacity" name="capacity_ah" type="number" min="1" />
        </div>
        <div class="field">
          <label for="cca">CCA (reference)</label>
          <input id="cca" name="cca_reference" type="number" min="0" />
        </div>
        <div class="field">
          <label for="volume">Annual volume (units)</label>
          <input id="volume" name="annual_volume" type="number" min="0" />
        </div>
        <div class="field">
          <label for="private-label">Private label</label>
          <select id="private-label" name="private_label">
            <option value="">Select</option>
            <option>Yes</option>
            <option>No</option>
          </select>
        </div>
        <div class="field">
          <label for="packaging">Packaging preference</label>
          <input id="packaging" name="packaging" type="text" />
        </div>
        <div class="field">
          <label for="notes">Notes / additional requirements</label>
          <textarea id="notes" name="notes"></textarea>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn" type="submit">Prepare RFQ brief</button>
        <p id="rfq-status" class="form-status" role="status">RFQ brief ready. Share these details with the manufacturer&rsquo;s export team to receive terms. Prices are never published and are provided only on inquiry.</p>
      </div>
    </form>
    <p class="note">Commercial terms to confirm on inquiry: MOQ {TRADE_TERMS.moq}; lead time {TRADE_TERMS.leadTime}; payment {TRADE_TERMS.payment}; incoterms {TRADE_TERMS.incoterms}; warranty {TRADE_TERMS.warranty}.</p>
  </section>

  <script is:inline>
    const form = document.getElementById('rfq-form');
    const status = document.getElementById('rfq-status');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      status.style.display = 'block';
      status.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  </script>
</BaseLayout>
