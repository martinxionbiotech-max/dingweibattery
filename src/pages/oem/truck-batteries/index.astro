---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTASection from '../../../components/CTASection.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { SITE, BRAND, MANUFACTURER, RELATIONSHIP } from '../../../data/site';

const title = 'OEM Truck Batteries | Dingwei Battery';
const description = 'OEM truck batteries from Dingwei Battery, manufactured by Chengguang Energy: 6V and 12V heavy-duty batteries for trucks, buses and construction equipment.';

const breadcrumbs = [
  { label: 'OEM', href: '/oem/' },
  { label: 'Truck Batteries', href: '/oem/truck-batteries/' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'OEM', item: `${SITE.url}/oem/` },
      { '@type': 'ListItem', position: 3, name: 'Truck Batteries', item: `${SITE.url}/oem/truck-batteries/` },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <JsonLd slot="head" data={jsonLd} />

  <section class="section container">
    <span class="tag">OEM / Truck</span>
    <h1>OEM truck batteries</h1>
    <p class="lead">{RELATIONSHIP} Heavy-duty starting batteries in 6V and 12V for trucks, buses and construction equipment, supplied under your brand.</p>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Truck battery programs</h2>
      <div class="grid grid--2">
        <div class="card"><h3>6V &amp; 12V heavy duty</h3><p>Starting batteries for trucks, buses and off-highway machines, covering JIS, DIN, BCI and SA standards.</p></div>
        <div class="card"><h3>Fleet consistency</h3><p>Stable case size, terminal layout and labelling across repeat OEM orders.</p></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Applications</h2>
    <div class="grid grid--3">
      <div class="card"><h3>Semi trucks</h3><p>24V starting systems using two 12V batteries in series.</p></div>
      <div class="card"><h3>Buses &amp; coaches</h3><p>Reliable starting and electrical support for passenger fleets.</p></div>
      <div class="card"><h3>Off-highway equipment</h3><p>Durable starting batteries for construction and agricultural machines.</p></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container prose">
      <h2>Standards for truck batteries</h2>
      <p>Truck fitments are not interchangeable across markets. The same application may use a JIS N-series battery in Asia, a DIN heavy reference in Europe, or a BCI Group 31 / 4D / 8D in North America. Confirm the standard family and case size with the vehicle or fleet requirement before ordering.</p>
      <ul>
        <li><strong>JIS N-series</strong> — N150 / N200, Asian heavy-truck fitments.</li>
        <li><strong>DIN heavy</strong> — DIN88 / DIN100, European commercial fitments.</li>
        <li><strong>BCI Group 31 / 4D / 8D</strong> — North American heavy-duty fitments.</li>
      </ul>
    </div>
  </section>

  <section class="section container prose">
    <h2>What to specify for a truck battery</h2>
    <ul>
      <li>Standard family and case size (JIS / DIN / BCI / SA).</li>
      <li>Voltage (12V standard; 6V and 24V-series configurations available).</li>
      <li>Capacity, typically in the 100–225 Ah range for heavy-duty use.</li>
      <li>CCA — large diesel engines need high cold-cranking amps; confirm the test basis (reference) with the manufacturer.</li>
      <li>Terminal type and position for your cable routing.</li>
    </ul>
    <p><a href="/knowledge/oem-battery-specification-guide/">Read the OEM battery specification guide &rarr;</a></p>
  </section>

  <section class="section container">
    <h2>Manufacturing &amp; export</h2>
    <p class="lead">Manufactured by {MANUFACTURER.name} (founded {MANUFACTURER.founded}) at a {MANUFACTURER.factoryArea} facility in {MANUFACTURER.address}, with {MANUFACTURER.productionLines} and export to {MANUFACTURER.exportMarkets}.</p>
    <p><a href="/factory/">View factory overview &rarr;</a> · <a href="/heavy-duty-batteries/">Heavy-duty battery details &rarr;</a></p>
  </section>

  <CTASection title="Request an OEM truck battery quote" />
</BaseLayout>
