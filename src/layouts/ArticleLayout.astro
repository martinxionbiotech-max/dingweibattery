---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, BRAND, PUBLISHED_DATE } from '../data/site';

interface Props {
  title: string;
  description: string;
  articleTitle: string;
}
const { title, description, articleTitle } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleTitle,
    description,
    author: { '@type': 'Organization', name: BRAND },
    publisher: { '@type': 'Organization', name: BRAND, url: SITE.url },
    datePublished: PUBLISHED_DATE,
    dateModified: PUBLISHED_DATE,
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: articleTitle, item: url },
    ],
  },
];
---
<BaseLayout title={title} description={description} breadcrumbs={[{ label: articleTitle }]} ogType="article">
  <JsonLd slot="head" data={jsonLd} />
  <slot />
</BaseLayout>
