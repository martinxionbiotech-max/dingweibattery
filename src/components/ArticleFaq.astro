---
interface Props { faqs: { q: string; a: string }[]; }
const { faqs } = Astro.props;
---
<section class="section container prose">
  <h2>Frequently asked questions</h2>
  {faqs.map((f) => (
    <div class="card" style="margin-bottom:0.9rem">
      <h3>{f.q}</h3>
      <p style="margin:0">{f.a}</p>
    </div>
  ))}
</section>
