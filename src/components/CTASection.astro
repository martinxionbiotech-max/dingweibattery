---
import { UI, DEFAULT_LOCALE, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/url';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  button?: string;
}

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = UI[locale];

const {
  title = t.cta.defaultTitle,
  text = t.cta.defaultText,
  href = '/contact/',
  button = t.requestOemQuote,
} = Astro.props;

const resolvedHref = localizedPath(href, locale);
---
<section class="section--tight">
  <div class="container">
    <div class="callout">
      <h2>{title}</h2>
      <p style="margin:0.5rem 0 1.25rem;color:#d7e0ec">{text}</p>
      <a class="btn" href={resolvedHref}>{button}</a>
    </div>
  </div>
</section>
