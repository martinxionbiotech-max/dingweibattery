---
import { BRAND, CONTACT } from '../data/site';
import { UI, LOCALES, DEFAULT_LOCALE, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/url';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = UI[locale];
const pathname = Astro.url.pathname;

const hrefFor = (href: string) => (locale === DEFAULT_LOCALE ? href : `/${locale}${href}`);
const isActive = (href: string) => pathname.replace(/\/$/, '') === href.replace(/\/$/, '');

const productsItems = [
  { label: t.footer.oemBatteries, href: '/oem/' },
  { label: t.footer.carBatteries, href: '/oem/car-batteries/' },
  { label: t.footer.truckBatteries, href: '/oem/truck-batteries/' },
  { label: t.footer.privateLabel, href: '/private-label/' },
  { label: t.footer.heavyDutyBatteries, href: '/heavy-duty-batteries/' },
];
const modelsItems = [
  { label: t.nav.models, href: '/data/' },
  { label: t.footer.batteryFinder, href: '/tools/battery-finder/' },
  { label: t.nav.compare, href: '/tools/compare/' },
];
const knowledgeItems = [
  { label: t.footer.whatIsOem, href: '/knowledge/what-is-oem-battery/' },
  { label: t.footer.oemVsOdm, href: '/knowledge/oem-vs-odm-vs-private-label/' },
  { label: t.footer.choosingManufacturer, href: '/knowledge/how-choose-oem-battery-manufacturer/' },
  { label: t.footer.supplierChecklist, href: '/knowledge/oem-battery-supplier-checklist/' },
  { label: t.footer.specGuide, href: '/knowledge/oem-battery-specification-guide/' },
];

const currentLabel = LOCALES.find((l) => l.code === locale)?.label ?? 'English';
---
<header class="site-header">
  <a class="skip-link" href="#main">{t.skipToContent}</a>
  <div class="container site-header__bar">
    <a class="brand" href={hrefFor('/')}>
      <span class="brand__mark">DB</span>
      <span>{BRAND}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={hrefFor('/')} aria-current={isActive('/') ? 'page' : undefined}>{t.nav.home}</a>

      <details class="nav-dropdown">
        <summary>{t.nav.products}</summary>
        <div class="nav-dropdown__menu">
          {productsItems.map((i) => <a href={hrefFor(i.href)}>{i.label}</a>)}
        </div>
      </details>

      <details class="nav-dropdown">
        <summary>{t.nav.models}</summary>
        <div class="nav-dropdown__menu">
          {modelsItems.map((i) => <a href={hrefFor(i.href)}>{i.label}</a>)}
        </div>
      </details>

      <details class="nav-dropdown">
        <summary>{t.nav.knowledge}</summary>
        <div class="nav-dropdown__menu">
          {knowledgeItems.map((i) => <a href={hrefFor(i.href)}>{i.label}</a>)}
        </div>
      </details>

      <a href={hrefFor('/factory/')} aria-current={isActive('/factory/') ? 'page' : undefined}>{t.nav.factory}</a>
      <a class="btn btn--light" href={hrefFor('/contact/')}>{t.requestOemQuote}</a>
      <a class="btn btn--whatsapp" href={CONTACT.whatsappLink} target="_blank" rel="noopener">{t.whatsapp}</a>
    </nav>
    <details class="lang-switch">
      <summary>{currentLabel}</summary>
      <div class="lang-switch__menu">
        {LOCALES.map((l) => (
          <a href={localizedPath(pathname, l.code)} lang={l.code} hreflang={l.code} aria-current={l.code === locale ? 'true' : undefined}>
            {l.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>

<script is:inline>
  const dropdowns = document.querySelectorAll('.nav-dropdown');
  // Accordion: opening one closes the others
  dropdowns.forEach((dd) => {
    dd.addEventListener('toggle', () => {
      if (dd.open) {
        dropdowns.forEach((other) => {
          if (other !== dd) other.removeAttribute('open');
        });
      }
    });
  });
  // Close on outside click
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (dd.open && !dd.contains(e.target)) dd.removeAttribute('open');
    });
  });
  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdowns.forEach((dd) => dd.removeAttribute('open'));
    }
  });
</script>
