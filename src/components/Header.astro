---
import { BRAND, NAV_LINKS, CONTACT } from '../data/site';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => pathname === href.replace(/\/$/, '');
---
<header class="site-header">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="container site-header__bar">
    <a class="brand" href="/">
      <span class="brand__mark">DB</span>
      <span>{BRAND}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {NAV_LINKS.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
      <a class="btn btn--light" href="/contact/">Request OEM Quote</a>
      <a class="btn btn--whatsapp" href={CONTACT.whatsappLink} target="_blank" rel="noopener">WhatsApp</a>
    </nav>
  </div>
</header>
