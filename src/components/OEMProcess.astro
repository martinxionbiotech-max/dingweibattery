---
import { OEM_PROCESS } from '../data/site';
---
<h2>OEM process</h2>
<p class="lead">Seven steps from first consultation to shipment.</p>
<ol class="process">
  {OEM_PROCESS.map((step) => (
    <li>
      <div>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </div>
    </li>
  ))}
</ol>
